config AIKERNEL_BPF
	bool "AIKernel BPF 集成"
	depends on AIKERNEL && BPF && BPF_SYSCALL && PERF_EVENTS
	default n
	help
	  AI + BPF：AIKernel/bpf/。BPF 程序协同（bpf_ai_query/bpf_ai_telemetry
	  helper、BPF_MAP_TYPE_AI_MODEL 模型参数 map）、Tracing/Perf 集成
	  （AI 观察 Hook + AI PMU 事件 ai/inference、ai/decision、
	  ai/telemetry_write）、第14类感知（Prompt 11）。

	  If unsure, say N.

config AIKERNEL_TELEMETRY
	bool "AIKernel 遥测子系统"
	depends on AIKERNEL
	default n
	help
	  构建 AI 遥测采集核心（AIKernel/core/ai_telemetry.c）：
	  per-CPU ring buffer（每 CPU 128KB，单次写入 < 100ns，无锁）、
	  17 大类 101 子类事件枚举、采样开关、全量原始数据（零脱敏）。

	  这是全系统唯一的 AI 感知写入入口，所有子系统埋点共用。
	  关闭时所有 ai_telemetry_* 为 static inline 空函数，零开销。

	  If unsure, say N.

config AIKERNEL_USRIFACE
	bool "AIKernel 用户态接口层（sysfs/procfs + 启动参数）"
	depends on AIKERNEL && AIKERNEL_RUNTIME
	default n
	help
	  构建 AI 用户态接口（Prompt 02）：
	    - AIKernel/core/ai_startup.c：ai.* 启动参数（ai.enabled/model_path/log_level）
	    - AIKernel/core/ai_sysfs.c：/sys/kernel/ai/ 控制面
	      （enabled/model_load/model_unload/policy/<name>/stats/）
	    - AIKernel/core/ai_procfs.c：/proc/ai/ 状态面
	      （status/decisions/latency/hitrate/telemetry 流式出口，raw/human 双模式）
	  ai.enabled=0 启动时全部节点不创建（与原生内核行为一致）。
	  写操作统一 CAP_SYS_ADMIN 校验（LSM capable 路径）。

	  If unsure, say N.

config AIKERNEL_NETLINK
	bool "AIKernel NETLINK_AI 协议族"
	depends on AIKERNEL && AIKERNEL_RUNTIME && NET
	default n
	help
	  构建 NETLINK_AI 协议族（AIKernel/net/ai_netlink.c，编号 31）：
	    - AI_CMD_SENSE：一条消息拉取最近 N 条感知记录（上限 4096，raw/human）
	    - AI_CMD_ACT：下发决策指令并执行对应决策域策略（CAP_SYS_ADMIN）
	    - AI_CMD_REG：注册回调（异步事件推送预留，CAP_SYS_ADMIN）
	  AI Runtime 与内核通信的高速通道（接口契约见
	  include/uapi/linux/ai_netlink.h）。

	  If unsure, say N.

config AIKERNEL_CGROUP
	bool "AIKernel cgroup 控制器（ai）"
	depends on AIKERNEL && AIKERNEL_RUNTIME && CGROUPS
	default n
	help
	  构建 ai.cgroup 控制器（AIKernel/core/ai_cgroup.c）：
	  Prompt 02 骨架（css 分配/上线/释放 + ai.inferences 计数 +
	  ai.max_inferences 上限字段）已填充（Prompt 12）：
	    - ai.max_inferences 强制生效（超限 → AI_ERR_BUSY 拒绝 + limit_hit 遥测）
	    - ai.max_tops（TOPS 上限接口字段，度量接入后强制）
	    - ai.mem_limit_mb（AI 显存上限接口字段）
	    - ai_cgroup_query() 查询限制/用量
	  子系统 id 加入 cgroup_subsys 列表（v2 默认层级启用）。

	  If unsure, say N.

config AIKERNEL_KUNIT_TEST
	bool "AIKernel KUnit 测试套件"
	depends on AIKERNEL && KUNIT
	default n
	help
	  构建 AIKernel KUnit 测试套件（AIKernel/test/）：
	    - ai_runtime_test：生命周期/状态/模型注册/chat 语义
	    - ai_telemetry_test：ring buffer 写读/溢出/采样率/reset
	    - ai_policy_test：注册/执行/回滚/安全边界/outcome
	    - ai_causal_test：因果链完整性/ring 满覆盖
	  随内核 built-in 在启动时执行（KUnit 框架，结果打印内核日志）。
	  CONFIG_AIKERNEL=n 时本开关不可选 → 测试零产物（编译为无操作）。

	  If unsure, say N.

endmenu
