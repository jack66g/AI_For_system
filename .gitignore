*.raw
*.qcow2
*.img
*.vmdk
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.zip
initramfs/
initrd*
rootfs/
w6i-isodir/
w6i-rootfs/

# 运行时/本地产物（密钥绝不入库）
