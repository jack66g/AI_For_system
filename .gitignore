# 构建产物（仓库只含源码；构建目录与中间件不入库）
/agent/ai/build/
*.o
*.o.*
*.a
*.ko
*.ko.*
*.cmd
*.order
*.mod
*.mod.c
*.symvers
*.su
*.i
.tmp_versions/
modules.builtin*
Module.symvers
vmlinux
vmlinux.*
System.map
bzImage
zImage
Image

# 可执行文件/测试编译产物（保留 .c/.h/.py/.sh/.tsv/.json 测试源码）
/agent/ai/aikernel-shell
/agent/ai/aik-sandbox
/agent/ai/ai
/agent/ai/tests/test_*
!/agent/ai/tests/test_*.c
!/agent/ai/tests/test_*.h
!/agent/ai/tests/test_*.py
!/agent/ai/tests/test_*.sh
!/agent/ai/tests/test_*.tsv
!/agent/ai/tests/test_*.json
/agent/ai/tests/w10b_tls_probe
/agent/ai/tests/w10b_tls_probe_asan
/agent/ai/tests/demo_sandbox_chain
/agent/ai/sandbox/tests/aik-sandbox

