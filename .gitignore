model.toml
api-token
*.pem
*.key
id_rsa*
known_hosts
*.log
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# 证据/报告/临时工作区（不属于源码基线）
longterm/
fix-w*/
.tmp/
*.bundle
