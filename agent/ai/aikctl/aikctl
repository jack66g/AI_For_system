import hashlib as _hl
import time as _tm

# 冻结三规则（table_spec.json，表 sha 5810d14a…；--table 可覆盖）
AIP_TABLE_RULES = (
    (4, 1, 409, 1),          # psi_mem_some>409 → RECLAIM_AGGRESSIVE
    (2, 1, 10000000, 2),     # lat_ewma_ns>1e7  → SCHED_COMPENSATE
    (3, 1, 20, 3),           # iowait_pct>20    → READAHEAD_BOOST
)
_AIP_TRUST_BIT = {2: 1, 3: 2, 4: 4}   # LAT/IOWAIT/PSI（aip_model.h）


def _aip_oracle_decide(vec):
    """aip_decide python 镜像（first-hit 单出；信任门缺位=规则跳过）。
    m2_bench oracle 同源合同。"""
    vals = {2: vec.get('lat_ewma_ns') or 0,
            3: vec.get('iowait_pct') or 0,
            4: vec.get('psi_mem_some') or 0}
    for feat, op, lo, act in AIP_TABLE_RULES:
        bit = _AIP_TRUST_BIT.get(feat)
        if not bit or not ((vec.get('valid_bits') or 0) & bit):
            continue
        if op == 1 and vals[feat] > lo:
            return act
    return 0


def _write_card(out_path, rows, args, extra=None):
    """E1' dataset card（§7.1：来源/时间窗/过滤/已知偏差/许可+sha）。"""
    sha = None
    if os.path.isfile(out_path):
        h = _hl.sha256()
        with open(out_path, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
        sha = h.hexdigest()
    card = {
        'schema': 'aikernel.dataset/card/1',
        'out': os.path.basename(out_path),
        'sha256': sha,
        'layer': args.layer,
        'since': args.since,
        'until': args.until,
        'filters': {'layer': args.layer, 'since': args.since,
                    'until': args.until, 'redact': args.redact},
        'rows': len(rows),
        'time_window_ns': None,
        'known_biases': [
            'executed 恒 0 时代（M1 影子）样本无下发结果',
            'redact soft/strict 不可逆改写 data/pid 列',
        ],
        'license': '本地数据：仅本机蒸馏使用，不出机；corpus 层为 '
                   'aik-gcm AES-256-GCM 加密包',
        'created_utc': _tm.strftime('%Y-%m-%dT%H:%M:%SZ', _tm.gmtime()),
        'tool': 'aikctl dataset export',
    }
    ts = [r.get('timestamp_ns') for r in rows
          if r.get('timestamp_ns') is not None]
    if ts:
        card['time_window_ns'] = [min(ts), max(ts)]
    if extra:
        card.update(extra)
    cpath = out_path + '.card.json'
    with open(cpath, 'w', encoding='utf-8') as f:
        json.dump(card, f, ensure_ascii=False, indent=2, sort_keys=True)
    print('DATASET_CARD %s rows=%d sha=%s'
          % (cpath, card['rows'], (sha or '')[:16]))
    return cpath


def cmd_dataset_replay(args):
    """E1' 回放：aipd 影子 parquet 逐行喂冻结阈值表 oracle 对拍
    decision_type——成功率判据 ≥0.95（计划书 §10 E1）。"""
    if not os.path.isfile(args.file):
        print('aikctl: 文件不存在：%s' % args.file, file=sys.stderr)
        return 1
    global AIP_TABLE_RULES
    if args.table:
        with open(args.table, 'r', encoding='utf-8') as f:
            spec = json.load(f)
        fmap = {'AIP_F_LAT_EWMA_NS': 2, 'AIP_F_IOWAIT_PCT': 3,
                'AIP_F_PSI_MEM_SOME': 4, 'AIP_F_CACHE_MISSES': 5}
        amap = {'AIP_ACT_NONE': 0, 'AIP_ACT_RECLAIM_AGGRESSIVE': 1,
                'AIP_ACT_SCHED_COMPENSATE': 2, 'AIP_ACT_READAHEAD_BOOST': 3}
        AIP_TABLE_RULES = tuple(
            (fmap[r['feat']], 1 if r['op'] == 'AIP_OP_GT' else 0,
             r['lo'], amap[r['action']]) for r in spec['rules'])
    cols = _pq_read(args.file, '回放读取')
    for c in ('data_0', 'data_1', 'data_2', 'data_4', 'decision_type'):
        if c not in cols:
            print('aikctl: %s 缺列 %s（回放面=aipd 影子 33 列 parquet）'
                  % (args.file, c), file=sys.stderr)
            return 1
    n = len(cols['decision_type'])
    matched = 0
    for i in range(n):
        vec = {'lat_ewma_ns': cols['data_0'][i],
               'iowait_pct': cols['data_1'][i],
               'psi_mem_some': cols['data_2'][i],
               'valid_bits': cols['data_4'][i]}
        if _aip_oracle_decide(vec) == cols['decision_type'][i]:
            matched += 1
    rate = (matched / n) if n else 0.0
    ok = n > 0 and rate >= 0.95
    print('DATASET_REPLAY file=%s rows=%d matched=%d rate=%.4f %s'
          % (args.file, n, matched, rate, 'PASS' if ok else 'FAIL(<0.95)'))
    return 0 if ok else 1


