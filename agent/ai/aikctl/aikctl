        return conf_kv['STATS_FILE']
    return AIPD_STATS_DEFAULT


def aipd_table_parse(data):
    """AIPTBL 表解析+校验（python 镜像 C 加载器 aip_table.c：magic/ver/
    nrules/逐条 rule_valid/sha256 重算==头 hex；任一失配即拒——fail-fast
    与 conf 同级，防 A/B 静默错配）。
    → (rules, sha_hex, err)：rules=[(feat,op,lo,hi,action,param,reason_str)]
    合法时 err=None；非法时 err=人读原因。"""
    def bad(msg):
        return None, None, msg
    if len(data) < AIPD_TABLE_HDR_SZ:
        return bad('文件过短：%dB < 头 %dB' % (len(data), AIPD_TABLE_HDR_SZ))
    if data[:8] != AIPD_TABLE_MAGIC:
        return bad('magic 失配: %r（期望 %r）'
                   % (data[:8], AIPD_TABLE_MAGIC))
    ver, flags, nrules = struct.unpack_from('<HHI', data, 8)
    if ver != AIPD_TABLE_VER:
        return bad('ver=%d != %d' % (ver, AIPD_TABLE_VER))
    if flags != 0:
        return bad('flags=%d != 0（未定义标志位）' % flags)
    if not 1 <= nrules <= AIPD_TABLE_RULES_MAX:
        return bad('nrules=%d 越界（1..%d）'
                   % (nrules, AIPD_TABLE_RULES_MAX))
    if len(data) != AIPD_TABLE_HDR_SZ + nrules * AIPD_TABLE_RULE_SZ:
        return bad('长度失配：%dB != 头 %dB + %d×%dB（截断/尾随垃圾）'
                   % (len(data), AIPD_TABLE_HDR_SZ, nrules,
                      AIPD_TABLE_RULE_SZ))
    hexfield = data[16:81]
    if hexfield[64] != 0:
        return bad('sha256_hex 域未 NUL 结尾')
    try:
        sha_hex = hexfield[:64].decode('ascii')
    except UnicodeDecodeError:
        return bad('sha256_hex 域非 ASCII')
    if not re.fullmatch(r'[0-9a-f]{64}', sha_hex):
        return bad('sha256_hex 域非 64 位小写 hex: %r' % sha_hex)
    if any(data[81:AIPD_TABLE_HDR_SZ]):
        return bad('头保留域非零填充（off 81..128）')
    rules = []
    for i in range(nrules):
        off = AIPD_TABLE_HDR_SZ + i * AIPD_TABLE_RULE_SZ
        feat, op, lo, hi, action, param = struct.unpack_from(
            '<IIqqII', data, off)
        reason = data[off + 32:off + 32 + AIPD_REASON_MAX].split(
            b'\0', 1)[0].decode('utf-8', 'replace')
        # rule_valid 同款域校验（aip_table.c：feat/op 枚举内、action 上界、
        # IN_RANGE 要求 lo<=hi；reason 定长域不做内容校验=C 同口径）
        if feat >= AIPD_FEAT_MAX:
            return bad('rule[%d] feat=%d 越界（<%d）' % (i, feat,
                                                         AIPD_FEAT_MAX))
        if op not in (0, 1):
            return bad('rule[%d] op=%d 非法（0=IN_RANGE 1=GT）' % (i, op))
        if action > AIPD_ACT_MAX:
            return bad('rule[%d] action=%d 越界（<=%d）'
                       % (i, action, AIPD_ACT_MAX))
        if op == 0 and lo > hi:
            return bad('rule[%d] IN_RANGE lo=%d > hi=%d' % (i, lo, hi))
        rules.append((feat, op, lo, hi, action, param, reason))
    body = data[AIPD_TABLE_HDR_SZ:]
    got = hashlib.sha256(body).hexdigest()
    if got != sha_hex:
        return bad('sha256 失配: 重算=%s != 头=%s' % (got, sha_hex))
    return rules, sha_hex, None


def cmd_aipd_table_verify(args):
    """python 镜像 C 加载器校验（B5 对拍面；C 侧=aipd 加载器行为）。"""
    try:
        with open(args.file, 'rb') as fh:
            data = fh.read()
    except OSError as e:
        print('aikctl: aipd table-verify 读 %s 失败: %s'
              % (args.file, e), file=sys.stderr)
        return 1
    rules, sha_hex, err = aipd_table_parse(data)
    if err:
        print('aikctl: aipd table-verify %s 拒载: %s' % (args.file, err),
              file=sys.stderr)
        print('AIPD_TABLE_VERIFY file=%s ok=0' % args.file)
        return 1
    print('AIPD_TABLE_VERIFY file=%s ok=1 nrules=%d ver=%d sha256=%s'
          % (args.file, len(rules), AIPD_TABLE_VER, sha_hex))
    for i, (feat, op, lo, hi, action, param, reason) in enumerate(rules):
        print('rule[%d] feat=%d(%s) op=%d(%s) lo=%d hi=%d action=%d(%s) '
              'param=%d reason=%s'
              % (i, feat, AIPD_FEAT_NAMES.get(feat, '?'), op,
                 AIPD_OP_NAMES.get(op, '?'), lo, hi, action,
                 AIPD_ACT_NAMES.get(action, '?'), param, reason))
    return 0


def aipd_ledger_path():
    return os.path.join(aipd_root(), 'release.json')


def aipd_ledger_load():
    try:
        with open(aipd_ledger_path(), 'r', errors='replace') as f:
            obj = json.load(f)
        return obj if isinstance(obj, dict) else None
    except (OSError, ValueError):
        return None


def aipd_ledger_save(ledger):
    """台账原子写（tmp + os.replace；0600）——抄 compat promote_save 原子
    写法（基线 aikctl:1310-1320 同款）。"""
    path = aipd_ledger_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = '%s.tmp.%d' % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, (_canon(ledger) + '\n').encode('utf-8'))
    finally:
        os.close(fd)
    os.replace(tmp, path)


def aipd_ledger_history_add(ledger, action, detail):
    ledger.setdefault('history', []).append(
        {'ts': int(time.time()), 'action': action,
         'detail': str(detail)[:400]})


def aipd_conf_edit(conf_path, updates):
    """conf 扁平 KEY=VALUE 原位改键（aipd 契约：重复键=拒——绝不产出
    重复键）；改前原行保留为 '# pre <UTC> <原行>' 注释（审计面）；键不
    在场=末尾追加（前置 '# pre <UTC> (absent)' 注释）。其余行/注释逐字
    保留。tmp+os.replace 原子写，保持原文件 mode（新建 0644）。
    → (exit_code, 消息)：0 成功；1 IO 失败。"""
    pre = '# pre %s' % datetime.now(timezone.utc).isoformat(timespec='seconds')
    try:
        with open(conf_path, encoding='utf-8', errors='surrogateescape') as fh:
            lines = fh.read().splitlines()
        had_mode = True
    except FileNotFoundError:
        lines = ['# aikctl aipd 生成（原 conf 不在场；%s）'
                 % datetime.now(timezone.utc).isoformat(
                     timespec='seconds')]
        had_mode = False
    except OSError as e:
        return 1, 'conf 读 %s 失败: %s' % (conf_path, e)
    todo = dict(updates)
    out = []
    for ln in lines:
        s = ln.strip()
        hit = None
        if s and not s.startswith('#') and '=' in s:
            k = s.split('=', 1)[0].strip()
            if k in todo:
                hit = k
        if hit is not None:
            out.append('%s %s' % (pre, ln))
            out.append('%s=%s' % (hit, todo.pop(hit)))
        else:
            out.append(ln)
    for k in todo:                        # 不在场：追加（pre 注释如实标）
        out.append('%s (absent)' % pre)
        out.append('%s=%s' % (k, todo[k]))
    try:
        mode = 0o644
        if had_mode:
            mode = os.stat(conf_path).st_mode & 0o777
        d = os.path.dirname(conf_path)
        if d:
            os.makedirs(d, exist_ok=True)
        tmp = '%s.tmp.%d' % (conf_path, os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        try:
            os.write(fd, ('\n'.join(out) + '\n').encode(
                'utf-8', 'surrogateescape'))
        finally:
            os.close(fd)
        os.replace(tmp, conf_path)
    except OSError as e:
        return 1, 'conf 原子写 %s 失败: %s' % (conf_path, e)
    return 0, None


def cmd_aipd_release(args):
    """verify→拷 tables/（0600）→写台账→改 conf（--yes W2 硬门；pre 行
    注释保留）。stage=shadow 只上 A/B 观察面（ENABLED=0）；canary 追加
    下发（ENABLED=1）；promote→default=拍板项不自动化（见 status）。"""
    try:
        with open(args.file, 'rb') as fh:
            data = fh.read()
    except OSError as e:
        print('aikctl: aipd release 读 %s 失败: %s' % (args.file, e),
              file=sys.stderr)
        return 1
    rules, sha_hex, err = aipd_table_parse(data)
    if err:
        print('aikctl: aipd release %s 表校验拒载（未发生任何写）: %s'
              % (args.file, err), file=sys.stderr)
        return 1
    name = os.path.basename(args.file)
    if name.endswith('.bin'):
        name = name[:-len('.bin')]
    if not AIPD_TABLE_NAME_RE.match(name):
        print('aikctl: aipd release 非法表名（[A-Za-z0-9][A-Za-z0-9_.-]'
              '{0,63}）：%s' % name, file=sys.stderr)
        return 1
    sha8 = sha_hex[:8]
    dest = os.path.join(aipd_root(), 'tables', '%s-%s.bin' % (name, sha8))
    conf = aipd_conf_path(args)
    enabled = '1' if args.stage == 'canary' else '0'
    if not args.yes:
        print('拒绝：aipd release --stage %s 是 W2 写操作（拷 %s + 写台账 '
              '%s + 改 conf %s 的 CANARY_TABLE/CANARY_ENABLED=%s），必须 '
              '--yes 显式确认。\n'
              '注意：本面不经 executor 的 uid 档位闸，动作等同当前用户'
              '直接执行。\n'
              '下一步：aikctl aipd release %s --stage %s --conf %s --yes'
              % (args.stage, dest, aipd_ledger_path(), conf, enabled,
                 args.file, args.stage, conf), file=sys.stderr)
        return 2
    # ① 拷入 tables/（0600；tmp+os.replace 原子）
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        tmp = '%s.tmp.%d' % (dest, os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, data)
        finally:
            os.close(fd)
        os.replace(tmp, dest)
    except OSError as e:
        print('aikctl: aipd release 拷 %s 失败: %s' % (dest, e),
              file=sys.stderr)
        return 1
    # ② 台账（promote 台账同型）
    ledger = aipd_ledger_load()
    if ledger is None:
        ledger = {'schema': AIPD_RELEASE_SCHEMA, 'name': name,
                  'stage': None, 'table_sha256': None, 'history': []}
    ledger.update({'schema': AIPD_RELEASE_SCHEMA, 'name': name,
                   'stage': args.stage, 'table_sha256': sha_hex,
                   'updated_ts': int(time.time())})
    aipd_ledger_history_add(
        ledger, 'release.%s' % args.stage,
        'table=%s-%s.bin sha256=%s conf=%s CANARY_ENABLED=%s'
        % (name, sha8, sha_hex, conf, enabled))
    try:
        aipd_ledger_save(ledger)
    except OSError as e:
        print('aikctl: aipd release 台账写失败（表已拷、conf 未改——重跑'
              '幂等）: %s' % e, file=sys.stderr)
        return 1
    # ③ conf（pre 行注释保留）
    rc, msg = aipd_conf_edit(
        conf, {'CANARY_TABLE': dest, 'CANARY_ENABLED': enabled})
    if rc:
        print('aikctl: aipd release conf 改写失败（表+台账已落——人工核对 '
              '%s 后重跑幂等）: %s' % (conf, msg), file=sys.stderr)
        return 1
    print('AIPD_RELEASE file=%s name=%s stage=%s sha8=%s dest=%s '
          'ledger=%s conf=%s CANARY_ENABLED=%s'
          % (args.file, name, args.stage, sha8, dest,
             aipd_ledger_path(), conf, enabled))
    print('提示：shadow=A/B 观察面（CANARY_ENABLED=0）；改后 '
          'systemctl restart aikernel-aipd 生效。promote→default=拍板项'
          '（aikctl aipd status 看手册步骤）。')
    return 0


def cmd_aipd_rollback(args):
    """台账 history 回退+conf 复原 builtin（双发确认门：首发布防，60s 内
    重发 --yes 才执行；tables/ 文件留档不删——审计面）。"""
    conf = aipd_conf_path(args)
    arm_path = os.path.join(aipd_root(), 'rollback.arm.json')
    ledger = aipd_ledger_load()
    stage = ledger.get('stage') if ledger else None
    if not args.yes:
        # 第一发：只布防不改（dataset delete 双发确认门同款）
        try:
            os.makedirs(aipd_root(), exist_ok=True)
            with open(arm_path, 'w', encoding='utf-8') as f:
                json.dump({'ts': time.time(), 'conf': conf,
                           'from_stage': stage}, f)
        except OSError as e:
            print('aikctl: aipd rollback 布防写失败（%s）: %s'
                  % (arm_path, e), file=sys.stderr)
            return 1
        print('确认回退范围：root=%s conf=%s' % (aipd_root(), conf))
        print('  台账现行 stage=%s → builtin（history 追加 rollback 行）'
              % (stage if stage else '（无台账）'))
        print('  conf CANARY_TABLE=/CANARY_ENABLED 复原 builtin（pre 行'
              '注释保留；tables/ 文件留档不删）')
        print('确认：60 秒内重发同一命令并加 --yes 执行回退')
        return 1
    # 第二发（--yes）：核对布防
    try:
        with open(arm_path, 'r', encoding='utf-8') as f:
            arm = json.load(f)
    except (OSError, ValueError) as e:
        print('aikctl: 未布防或布防读失败（%s）——先发一次不带 --yes 的'
              '同一命令（双发确认门）: %s' % (arm_path, e), file=sys.stderr)
        return 1
    if arm.get('conf') != conf:
        print('aikctl: 布防参数与本次命令不符（conf 变化即失效）——重新'
              '布防', file=sys.stderr)
        return 1
    if time.time() - float(arm.get('ts', 0)) > 60.0:
        try:
            os.unlink(arm_path)
        except OSError:
            pass
        print('aikctl: 布防已过期（超过 60 秒）——重发第一发布防再确认',
              file=sys.stderr)
        return 1
    try:
        os.unlink(arm_path)
    except OSError:
        pass
    # ① conf 复原 builtin
    rc, msg = aipd_conf_edit(
        conf, {'CANARY_TABLE': '', 'CANARY_ENABLED': '0'})
    if rc:
        print('aikctl: aipd rollback conf 复原失败: %s' % msg,
              file=sys.stderr)
        return 1
    # ② 台账 history 回退（builtin 行入账；文件留档）
    ledger = ledger if ledger else {'schema': AIPD_RELEASE_SCHEMA,
                                    'name': None, 'stage': None,
                                    'table_sha256': None, 'history': []}
    ledger.update({'stage': 'builtin', 'table_sha256': None,
                   'updated_ts': int(time.time())})
    aipd_ledger_history_add(
        ledger, 'rollback',
        'restored builtin（from_stage=%s conf=%s；tables/ 留档）'
        % (arm.get('from_stage'), conf))
    try:
        aipd_ledger_save(ledger)
    except OSError as e:
        print('aikctl: aipd rollback 台账写失败（conf 已复原——重跑幂等）:'
              ' %s' % e, file=sys.stderr)
        return 1
    print('AIPD_ROLLBACK root=%s conf=%s stage=builtin（from=%s）'
          'ledger=%s tables=留档'
          % (aipd_root(), conf, arm.get('from_stage'),
             aipd_ledger_path()))
    print('提示：改后 systemctl restart aikernel-aipd 生效（回 builtin '
          '静态表）。')
    return 0


def _to_int(v):
    try:
        return int(str(v))
    except (TypeError, ValueError):
        return None


def cmd_aipd_status(args):
    """stats+conf canary 键+A/B 摘要+台账+三旋钮 current（只读诚实面；
    缺件逐项如实标注；promote→default=拍板项手册步骤提示）。"""
    conf = aipd_conf_path(args)
    conf_kv = aipd_read_kv(conf)
    stats = aipd_stats_path(conf_kv)
    print('AIPD_STATUS root=%s conf=%s stats=%s'
          % (aipd_root(), conf, stats))
    if conf_kv is None:
        print('conf: <不可读/不在场 %s>' % conf)
    else:
        keys = ('FEAT_SOURCE', 'SHADOW', 'MODEL_TABLE') + \
            AIPD_CONF_CANARY_KEYS
        print('conf: ' + ' '.join(
            '%s=%s' % (k, conf_kv.get(k, '<缺省>'))
            for k in keys if k in conf_kv or k in AIPD_CONF_CANARY_KEYS))
    st = aipd_read_kv(stats)
    if st is None:
        print('stats: <不可读/不在场 %s——aipd 未跑？>' % stats)
    else:
        pick = ('pid', 'feat_source', 'uptime_ms', 'polls', 'decisions',
                'decision_hits', 'decisions_stale', 'mismatch_pct',
                'shadow_rows', 'shadow_files', 'shadow_errors',
                'table_sha_ok', 'table_ver', 'table_rules')
        print('stats: ' + ' '.join(
            '%s=%s' % (k, st[k]) for k in pick if k in st))
        can = {k: st[k] for k in AIPD_STATS_CANARY_KEYS if k in st}
        if can:
            print('canary: ' + ' '.join('%s=%s' % kv for kv in
                                        can.items()))
            if 'canary_ab_total' in can:
                tot = _to_int(can.get('canary_ab_total'))
                mis = _to_int(can.get('canary_ab_mismatch'))
                pct = ('%.2f' % (100.0 * mis / tot)) if (tot and mis is
                                                         not None) else '?'
                print('A/B: ab_total=%s ab_mismatch=%s mismatch=%s%% '
                      'table=%s' % (tot, mis, pct,
                                    can.get('canary_table', '?')))
        else:
            print('canary: <无 canary 统计键——M1 aipd 或 CANARY_TABLE 空>')
            print('A/B: <无 canary 统计面>')
    ledger = aipd_ledger_load()
    if ledger:
        sha = ledger.get('table_sha256')
        print('ledger: schema=%s stage=%s name=%s sha8=%s history=%d'
              % (ledger.get('schema'), ledger.get('stage'),
                 ledger.get('name'), (sha[:8] if sha else '-'),
                 len(ledger.get('history', []))))
    else:
        print('ledger: <无台账 %s——未 release 过>' % aipd_ledger_path())
    try:
        with open(AIPD_PROC_CONTROL) as fh:
            for ln in fh:
                name = ln.split()[0] if ln.split() else ''
                if name in AIPD_KNOBS:
                    m = re.search(r'current=(-?\d+)', ln)
                    print('knob: %s %s' % (name, m.group(0) if m
                                           else ln.strip()))
    except OSError as e:
        print('knob: <不可读 %s: %s——非 AI 内核宿主？>' % (AIPD_PROC_CONTROL,
                                                       e))
    print('promote→default=拍板项（不自动化）：手册步骤=①金丝雀观察窗'
          '（stats canary_confirmed/rolled_back 健康）②确认表内容 '
          'aikctl aipd table-verify <tables/现役 .bin> ③人工拍板后 '
          'systemctl enable --now aikernel-aipd（常驻；出厂 unit 注释 '
          '17-20 行呼应）④台账记拍板人/时间。')
    return 0 if st is not None else 1


# ------------------------------------------------- user（P-2 Phase A）----
# 多用户身份供给：console-gate 行 ↔ OS 号四件同落。gate 文件契约与
# occ 读取端（A 棒波次）一致：每行 name:hash:ts[:fails]，# 注释/空行
# 忽略；原子写 tmp+rename（0600，同 tui_gate_write 手法）。AIK_CONSOLE_
# GATE 环境变量可指向测试桩（occ tui_gate_path 同款门）。

GATE_PATH_DEFAULT = '/etc/aikernel/console-gate'
USER_NAME_RE = re.compile(r'^[a-z_][a-z0-9_-]{0,31}$')
USER_PW_MIN = 6            # 与首启向导同规（tui_gate「密码至少 6 位」）
USER_PW_MAX = 64           # 与 gate GATE_PW_MAX 同限


def _gate_path():
    env = os.environ.get('AIK_CONSOLE_GATE')
    return env if env else GATE_PATH_DEFAULT


def gate_read(path):
    """解析 gate → (rows, raw)；坏行 → (None, 原因)（防半解析误写回）。

    rows=[{name,hash,ts,fails,lineno}]；raw=原文件行列表（注释/空行/他号
    行原样保留，写回用）。文件不存在=空 gate（[] , []）。
    """
    try:
        with open(path, 'r', encoding='utf-8') as f:
            raw = f.read().splitlines()
    except FileNotFoundError:
        return [], []
    except OSError as e:
        return None, 'gate 读失败 %s: %s' % (path, e)
    rows = []
    for i, ln in enumerate(raw, 1):
        s = ln.strip()
        if not s or s.startswith('#'):
            continue
        parts = ln.split(':')
        if len(parts) not in (3, 4):
            return None, 'gate 第 %d 行字段数≠3/4：%s' % (i, s)
        name, hs, ts = parts[0], parts[1], parts[2]
        fails = parts[3] if len(parts) == 4 else None
        if not USER_NAME_RE.match(name):
            return None, 'gate 第 %d 行用户名不合法：%s' % (i, name)
        if not hs.startswith('$6$') or len(hs) >= 128:
            return None, ('gate 第 %d 行哈希非 $6$ 前缀或超长（≥128）'
                          % i)
        if not ts.isdigit():
            return None, 'gate 第 %d 行时间戳非数字：%s' % (i, ts)
        if fails is not None and not fails.isdigit():
            return None, 'gate 第 %d 行失败计数非数字：%s' % (i, fails)
        rows.append({'name': name, 'hash': hs, 'ts': int(ts),
                     'fails': int(fails) if fails is not None else None,
                     'lineno': i})
    return rows, raw


def gate_row_find(rows, name):
    for r in rows:
        if r['name'] == name:
            return r
    return None


def gate_write(path, raw_lines):
    """全量原子写（tmp+rename，0600）；失败 → 人话原因。"""
    tmp = '%s.tmp' % path
    try:
        with open(tmp, 'w', encoding='utf-8') as f:
            if raw_lines:
                f.write('\n'.join(raw_lines) + '\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return 'gate 原子写失败 %s: %s' % (path, e)
    return None


def _pw_hash(pw):
    """sha512crypt（$6$）哈希。crypt 模块优先（guest py3.10）；缺席回落
    openssl passwd -6（py3.13 移除 crypt 的兜底）。都缺 → None。"""
    try:
        import crypt
        return crypt.crypt(pw, crypt.mksalt(crypt.METHOD_SHA512))
    except ImportError:
        pass
    try:
        cp = subprocess.run(['openssl', 'passwd', '-6', '-stdin'],
                            input=(pw + '\n').encode(),
                            capture_output=True, timeout=15)
        if cp.returncode == 0:
            h = cp.stdout.decode().strip()
            if h.startswith('$6$'):
                return h
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def _pw_acquire(args):
    """密码来源：--password-stdin（单行）或交互两次一致；≥6 位与向导
    同规。→ (pw, None) | (None, 拒绝原因)。"""
    if args.password_stdin:
        pw = sys.stdin.readline()
        if pw.endswith('\n'):
            pw = pw[:-1]
        if pw.endswith('\r'):
            pw = pw[:-1]
    else:
        if not sys.stdin.isatty():
            return None, ('无 TTY 且未给 --password-stdin——非交互场景'
                          '请用该参数喂单行密码')
        p1 = getpass.getpass('新密码: ')
        p2 = getpass.getpass('新密码（再输一次）: ')
        if p1 != p2:
            return None, '两次输入不一致'
        pw = p1
    if len(pw) < USER_PW_MIN:
        return None, '密码至少 %d 位（与首启向导同规）' % USER_PW_MIN
    if len(pw) > USER_PW_MAX:
        return None, '密码超长（>%d，与 gate 输入限同款）' % USER_PW_MAX
    return pw, None


def _user_name_check(name):
    if not USER_NAME_RE.match(name or ''):
        return ('用户名不合法（^[a-z_][a-z0-9_-]{0,31}$）：%r' % (name,))
    if name == 'root':
        return '拒绝：root 不入 gate（多用户供给面只管普通号；root 路径常在）'
    return None


def _need_root(sub):
    if os.geteuid() != 0:
        print('拒绝：aikctl user %s 需要 root（建/删 OS 号+改 console-gate）。'
              '只读面用 aikctl user list。' % sub, file=sys.stderr)
        return False
    return True


def _os_user_exists(name):
    try:
        pwd.getpwnam(name)
        return True
    except KeyError:
        return False


def _run_cmd(argv):
    """→ (rc, stderr摘)；不抛异常。"""
    try:
        cp = subprocess.run(argv, capture_output=True, text=True,
                            timeout=60)
        return cp.returncode, (cp.stderr or '').strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 127, str(e)


def _home_skeleton(name):
    """家域骨架：~/.aikernel ~/.occ（属主=该号，0700）；不动 model.toml
    （用户域——occ 首跑自建或用户自带）。→ (made 列表, None|原因)。"""
    try:
        pe = pwd.getpwnam(name)
    except KeyError:
        return [], '号 %s 刚建即不可见（passwd 库异常）' % name
    made = []
    for d in ('.aikernel', '.occ'):
        p = os.path.join(pe.pw_dir, d)
        try:
            os.makedirs(p, mode=0o700, exist_ok=True)
            os.chown(p, pe.pw_uid, pe.pw_gid)
            os.chmod(p, 0o700)
            made.append(p)
        except OSError as e:
            return made, '家域骨架建失败 %s: %s' % (p, e)
    return made, None


def cmd_user_list(_args):
    """console-gate 行+OS 号对照表（只读，无 root 门槛——文件本身 0600
    属 root，非 root 会得到人话读失败而非命令拒绝）。"""
    gpath = _gate_path()
    rows, gerr = gate_read(gpath)
    if rows is None:
        print(gerr, file=sys.stderr)
        return 1
    if not rows:
        print('gate 空（%s 无有效行——首启 SETUP 前）' % gpath)
        return 0
    print('gate=%s' % gpath)
    print('%-16s %-7s %-10s %-4s %-19s %s'
          % ('用户', 'uid', '组', '失败', '时间戳(本地)', '哈希(前12)'))
    for r in rows:
        try:
            pe = pwd.getpwnam(r['name'])
            uid = '%d' % pe.pw_uid
            try:
                gname = grp.getgrgid(pe.pw_gid).gr_name
            except KeyError:
                gname = str(pe.pw_gid)
        except KeyError:
            uid = gname = '-'
        ts = datetime.fromtimestamp(r['ts']).strftime('%Y-%m-%d %H:%M:%S')
        print('%-16s %-7s %-10s %-4s %-19s %s'
              % (r['name'], uid, gname,
                 '-' if r['fails'] is None else str(r['fails']),
                 ts, r['hash'][:12] + '…'))
    return 0


def cmd_user_add(args):
    """四件同落（全成或全滚）：①useradd(-m -s /bin/sh[+--wheel 并 sudo])
    ②gate 行 ③家域骨架 ④passwd 同步（usermod -p 同一 $6$ 哈希——OS 侧
    与 gate 凭据严格同源）。--from-gate：复用既有 gate 行哈希幂等建号
    （aik-console v9 admin 出厂归位路径；号已在=跳过 rc 0）。"""
    nerr = _user_name_check(args.name)
    if nerr:
        print(nerr, file=sys.stderr)
        return 1
    if not _need_root('add'):
        return 1
    gpath = _gate_path()
    rows, payload = gate_read(gpath)
    if rows is None:
        print(payload, file=sys.stderr)
        return 1
    row = gate_row_find(rows, args.name)
    if args.from_gate:
        if row is None:
            print('拒绝：--from-gate 需要 gate 行已在（%s 无 %s 行）——'
                  '手工建号请给 --password-stdin 或交互输密'
                  % (gpath, args.name), file=sys.stderr)
            return 1
        if _os_user_exists(args.name):
            print('号 %s 已存在，gate 行已在——幂等跳过（from-gate 归位）'
                  % args.name)
            return 0
        hs = row['hash']
    else:
        if row is not None:
            print('拒绝：%s 的 gate 行已在（%s）——改密用 aikctl user '
                  'passwd，清户用 aikctl user del' % (args.name, gpath),
                  file=sys.stderr)
            return 1
        if _os_user_exists(args.name):
            print('拒绝：OS 号 %s 已存在但无 gate 行——状态漂移，先核对'
                  '（getent passwd %s / aikctl user list）再人工处置'
                  % (args.name, args.name), file=sys.stderr)
            return 1
        pw, perr = _pw_acquire(args)
        if perr:
            print(perr, file=sys.stderr)
            return 1
        hs = _pw_hash(pw)
        if not hs:
            print('哈希生成失败（crypt 模块与 openssl passwd -6 都不可用）',
                  file=sys.stderr)
            return 1

    gate_written = [False]

    def _rollback():
        # 逆序回滚已落步骤：gate 行（仅本命令写入的才删——from-gate 路径
        # 行是既有的，保留）→ userdel -r（连带家目录与骨架）。失败只警告。
        if gate_written[0]:
            rows2, raw2 = gate_read(gpath)
            if rows2 is not None:
                r2 = gate_row_find(rows2, args.name)
                if r2 is not None:
                    gate_write(gpath, [ln for i, ln in enumerate(raw2, 1)
                                       if i != r2['lineno']])
        rc, err = _run_cmd(['userdel', '-r', args.name])
        if rc != 0:
            print('警告：回滚 userdel -r %s 失败：%s（请人工清理）'
                  % (args.name, err or 'rc=%d' % rc), file=sys.stderr)
        else:
            print('已回滚：OS 号（连带家目录/骨架）%s'
                  % ('+本命令写入的 gate 行' if gate_written[0] else
                     '（gate 行未写/既有行保留）'), file=sys.stderr)

    # ① OS 号（+--wheel 并 sudo 组）
    rc, err = _run_cmd(['useradd', '-m', '-s', '/bin/sh', args.name])
    if rc != 0:
        print('useradd 失败：%s' % (err or 'rc=%d' % rc), file=sys.stderr)
        return 1
    if args.wheel:
        rc, err = _run_cmd(['usermod', '-aG', 'sudo', args.name])
        if rc != 0:
            _rollback()
            print('失败：--wheel 并入 sudo 组未成（sudo 组在吗？）：%s'
                  % (err or 'rc=%d' % rc), file=sys.stderr)
            return 1
    # ② gate 行（from-gate 幂等路径行已在=跳过）
    if not args.from_gate:
        werr = gate_write(gpath, payload
                          + ['%s:%s:%d' % (args.name, hs, int(time.time()))])
        if werr:
            _rollback()
            print(werr, file=sys.stderr)
            return 1
        gate_written[0] = True
    # ③ 家域骨架
    made, serr = _home_skeleton(args.name)
    if serr:
        _rollback()
        print('失败：%s' % serr, file=sys.stderr)
        return 1
    # ④ passwd 同步（usermod -p 直填同一 $6$ 哈希——与 gate 凭据同源）
    rc, err = _run_cmd(['usermod', '-p', hs, args.name])
    if rc != 0:
        _rollback()
        print('失败：passwd 同步未成（usermod -p）：%s'
              % (err or 'rc=%d' % rc), file=sys.stderr)
        return 1
    src = 'from-gate' if args.from_gate else '--password-stdin/交互'
    print('user add %s：四件同落 OK（%s）' % (args.name, src))
    print('  ① OS 号 uid=%s%s' % (pwd.getpwnam(args.name).pw_uid,
                                  '（sudo 组）' if args.wheel else ''))
    print('  ② gate 行 %s（$6$ 哈希）%s' % (gpath,
                                           '（复用既有行）' if args.from_gate
                                           else ''))
    print('  ③ 家域骨架 %s' % ' '.join(made))
    print('  ④ passwd 同步（usermod -p 同哈希）')
    if args.from_gate:
        print('提示：aik-console v9 下次解析目标即降权 exec（重新登录生效）')
    return 0


def cmd_user_del(args):
    """OS 号+gate 行删；--purge-home 才连家目录（userdel -r；缺省保留）。"""
    nerr = _user_name_check(args.name)
    if nerr:
        print(nerr, file=sys.stderr)
        return 1
    if not _need_root('del'):
        return 1
    gpath = _gate_path()
    rows, payload = gate_read(gpath)
    if rows is None:
        print(payload, file=sys.stderr)
        return 1
    row = gate_row_find(rows, args.name)
    if row is None and not _os_user_exists(args.name):
        print('无此用户：%s 在 gate（%s）与 OS 号里都不存在' % (args.name,
                                                             gpath),
              file=sys.stderr)
        return 1
    # 先动外部风险面（userdel 失败=啥都没变），gate 行后删（纯文件面）
    os_del = False
    if _os_user_exists(args.name):
        argv = ['userdel'] + (['-r'] if args.purge_home else []) + [args.name]
        rc, err = _run_cmd(argv)
        if rc != 0:
            print('userdel 失败（号在登录中？）：%s' % (err or 'rc=%d' % rc),
                  file=sys.stderr)
            return 1
        os_del = True
    if row is not None:
        raw2 = [ln for i, ln in enumerate(payload, 1) if i != row['lineno']]
        werr = gate_write(gpath, raw2)
        if werr:
            print('OS 号已删但 %s——请人工删 %s 的行' % (werr, args.name),
                  file=sys.stderr)
            return 1
    print('user del %s：%s；gate 行%s' % (
        args.name,
        'OS 号已删（家目录%s）' % ('连删（--purge-home）' if args.purge_home
                               else '保留') if os_del else 'OS 号本就不在',
        '已删' if row is not None else '本就无'))
    return 0


def cmd_user_passwd(args):
    """gate 哈希+passwd 同步改（同一 $6$ 哈希双落；改密即清失败计数）。"""
    nerr = _user_name_check(args.name)
    if nerr:
        print(nerr, file=sys.stderr)
        return 1
    if not _need_root('passwd'):
        return 1
    gpath = _gate_path()
    rows, payload = gate_read(gpath)
    if rows is None:
        print(payload, file=sys.stderr)
        return 1
    row = gate_row_find(rows, args.name)
    if row is None:
        print('拒绝：%s 无 gate 行（%s）——先 aikctl user add' % (args.name,
                                                               gpath),
              file=sys.stderr)
        return 1
    if not _os_user_exists(args.name):
        print('拒绝：OS 号 %s 不存在——passwd 同步无处落。归位路径：'
              'aikctl user add %s --from-gate' % (args.name, args.name),
              file=sys.stderr)
        return 1
    pw, perr = _pw_acquire(args)
    if perr:
        print(perr, file=sys.stderr)
        return 1
    hs = _pw_hash(pw)
    if not hs:
        print('哈希生成失败（crypt 模块与 openssl passwd -6 都不可用）',
              file=sys.stderr)
        return 1
    new_line = '%s:%s:%d' % (args.name, hs, int(time.time()))   # fails 清零
    raw2 = [new_line if i == row['lineno'] else ln
            for i, ln in enumerate(payload, 1)]
    werr = gate_write(gpath, raw2)
    if werr:
        print(werr, file=sys.stderr)
        return 1
    rc, err = _run_cmd(['usermod', '-p', hs, args.name])
    if rc != 0:
        back = gate_write(gpath, payload)     # 尽力回滚 gate 行
        print('失败：passwd 同步未成（usermod -p）：%s%s'
              % (err or 'rc=%d' % rc,
                 '' if back is None else '；且 gate 行回滚失败：%s' % back),
              file=sys.stderr)
        return 1
    print('user passwd %s：gate 哈希已换+passwd 已同步（失败计数清零）'
          % args.name)
    return 0


def _to_int(v):
    try:
        return int(str(v))
    except (TypeError, ValueError):
        return None


