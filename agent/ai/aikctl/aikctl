    d_ex = dsub.add_parser('export', help='curated 拼包导出（内建脱敏'
                           '缺省 soft）/corpus 加密包（aik-gcm）')
    d_ex.add_argument('--layer', choices=['curated', 'corpus'],
                      required=True)
    d_ex.add_argument('--since', required=True, metavar='YYYY-MM-DD',
                      help='起始日（含）')
    d_ex.add_argument('--until', required=True, metavar='YYYY-MM-DD',
                      help='截止日（含）')
    d_ex.add_argument('--out', required=True,
                      help='输出路径（corpus 层追加 .aikcorp 后缀）')
    d_ex.add_argument('--format', choices=['parquet', 'jsonl'],
                      default='jsonl', help='curated 层格式（缺省 jsonl）')
    d_ex.add_argument('--redact', choices=['soft', 'strict', 'off'],
                      default='soft', help='脱敏档（缺省 soft；off 须'
                      '显式且打印风险行）')
    d_ex.add_argument('--root', default=DEFAULT_DATA_ROOT)
    d_ex.add_argument('--key', help='corpus 密钥（缺省 env '
                      'AIK_CORPUS_KEY 或 %s）' % DEFAULT_CORPUS_KEY)
    d_ex.set_defaults(func=cmd_dataset_export)

    d_rp = dsub.add_parser('replay', help="E1' 回放：aipd 影子 parquet"
                           ' 逐行对拍冻结阈值表（判据 rate≥0.95）')
    d_rp.add_argument('file', help='aipd 影子 parquet（33 列）')
    d_rp.add_argument('--table', help='table_spec.json 覆盖（缺省内置'
                      '冻结三规则）')
    d_rp.set_defaults(func=cmd_dataset_replay)

    d_de = dsub.add_parser('delete', help='双发确认门删除（首发布防，'
                           '10s 内重发 --yes 才真删；raw 层拒绝）')
    d_de.add_argument('--layer', choices=['raw', 'curated'], required=True)
    d_de.add_argument('--since', required=True, metavar='YYYY-MM-DD')
    d_de.add_argument('--until', required=True, metavar='YYYY-MM-DD')
    d_de.add_argument('--yes', action='store_true',
                      help='第二发确认（须先布防且 10s 内）')
    d_de.add_argument('--root', default=DEFAULT_DATA_ROOT)
    d_de.add_argument('--sme-url', default=os.environ.get(
        'SME_URL', 'http://127.0.0.1:8000'), help='SME 基址')
    d_de.set_defaults(func=cmd_dataset_delete)

    # AIPD-M2（AIPD-M2-DESIGN §5）：金丝雀发布管线子族
    p_ap = sub.add_parser('aipd', help='AIPD-M2 金丝雀/A-B/签名表发布'
                          '管线（status/table-verify/release/rollback）')
    apsub = p_ap.add_subparsers(dest='aipd_cmd', required=True)

    p_as = apsub.add_parser('status', help='stats+conf canary 键+A/B 摘要'
                            '+release 台账+三旋钮 current（只读诚实面）')
    p_as.add_argument('--conf', default=None, metavar='F',
                      help='aipd.conf 路径（缺省 $AIKERNEL_AIPD_CONF 或 '
                      '%s）' % AIPD_CONF_DEFAULT)
    p_as.set_defaults(func=cmd_aipd_status)

    p_atv = apsub.add_parser('table-verify', help='AIPTBL 表校验（python '
                             '镜像 C 加载器 aip_table.c；失配 exit 1）')
    p_atv.add_argument('file', metavar='FILE', help='表文件（.bin）')
    p_atv.set_defaults(func=cmd_aipd_table_verify)

    p_arl = apsub.add_parser('release', help='verify→拷 tables/（0600）→'
                             '写台账→改 conf（W2：--yes 硬门）')
    p_arl.add_argument('file', metavar='FILE', help='表文件（.bin）')
    p_arl.add_argument('--stage', required=True,
                       choices=['shadow', 'canary'],
                       help='shadow=A/B 观察（ENABLED=0）；canary=追加下发'
                       '（ENABLED=1）；default=拍板项不自动化')
    p_arl.add_argument('--yes', action='store_true',
                       help='W2 硬门（缺省拒绝并给下一步）')
    p_arl.add_argument('--conf', default=None, metavar='F',
                       help='aipd.conf 路径（缺省 $AIKERNEL_AIPD_CONF 或 '
                       '%s）' % AIPD_CONF_DEFAULT)
    p_arl.set_defaults(func=cmd_aipd_release)

    p_arb = apsub.add_parser('rollback', help='台账 history 回退+conf 复原 '
                             'builtin（双发确认门+--yes）')
    p_arb.add_argument('--yes', action='store_true',
                       help='第二发确认（须先布防且 60s 内）')
    p_arb.add_argument('--conf', default=None, metavar='F',
                       help='aipd.conf 路径（缺省 $AIKERNEL_AIPD_CONF 或 '
                       '%s）' % AIPD_CONF_DEFAULT)
    p_arb.set_defaults(func=cmd_aipd_rollback)

    # P-2 多用户 Phase A：身份供给子族（console-gate ↔ OS 号四件同落）
    p_usr = sub.add_parser('user', help='P-2 多用户身份供给'
                           '（list/add/del/passwd）')
    usub = p_usr.add_subparsers(dest='user_cmd', required=True)

    u_ls = usub.add_parser('list', help='gate 行+OS 号对照表（只读，无 '
                           'root 门槛）')
    u_ls.set_defaults(func=cmd_user_list)

    u_ad = usub.add_parser('add', help='四件同落：OS 号+gate 行+家域骨架'
                           '+passwd 同步（全成或全滚；root）')
    u_ad.add_argument('name', metavar='NAME', help='用户名')
    u_ad.add_argument('--wheel', action='store_true',
                      help='并入 sudo 组（admin 归位/运维号）')
    u_ad.add_argument('--password-stdin', action='store_true',
                      dest='password_stdin',
                      help='密码从 stdin 单行读（非交互；缺省交互两次）')
    u_ad.add_argument('--from-gate', action='store_true', dest='from_gate',
                      help='不收密码：复用既有 gate 行哈希建 OS 号'
                      '（admin 出厂归位路径；幂等——号已在=跳过）')
    u_ad.set_defaults(func=cmd_user_add)

    u_de = usub.add_parser('del', help='OS 号+gate 行删（默认保留家'
                           '目录；root）')
    u_de.add_argument('name', metavar='NAME', help='用户名')
    u_de.add_argument('--purge-home', action='store_true',
                      dest='purge_home',
                      help='连家目录一起删（userdel -r；缺省保留）')
    u_de.set_defaults(func=cmd_user_del)

    u_pw = usub.add_parser('passwd', help='gate 哈希+passwd 同步改'
                           '（root）')
    u_pw.add_argument('name', metavar='NAME', help='用户名')
    u_pw.add_argument('--password-stdin', action='store_true',
                      dest='password_stdin',
                      help='新密码从 stdin 单行读（缺省交互两次）')
    u_pw.set_defaults(func=cmd_user_passwd)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == '__main__':
    sys.exit(main())
