KIND_DECISION_OUTCOME = 2
KIND_ROLLBACK = 3
KIND_AGENT_REJECT = 4
KIND_MODEL_EVENT = 5
KIND_KEY_EVENT = 6
KIND_SECCOMP_ANOMALY = 7
KIND_AUDIT_ANOMALY = 8
KIND_ANCHOR = 9
