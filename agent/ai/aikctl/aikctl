def _find_gcm_bin():
    """aik-gcm 解析：env AIK_GCM > PATH > 工树构建产物（aikctl 同仓
    agent/ai/aik-gcm）。找不到=人话指路 make aik-gcm。"""
    env = os.environ.get('AIK_GCM')
    if env:
        return env
    w = shutil.which('aik-gcm')
    if w:
        return w
    cand = os.path.join(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), 'aik-gcm')
    if os.path.isfile(cand) and os.access(cand, os.X_OK):
        return cand
    return None


def cmd_dataset_list(args):
    pq = None  # P-27：读侧双后端（_pq_read 内解析）
    base = _layer_dir(args.root, args.layer)
    ipath = os.path.join(base, 'index.parquet')
    if not os.path.isfile(ipath):
        print('aikctl: %s 层无 index.parquet（%s 暂无数据或未初始化；'
              'raw 由 aistreamd 产生，curated 由棒① promotion 双写产生）'
              % (args.layer, base))
        return 0
    idx = _pq_read(ipath, 'index 读取')
    n = len(idx.get('file', []))
    if n == 0:
        print('aikctl: %s 层 index.parquet 为空（0 文件）' % args.layer)
        return 0
    total_rows = 0
    total_bytes = 0
    dates = []
    for i in range(n):
        f, d = idx['file'][i], idx['date'][i]
        total_rows += int(idx['records'][i])
        dates.append(d)
        # index 的 file 列两种口径：文件名（fixture）或 aistreamd 实产
        # 的 "<日>/<文件>" 相对路径——后者 join(base, d, f) 会双拼日期
        # （棒④ 台架 C13 次级发现）。归一：f 已含日期前缀则不再拼 d。
        if str(f).startswith(str(d) + '/'):
            p = os.path.join(base, str(f))
        else:
            p = os.path.join(base, str(d), str(f))
        if os.path.isfile(p):
            total_bytes += os.path.getsize(p)
        else:
            print('aikctl: 注意：索引行 file=%s date=%s 在磁盘上不存在'
                  '（索引陈旧？）' % (f, d), file=sys.stderr)
    print('layer=%s root=%s' % (args.layer, args.root))
    print('files=%d rows=%d bytes=%d (%.2f MiB)'
          % (n, total_rows, total_bytes, total_bytes / 1048576.0))
    print('dates=%s..%s' % (min(dates), max(dates)))
    print('DATASET_LIST layer=%s files=%d rows=%d dates=%s..%s bytes=%d'
          % (args.layer, n, total_rows, min(dates), max(dates),
             total_bytes))
    return 0



