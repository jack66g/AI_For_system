        try:
            prev_head = json.loads(last).get('head_hash')
        except ValueError:
            pass
    print('ANCHOR head=%s nodes=%s -> %s（prev head=%s）'
          % (head_hash, nodes_count, args.anchors, prev_head))
    return 0


