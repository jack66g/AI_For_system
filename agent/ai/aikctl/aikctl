COMPAT_PROBE_TIMEOUT = 10           # 单目标 probe 超时秒数（§3.1）
AIK_COMPAT_LINE_RE = re.compile(r'^AIK_COMPAT rc=(-?\d+) runnable=([01])\s*$')


def compat_resolve_probe(explicit=None):
    """→ (probe 路径, None) 或 (None, 人话报错)。能力真实：找不到即报错
    +下一步，不静默降级（§3.1）。"""
    if explicit:
        if os.path.isfile(explicit) and os.access(explicit, os.X_OK):
            return explicit, None
        return None, (
            'compat scan: --probe 指定的 %r 不存在或无执行位。\n'
            '下一步：确认 aik-compat 的路径，或改用 PATH 上已安装的'
            ' aik-compat。' % explicit)
    found = shutil.which(COMPAT_PROBE_NAME)
    if found:
        return found, None
    return None, (
        'compat scan: PATH 上找不到 probe 二进制 %r。\n'
        '下一步：安装 aik-compat（agent/ai 下 make aik-compat 并安装到'
        ' /usr/local/bin），或用 --probe 显式指定其路径。'
        % COMPAT_PROBE_NAME)


def compat_parse_probe(stdout):
    """probe stdout（合同 §2.2）→ probe JSON dict；违约抛 RuntimeError。"""
    text = stdout.decode('utf-8', errors='replace') if isinstance(
        stdout, bytes) else stdout
    i = text.find('{')
    if i < 0:
        raise RuntimeError('stdout 无 JSON 行')
    try:
        obj, _used = json.JSONDecoder().raw_decode(text, i)
    except ValueError as e:
        raise RuntimeError('probe JSON 解析失败: %s' % e)
    if not isinstance(obj, dict):
        raise RuntimeError('probe JSON 不是 object')
    line = None
    for ln in reversed(text.splitlines()):
        if ln.strip().startswith('AIK_COMPAT'):
            line = ln.strip()
            break
    m = AIK_COMPAT_LINE_RE.match(line or '')
    if not m:
        raise RuntimeError('缺/坏 AIK_COMPAT 末行: %r' % (line,))
    rc, runnable = int(m.group(1)), int(m.group(2))
    if rc == -1:
        raise RuntimeError('probe rc=-1（参数非法；目标须绝对路径）')
    if bool(obj.get('runnable')) != bool(runnable):
        raise RuntimeError('AIK_COMPAT runnable=%d 与 JSON runnable=%r 不符'
                           % (runnable, obj.get('runnable')))
    return obj


def compat_manifest_row(target, pj):
    """probe JSON → manifest 行（§3.2 逐字段；codes 只留归因四元组，
    detail/evidence 不入表；elf 归一含 versions 四字段）。"""
    elf = pj.get('elf') if isinstance(pj.get('elf'), dict) else {}
    ver = elf.get('versions') if isinstance(elf.get('versions'), dict) else {}
    runnable = 1 if pj.get('runnable') else 0
    return {
        'schema': COMPAT_SCHEMA,
        'target': target,
        'kind': pj.get('kind'),
        'runnable': runnable,
        'verdict': 'runnable' if runnable else 'blocked',
        'codes': [{'code': r.get('code'), 'layer': r.get('layer'),
                   'fatal': 1 if r.get('fatal') else 0,
                   'adaptable': 1 if r.get('adaptable') else 0}
                  for r in pj.get('reasons') or [] if isinstance(r, dict)],
        'elf': {
            'needed': list(elf.get('needed') or []),
            'missing': list(elf.get('missing') or []),
            'resolved': list(elf.get('resolved') or []),
            'versions': {
                'required': list(ver.get('required') or []),
                'host_libc': ver.get('host_libc'),
                'provided_max': ver.get('provided_max'),
                'too_new': list(ver.get('too_new') or []),
            },
        },
        'caveats': list(COMPAT_CAVEATS),
        'created_by': 'aikctl',
        'trace_id': None,        # MVP 恒 null；C2 接审计链时才填（§3.2）
    }


def compat_error_row(target, detail):
    """单目标失败条目（§3.1：rc=-1/超时/非 JSON → 记 error 继续扫）。"""
    return {
        'schema': COMPAT_SCHEMA,
        'target': target,
        'kind': 'error',
        'runnable': None,
        'verdict': 'error',
        'codes': [{'code': 'PROBE_ERROR', 'layer': 'L0', 'fatal': 1,
                   'adaptable': 0, 'detail': detail}],
        'elf': None,
        'caveats': [],
        'created_by': 'aikctl',
        'trace_id': None,
    }


def cmd_compat_scan(args):
    probe, err = compat_resolve_probe(args.probe)
    if err:
        print(err, file=sys.stderr)
        return 1
    out, opened = sys.stdout, None
    if args.jsonl:
        try:
            parent = os.path.dirname(os.path.abspath(args.jsonl))
            os.makedirs(parent, exist_ok=True)
            opened = open(args.jsonl, 'w', encoding='utf-8')
            out = opened
        except OSError as e:
            print('compat scan: 打开 %s 失败: %s' % (args.jsonl, e),
                  file=sys.stderr)
            return 1
    total = len(args.paths)
    n_run = n_blk = n_err = 0
    try:
        for path in args.paths:
            target = os.path.abspath(path)
            try:
                cp = subprocess.run([probe, 'probe', target],
                                    capture_output=True,
                                    timeout=COMPAT_PROBE_TIMEOUT)
                pj = compat_parse_probe(cp.stdout)
            except subprocess.TimeoutExpired:
                n_err += 1
                row = compat_error_row(
                    target, 'probe 超时（>%ds 被杀）' % COMPAT_PROBE_TIMEOUT)
            except RuntimeError as e:
                n_err += 1
                row = compat_error_row(target, 'probe 输出违约: %s' % e)
            except OSError as e:
                n_err += 1
                row = compat_error_row(target, 'probe 启动失败: %s' % e)
            else:
                row = compat_manifest_row(target, pj)
                if row['runnable']:
                    n_run += 1
                else:
                    n_blk += 1
            print(json.dumps(row, ensure_ascii=False, sort_keys=True,
                             separators=(',', ':')), file=out)
        print('C1_SCAN total=%d runnable=%d blocked=%d error=%d'
              % (total, n_run, n_blk, n_err), file=out)
    except OSError as e:
        print('compat scan: 写 manifest 失败: %s' % e, file=sys.stderr)
        return 1
    finally:
        if opened:
            opened.close()
    if total and n_err == total:
        print('compat scan: 全部 %d 个目标 probe 失败（见各行 error 条目）'
              % total, file=sys.stderr)
        return 1
    return 0


# ---------------------------------------------------------- compat C2 ----
# C2（COMPAT-C2-DESIGN §1 棒2）：plan/run/verify/rollback/promote/monitor
# 聚合子命令。执行面全部 fork aik-compat（generate/apply/verify/rollback
# 与 tool-call 面同一判定器与落地链，aik-compat 内经 exec_compat_channel
# 直调）；本面只做编排、W2 --yes 确认门与 promote 台账（aikctl 自有
# <compat_root>/promote/<name>.json，原子写，不动 compat state 文件）。
#
# 旁路风险（各子命令帮助文本同步注明）：run/promote 直调 aik-compat，
# 不经 executor 的 uid→档位闸门（executor.c:88）——动作等同当前 shell
# 用户直接执行；promote default 写宿主 /usr/local/bin 需 root。
COMPAT_PLAN_SCHEMA = 'aikernel.compat/plan/1'
PROMOTE_SCHEMA = 'aikernel.compat/promote/1'
COMPAT_ROOT_DEFAULT = '/var/lib/aikernel/compat'
COMPAT_LAUNCHER_DIR = '/usr/local/bin'
COMPAT_GEN_TIMEOUT = 120      # plan 的 generate 段（静态生成，无试跑）
COMPAT_APPLY_TIMEOUT = 600    # apply/rollback（workspace 创建+试跑）
COMPAT_VERIFY_TIMEOUT = 300   # verify（契约+三类负向自检）
AIK_COMPAT_SUB_RE = re.compile(r'^AIK_COMPAT sub=(\S+) rc=(-?\d+)\s*$')
LAUNCHER_NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$')


def compat_root():
    return os.environ.get('AIKERNEL_COMPAT_ROOT', COMPAT_ROOT_DEFAULT) or \
        COMPAT_ROOT_DEFAULT


def promote_ledger_path(name):
    return os.path.join(compat_root(), 'promote', '%s.json' % name)


def compat_state_path(name):
    return os.path.join(compat_root(), 'state', '%s.applied.json' % name)


def compat_adapter_path(name):
    return os.path.join(compat_root(), 'adapters', '%s.json' % name)


def compat_run_sub(probe, sub_args, timeout):
    """跑 aik-compat <sub_args…> → (rc, stdout 原文)；rc=None 表示无法
    执行/输出违约（第二项为人话）。rc = aik-compat 退出码（0/1/2）。"""
    try:
        cp = subprocess.run([probe] + sub_args, capture_output=True,
                            timeout=timeout)
    except subprocess.TimeoutExpired:
        return None, 'aik-compat 超时（>%ss 被杀）：%s' % (
            timeout, ' '.join(sub_args[:2]))
    except OSError as e:
        return None, 'aik-compat 启动失败: %s' % e
    text = cp.stdout.decode('utf-8', errors='replace')
    for ln in reversed(text.splitlines()):
        m = AIK_COMPAT_SUB_RE.match(ln.strip())
        if m:
            return int(m.group(2)), text
    return None, ('aik-compat 输出违约（缺 AIK_COMPAT sub= 末行）: %r'
                  % text[-160:])


def compat_first_json(text):
    """工具输出首行 → (dict, None) 或 (None, 人话)；ERROR: 行如实回传。"""
    lines = [ln for ln in text.splitlines() if ln.strip()]
    if not lines:
        return None, '（无输出）'
    first = lines[0].strip()
    if first.startswith('{'):
        try:
            obj = json.loads(first)
        except ValueError as e:
            return None, '结果 JSON 解析失败: %s' % e
        if isinstance(obj, dict):
            return obj, None
        return None, '结果不是 JSON object'
    return None, first[:300]


def compat_map_cli_exit(rc):
    return rc if rc is not None else 1


def compat_forward(text):
    """aik-compat stdout 原样转发（含末行 AIK_COMPAT 汇总）。"""
    if text:
        print(text, end='' if text.endswith('\n') else '\n')


def cmd_compat_plan(args):
    """probe+generate 二段 → 完整适配 manifest（jsonl 行 + C2_PLAN 汇总）。

    棒1 新字段（risk/limitations/provides/created_by/trace_id）按合同读：
    在 generate 输出的 adapter 内如实透传，缺席不补造。
    C3 新字段同款纪律（COMPAT-C3-DESIGN §1，Lane-1 合同）：probe 顶层
    emulators 与 adapter.layers.L3 均逐字段原样内嵌（row['probe']=probe
    JSON 整体、row['adapter']=generate 首行 JSON 整体）——Lane-1 未合入
    时缺席=如实透传不补造；AIK_QEMU_USER_<ARCH> 等 env 经 subprocess 环境
    原样传给 probe/generate，本面不解释。"""
    probe, err = compat_resolve_probe(args.probe)
    if err:
        print(err, file=sys.stderr)
        return 1
    target = os.path.abspath(args.target)
    name = args.name
    if not name:
        base = os.path.basename(target)
        name = re.sub(r'[^A-Za-z0-9_.-]+', '-', base)[:32].strip('.-')
        name = name or 'compat-target'
    # —— probe 段（与 scan 同一条判定路径）——
    pj, probe_error = None, None
    try:
        cp = subprocess.run([probe, 'probe', target], capture_output=True,
                            timeout=COMPAT_PROBE_TIMEOUT)
        pj = compat_parse_probe(cp.stdout)
    except subprocess.TimeoutExpired:
        probe_error = 'probe 超时（>%ds 被杀）' % COMPAT_PROBE_TIMEOUT
    except RuntimeError as e:
        probe_error = 'probe 输出违约: %s' % e
    except OSError as e:
        probe_error = 'probe 启动失败: %s' % e
    # —— generate 段（manifest 主体；不可修类由工具面诚实拒绝）——
    gen = ['generate', name, target]
    if args.workspace:
        gen += ['--workspace', args.workspace]
    for kv in args.interpreter_map:
        gen += ['--interpreter-map', kv]
    for kv in args.lib_source:
        gen += ['--lib-source', kv]
    for kv in args.env:
        gen += ['--env', kv]
    for s in args.expect_stdout:
        gen += ['--expect-stdout', s]
    for s in args.expect_stderr_not:
        gen += ['--expect-stderr-not', s]
    if args.expect_exit is not None:
        gen += ['--expect-exit', str(args.expect_exit)]
    if args.expect_max_ms is not None:
        gen += ['--expect-max-ms', str(args.expect_max_ms)]
    for a in args.arg:
        gen += ['--arg', a]
    if args.timeout_s is not None:
        gen += ['--timeout-s', str(args.timeout_s)]
    if args.dry_run:
        gen.append('--dry-run')
    adapter, adapter_error = None, None
    grc, gtext = compat_run_sub(probe, gen, COMPAT_GEN_TIMEOUT)
    if grc is None:
        adapter_error = gtext
    else:
        obj, perr = compat_first_json(gtext)
        if grc == 0 and obj is not None and obj.get('ok'):
            adapter = obj
        else:
            adapter_error = 'generate 失败（rc=%d）：%s' % (
                grc, perr or '结果未带 ok=true')
    if adapter is not None:
        verdict = 'planned'
    elif pj is not None:
        fatal = [r for r in (pj.get('reasons') or [])
                 if isinstance(r, dict) and r.get('fatal')]
        adaptable = [r for r in fatal if r.get('adaptable')]
        verdict = 'not_adaptable' if fatal and not adaptable else 'error'
    else:
        verdict = 'error'
    row = {
        'schema': COMPAT_PLAN_SCHEMA,
        'target': target,
        'name': name,
        'probe': pj if pj is not None else {'error': probe_error},
        'runnable': bool(pj.get('runnable')) if pj is not None else None,
        'adapter': adapter,
        'adapter_error': adapter_error,
        'verdict': verdict,
        'created_by': 'aikctl',
        'trace_id': None,
    }
    out, opened = sys.stdout, None
    if args.jsonl:
        try:
            parent = os.path.dirname(os.path.abspath(args.jsonl))
            os.makedirs(parent, exist_ok=True)
            opened = open(args.jsonl, 'w', encoding='utf-8')
            out = opened
        except OSError as e:
            print('compat plan: 打开 %s 失败: %s' % (args.jsonl, e),
                  file=sys.stderr)
            return 1
    try:
        print(json.dumps(row, ensure_ascii=False, sort_keys=True,
                         separators=(',', ':')), file=out)
        print('C2_PLAN target=%s name=%s runnable=%s adapter=%s verdict=%s'
              % (target, name,
                 '?' if pj is None else int(bool(pj.get('runnable'))),
                 'ok' if adapter is not None else 'error', verdict),
              file=out)
    except OSError as e:
        print('compat plan: 写 manifest 失败: %s' % e, file=sys.stderr)
        return 1
    finally:
        if opened:
            opened.close()
    if adapter is None:
        why = adapter_error or probe_error
        if why:
            print('compat plan: %s' % why, file=sys.stderr)
        return 1
    return 0


def compat_adapter_summary(name):
    """读适配器 → 摘要行（run/promote 的 --yes 动作摘要）。棒1 新字段
    按合同读：在场即展示，缺席如实标注不补造。→ (摘要行, None)/(None, 人话)。"""
    try:
        with open(compat_adapter_path(name), 'r', errors='replace') as f:
            obj = json.load(f)
        if not isinstance(obj, dict):
            raise ValueError('不是 JSON object')
    except (OSError, ValueError) as e:
        return None, ('适配器 %s 不可读（%s: %s）。\n'
                      '下一步：先 aikctl compat plan <target> --name %s'
                      ' 生成适配器。' % (name, compat_adapter_path(name), e,
                                        name))
    layers = obj.get('layers') if isinstance(obj.get('layers'), dict) else {}
    l0 = layers.get('L0') if isinstance(layers.get('L0'), dict) else {}
    l2 = layers.get('L2') if isinstance(layers.get('L2'), dict) else {}
    tgt = obj.get('target') if isinstance(obj.get('target'), dict) else {}
    counts = ' '.join('%s=%d' % (k, len(l0.get(k) or []))
                      for k in ('env', 'path_map', 'lib_redirect', 'chmod')
                      if isinstance(l0.get(k), list))
    risk = obj.get('risk')
    parts = ['适配器 %s:' % name,
             'target=%s' % tgt.get('host', '?'),
             'workspace=%s' % l2.get('workspace', '?'),
             'rules(%s)' % counts if counts else 'rules(L0=0)',
             'usr_overlay=%s' % l2.get('usr_overlay')]
    parts.append('risk=%s' % risk if risk is not None
                 else 'risk=(棒1字段缺席)')
    return ' '.join(parts), None


def cmd_compat_run(args):
    """=aik-compat apply（W2 硬门：无 --yes 拒绝并给下一步；
    --yes 时先打印将执行动作摘要）。"""
    probe, err = compat_resolve_probe(args.probe)
    if err:
        print(err, file=sys.stderr)
        return 1
    if not args.yes:
        print('拒绝：compat run 是 W2 写操作（在 workspace 内落地适配器并'
              '试跑；试跑失败自动回滚），必须 --yes 显式确认。\n'
              '注意：本面不经 executor 的 uid 档位闸，动作等同当前用户'
              '直接执行。\n'
              '下一步：复核适配器（aikctl compat plan 可重新查看）后执行 '
              'aikctl compat run %s --yes' % args.name, file=sys.stderr)
        return 2
    summary, serr = compat_adapter_summary(args.name)
    print('将执行: aik-compat apply %s（W2；workspace 内落地+试跑，'
          '试跑失败自动回滚）' % args.name)
    print(serr or summary)
    sub = ['apply', args.name]
    if args.workspace:
        sub += ['--workspace', args.workspace]
    rc, text = compat_run_sub(probe, sub, COMPAT_APPLY_TIMEOUT)
    if rc is None:
        print('compat run: %s' % text, file=sys.stderr)
        return 1
    compat_forward(text)
    return compat_map_cli_exit(rc)


def cmd_compat_verify(args):
    probe, err = compat_resolve_probe(args.probe)
    if err:
        print(err, file=sys.stderr)
        return 1
    sub = ['verify', args.name] + (['--no-trace'] if args.no_trace else [])
    rc, text = compat_run_sub(probe, sub, COMPAT_VERIFY_TIMEOUT)
    if rc is None:
        print('compat verify: %s' % text, file=sys.stderr)
        return 1
    compat_forward(text)
    return compat_map_cli_exit(rc)


