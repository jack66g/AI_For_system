def _synth_chain(seed_val=0xdeadbeef00000000):
    """合成 5 节点链（genesis+DECISION_NEW+AGENT_REJECT+KEY_EVENT+ANCHOR），
    prev 逐节点咬合、self_hash 按 72B 布局重算。→ (meta, node_json_list)。"""
    spec = [
        (1, 10 ** 9, 1, KIND_GENESIS, 0,
         struct.pack('<Q', 0x1234feed5678dcba) + b'\x00' * 24),
        (2, 10 ** 9 + 5, 4242, KIND_DECISION_NEW, 0,
         struct.pack('<QIBBB', 0xdead01, 7, 1, 2, 3) + b'\x00' * 17),
        (3, 10 ** 9 + 9, 4242, KIND_AGENT_REJECT, 0,
         struct.pack('<IIII', 5, 12, 8, 0)),
        (4, 10 ** 9 + 14, 999, KIND_KEY_EVENT, 0,
         struct.pack('<Q', 0xaabbccdd11223344) + struct.pack('<Q', 2)
         + b'\x00' * 16),
        (5, 10 ** 9 + 20, 1, KIND_ANCHOR, 1,
         struct.pack('<QQII', 5, 1, 3, 0)),
    ]
    prev = seed_val
    out = []
    for seq, ts, pid, kind, flags, data in spec:
        h = node_hash(node_raw(seq, ts, prev, 0, pid, kind, flags, data))
        out.append(node_to_json(seq, ts, kind, pid, flags, prev, h, data))
        prev = h
    meta = {'meta': True, 'boot_cookie': '1234feed5678dcba',
            'node_count': len(out), 'head': '%016x' % prev}
    return meta, out


def _write_export_file(path, meta, nodes):
    with open(path, 'w') as f:
        f.write('\n'.join([_canon(meta)] + [_canon(nd) for nd in nodes])
                + '\n')


def _flip_hex_char(s, pos):
    """在 s 的 pos 处把 hex 字符翻成另一个（保持 hex 合法）。"""
    c = s[pos]
    return s[:pos] + ('0' if c != '0' else '1') + s[pos + 1:]


def _rewrite_json_value(line, key, new_val):
    """保持行 json 合法地改一个值（锚行链篡改用）。"""
    obj = json.loads(line)
    obj[key] = new_val
    return _canon(obj)


def cmd_selftest(_args):
    total = [0]
    ok = [0]

    def case(name, cond):
        total[0] += 1
        ok[0] += 1 if cond else 0
        print('  %-52s %s' % (name, 'PASS' if cond else 'FAIL'))

    # ① 纯 python XXH64 向量自检（必含 empty/seed=0）
    case('xxh64(b"", seed=0)==0xef46db3751d8e999',
         xxh64(b'', 0) == 0xef46db3751d8e999)
    pat = bytes(range(256))
    for n, seed, expect in XXH64_VECTORS:
        d = pat[:n] if n <= 256 else (pat * 4)[:n]
        case('xxh64(pattern[:%d], seed=0x%x)==%016x' % (n, seed, expect),
             xxh64(d, seed) == expect)

    # ② 合成 5 节点链 → verify PASS → 篡改/抽走/截尾 → 必须失败并定位
    with tempfile.TemporaryDirectory() as td:
        chain_f = os.path.join(td, 'chain.jsonl')
        meta, nodes = _synth_chain()
        _write_export_file(chain_f, meta, nodes)
        code, out = verify_chain(*load_export(chain_f))
        case('合成 5 节点链 verify OK', code == 0
             and out[0] == 'OK nodes=5 head=%s' % nodes[-1]['hash'])

        bad = [dict(nd) for nd in nodes]
        bad[2]['data'] = _flip_hex_char(bad[2]['data'], 5)
        _write_export_file(chain_f, meta, bad)
        code, out = verify_chain(*load_export(chain_f))
        case('篡改 node[2].data → TAMPER index=2 seq=3 field=data',
             code == 2 and out[0] == 'TAMPER index=2 seq=3 field=data')

        bad = [dict(nd) for nd in nodes]
        bad[4]['hash'] = _flip_hex_char(bad[4]['hash'], 3)
        _write_export_file(chain_f, meta, bad)
        code, out = verify_chain(*load_export(chain_f))
        case('篡改 node[4].hash → TAMPER index=4 field=hash（头行见证）',
             code == 2 and out[0] == 'TAMPER index=4 seq=5 field=hash')

        bad = [dict(nd) for nd in nodes]
        bad[3]['prev'] = _flip_hex_char(bad[3]['prev'], 2)
        _write_export_file(chain_f, meta, bad)
        code, out = verify_chain(*load_export(chain_f))
        case('篡改 node[3].prev → TAMPER index=3 field=prev',
             code == 2 and out[0] == 'TAMPER index=3 seq=4 field=prev')

        bad = [nd for i, nd in enumerate(nodes) if i != 2]
        _write_export_file(chain_f, meta, bad)
        code, out = verify_chain(*load_export(chain_f))
        case('抽走 node[2] → TAMPER index=2 field=gap + 缺口 seq 3..3',
             code == 2 and out[0] == 'TAMPER index=2 seq=4 field=gap'
             and 'gap: seq 3..3' in out[1])

        _write_export_file(chain_f, meta, nodes[:4])
        code, out = verify_chain(*load_export(chain_f))
        case('截尾 5→4 → TAMPER field=gap（meta node_count=5）',
             code == 2 and out[0] == 'TAMPER index=4 seq=5 field=gap'
             and '截尾' in out[1])

        # ③ 锚行链：追加 2 行 OK → 篡改首行值 → 断；去头行 → 断
        _write_export_file(chain_f, meta, nodes)   # 还原完好链
        anc_f = os.path.join(td, 'anchors.jsonl')
        ns = argparse.Namespace(e=chain_f, anchors=anc_f)
        cmd_anchor(ns)
        meta_b = dict(meta, head='%016x' % (int(meta['head'], 16) ^ 3))
        chain_b = os.path.join(td, 'chain_b.jsonl')
        _write_export_file(chain_b, meta_b, nodes)
        cmd_anchor(argparse.Namespace(e=chain_b, anchors=anc_f))
        acode, _aout = verify_anchor_file(anc_f)
        case('锚行链 2 行 ANCHOR_OK', acode == 0)
        with open(anc_f) as f:
            lines = [ln for ln in f.read().splitlines() if ln.strip()]
        with open(anc_f, 'w') as f:   # 篡改首行 head_hash 值（json 仍合法）
            f.write(_rewrite_json_value(lines[0], 'head_hash',
                                        'deadbeefdeadbeef') + '\n'
                    + lines[1] + '\n')
        acode, _aout = verify_anchor_file(anc_f)
        case('锚首行值篡改 → ANCHOR_CHAIN_BREAK 退 3', acode == 3)
        with open(anc_f, 'w') as f:   # 去头：次行 prev_line 指向已不存在的行
            f.write(lines[1] + '\n')
        acode, _aout = verify_anchor_file(anc_f)
        case('锚去头行 → 退 3', acode == 3)

    # ④ P-2 user：gate 行格式解析/写往返桩（纯函数+临时文件，零系统触）
    with tempfile.TemporaryDirectory() as td:
        g = os.path.join(td, 'console-gate')
        stub_a = '$6$stub01$AbCdEf0123456789AbCdEf0123456789'
        stub_b = '$6$stub02$BbCdEf0123456789BbCdEf0123456789'
        with open(g, 'w', encoding='utf-8') as f:
            f.write('# P-2 selftest stub\n\n'
                    'admin:%s:1750000000\n'
                    'tstp2b1:%s:1750000100:2\n' % (stub_a, stub_b))
        rows, raw_s = gate_read(g)
        case('gate 解析 2 行（# 注释/空行忽略）',
             rows is not None and len(rows) == 2
             and rows[0]['name'] == 'admin' and rows[0]['hash'] == stub_a
             and rows[0]['ts'] == 1750000000 and rows[0]['fails'] is None
             and rows[1]['fails'] == 2 and rows[1]['lineno'] == 4)
        raw2 = [ln if i != 4 else 'tstp2b1:%s:1750000200' % stub_b
                for i, ln in enumerate(raw_s, 1)]
        raw2.append('tstp2b2:%s:1750000300' % stub_a)
        werr = gate_write(g, raw2)
        rows3, raw3 = gate_read(g)
        case('gate 原子写往返（改行+加行 → 再解析一致；0600）',
             werr is None and len(rows3) == 3
             and gate_row_find(rows3, 'tstp2b1')['ts'] == 1750000200
             and gate_row_find(rows3, 'tstp2b1')['fails'] is None
             and gate_row_find(rows3, 'tstp2b2') is not None
             and raw3[0] == '# P-2 selftest stub'      # 注释行原样保留
             and oct(os.stat(g).st_mode)[-3:] == '600')
        for bad, why in (('bob:$5$x:123', '哈希前缀'),
                         ('alice:%s' % stub_a, '字段数'),
                         ('carol:%s:xy' % stub_a, '时间戳'),
                         ('dan:%s:12:zz' % stub_a, '失败计数'),
                         ('Bad Name:%s:12' % stub_a, '用户名')):
            gb = os.path.join(td, 'gate-bad')
            with open(gb, 'w', encoding='utf-8') as f:
                f.write(bad + '\n')
            rbad, _ = gate_read(gb)
            case('gate 坏行拒绝（%s）→ None' % why, rbad is None)
        case('用户名规则（合法/非法）',
             USER_NAME_RE.match('tstp2b1') is not None
             and USER_NAME_RE.match('admin') is not None
             and USER_NAME_RE.match('Root') is None
             and USER_NAME_RE.match('1abc') is None
             and USER_NAME_RE.match('a b') is None
             and USER_NAME_RE.match('-x') is None)
        h = _pw_hash('stub123')
        ok_h = bool(h) and h.startswith('$6$') and len(h) < 128
        try:
            import crypt as _c
            ok_h = ok_h and _c.crypt('stub123', h) == h
        except ImportError:
            pass
        case('sha512crypt 生成/自证（$6$、<128、crypt 复算一致）', ok_h)

    print('SELFTEST_RESULT cases=%d ok=%d' % (total[0], ok[0]))
    return 0 if ok[0] == total[0] else 1


