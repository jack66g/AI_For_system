def _parse_date(s, what):
    try:
        return datetime.strptime(s, '%Y-%m-%d').date()
    except ValueError:
        print('aikctl: %s=%s 非法（需 YYYY-MM-DD）' % (what, s),
              file=sys.stderr)
        sys.exit(1)


def _day_bounds_ns(since_d, until_d):
    """[since 00:00:00, until+1d 00:00) 的 epoch-ns 闭开界（UTC——
    timestamp_ns 为 UTC epoch ns）。"""
    lo = int(datetime(since_d.year, since_d.month, since_d.day,
                      tzinfo=timezone.utc).timestamp()) * 1000000000
    hi_day = until_d + timedelta(days=1)
    hi = int(datetime(hi_day.year, hi_day.month, hi_day.day,
                      tzinfo=timezone.utc).timestamp()) * 1000000000
    return lo, hi - 1                    # 闭区间：hi-1ns


def _layer_dir(root, layer):
    return os.path.join(root, 'telemetry' if layer == 'raw' else 'curated')


def _day_dirs(root, layer, since_d, until_d):
    """窗口内（含端点）的天目录 (day, path) 列表，日期名升序。"""
    base = _layer_dir(root, layer)
    lo, hi = since_d.isoformat(), until_d.isoformat()
    out = []
    if not os.path.isdir(base):
        return out
    for name in sorted(os.listdir(base)):
        if re.fullmatch(r'\d{4}-\d{2}-\d{2}', name) \
                and lo <= name <= hi \
                and os.path.isdir(os.path.join(base, name)):
            out.append((name, os.path.join(base, name)))
    return out


def _cat_files(day_dir):
    """天目录内布局数据文件（<cat>_<seq>.parquet 白名单——沿
    as_parquet.c:1160 is_tel_data_file / as_pq_sink.c is_rotated 的
    *_*.parquet 非 index 语义。棒④ 台架 C13 实锤：原 cat_ 字面量前缀
    漏掉 aistreamd 实产 <cat名>_NNNN.parquet（如 ai_0000.parquet）→
    真数据根 rows=0；按自注语义放宽）。"""
    out = []
    for name in sorted(os.listdir(day_dir)):
        if (name == 'index.parquet' or not name.endswith('.parquet')
                or '_' not in name[:-len('.parquet')]):
            continue
        out.append(os.path.join(day_dir, name))
    return out


# ---- SENSE 脱敏 python 移植（导出门内建；只读参考 aistreamd，不 import
# C 代码——复制规则要点并注明来源行号）：
#   - 值级变换 FNV-1a64(salt||0x01||value)/hash "h:<16hex>"/mask 首字符
#     +***/drop "-"：aistreamd/as_redact.c:76-89（as_redact_fnv64）与
#     as_redact.c:92-117（redact_one）
#   - 字段类 soft/strict 策略表：aistreamd/as_event.c:16-54（rs_pid 恒
#     hash；rs_idval=rs_comm soft hash/strict drop；rs_addr=rs_path=
#     rs_model soft mask/strict drop；rs_dev soft 透传/strict mask）
#   - decision_id 恒原样例外：aistreamd/as_event.h:36（K3-DESIGN §K3c
#     审计链冻结契约）
#   - credential 类为本导出门扩展：内核遥测字段表无凭据字段，但导出
#     面向全文行文本（设计 §3 探勘风险提示：SENSE off 数据源=原文），
#     故 soft mask / strict drop（键序不变，仅值变换——同 as_event.h:60
#     "行格式不变仅字段值变换"语义）。
_FNV_OFFSET = 0xcbf29ce484222325
_FNV_PRIME = 0x100000001b3
REDACT_SALT = ''        # MVP 无盐（as_redact.h:19-21 诚实声明同样适用：
                        # 无盐低熵值可枚举——定位是去标识化非匿名）

# 类 → (soft, strict)；None=透传。'p'=hash 'm'=mask 'd'=drop
_REDACT_CLASSES = {
    'pid':   ('p', 'p'),     # as_event.c:19 rs_pid——保聚合 join
    'idval': ('p', 'd'),     # as_event.c:24 rs_idval（uid/gid/comm）
    'addr':  ('m', 'd'),     # as_event.c:31 rs_addr（IP/路由）
    'path':  ('m', 'd'),     # as_event.c:37 rs_path
    'model': ('m', 'd'),     # as_event.c:43 rs_model
    'dev':   (None, 'm'),    # as_event.c:49 rs_dev
    'cred':  ('m', 'd'),     # aikctl 导出门扩展类
}
_KEY_CLASS = {
    'parent': 'pid', 'child': 'pid', 'pid': 'pid', 'ppid': 'pid',
    'tgid': 'pid',
    'comm': 'idval', 'uid': 'idval', 'gid': 'idval',
    'addr': 'addr', 'dst': 'addr', 'gw': 'addr', 'local': 'addr',
    'peer': 'addr',
    'prefix': 'path', 'path': 'path', 'exe': 'path',
    'model': 'model',
    'dev': 'dev', 'device': 'dev',
    'password': 'cred', 'passwd': 'cred', 'secret': 'cred',
    'token': 'cred', 'api_key': 'cred', 'apikey': 'cred',
    'authorization': 'cred', 'auth': 'cred', 'cookie': 'cred',
    'credential': 'cred', 'private_key': 'cred',
}
_KV_RE = re.compile(r'([A-Za-z_][A-Za-z0-9_]*)=([^ ]+)')


def _fnv64(salt, value):
    """FNV-1a64(salt || 0x01 || value)——as_redact.c:76-89 移植。"""
    h = _FNV_OFFSET
    for ch in (salt or ''):
        h = ((h ^ ord(ch)) * _FNV_PRIME) & 0xFFFFFFFFFFFFFFFF
    h ^= 0x01
    for ch in (value or ''):
        h = ((h ^ ord(ch)) * _FNV_PRIME) & 0xFFFFFFFFFFFFFFFF
    return h


def _redact_value(v, strat):
    if strat == 'p':
        return 'h:%016x' % _fnv64(REDACT_SALT, v)
    if strat == 'm':
        return (v[:1] + '***') if v else '***'
    if strat == 'd':
        return '-'
    return v


def redact_line(line, level):
    """行文本 k=v 值变换（off=恒等，字节零变化——同 as_event.c 冻结
    fixture 前提）；键名/键序不变，decision_id 例外恒原样。"""
    if level == 'off':
        return line

    def repl(m):
        k = m.group(1)
        if k == 'decision_id':
            return m.group(0)
        cls = _KEY_CLASS.get(k)
        if cls is None:
            return m.group(0)
        strat = _REDACT_CLASSES[cls][0 if level == 'soft' else 1]
        return '%s=%s' % (k, _redact_value(m.group(2), strat))

    return _KV_RE.sub(repl, line)


def redact_pid_col(pid, level):
    """pid 列整型脱敏——as_redact.c:109-122 as_redact_pid_col 移植：
    hash → (fnv64 & 0x7fffffff)；pid<=0 原样（无主体=0 语义）。"""
    if level == 'off' or pid is None or pid <= 0:
        return pid
    return _fnv64(REDACT_SALT, str(pid)) & 0x7FFFFFFF


def _ts_wall_ns(ts, _btime_cache=[None]):
    """行时基归一：aistreamd 实产行存开机单调 ns（as_pq_sink.c feed 注
    释 REF 语义；棒④ 台架 C13 二段实锤：墙钟窗罩不住单调时基→rows=0），
    fixture/外部行常为墙钟 ns。判定：ts < 1e17（≈1973 年前，不可能为
    墙钟）视为单调，按 /proc/stat btime 平移成墙钟；否则原样。"""
    if ts is None:
        return None
    ts = int(ts)
    if ts >= 10 ** 17:
        return ts
    if _btime_cache[0] is None:
        bt = 0
        try:
            with open('/proc/stat', 'r') as fh:
                for ln in fh:
                    if ln.startswith('btime '):
                        bt = int(ln.split()[1])
                        break
        except OSError:
            pass
        _btime_cache[0] = bt
    return ts + _btime_cache[0] * 10 ** 9 if _btime_cache[0] else ts




def _pq_read(path, what='读取'):
    """P-27 双后端：aik-pqdump（C，出厂件，读自家写入面）优先；
    缺席回退 pyarrow（开发机）。返回列式 dict（to_pydict 同构）。
    损坏/超面 → 人话错。"""
    c = _find_pqdump()
    cerr = None
    if c:
        try:
            r = subprocess.run([c, '--bycol', path], capture_output=True)
        except OSError as e:
            r = None
            cerr = 'C 后端执行失败: %s' % e
        if r is not None and r.returncode == 0:
            try:
                return json.loads(r.stdout)
            except Exception as e:
                cerr = 'C 后端输出异常: %s' % e
        elif r is not None:
            cerr = r.stderr.decode('utf-8', 'replace').strip()
            # 损坏（非超面）时 pyarrow 也救不了——但开发机 oracle
            # 对照语义保留：一律下探 pyarrow，最终错误择实报
    # pyarrow 回退（C 缺席/超面〔如 pyarrow 写的通用面——l1_data_bench
    # curated fixture 形态〕/异常；缺席且 C 有错=报 C 的错）
    try:
        import pyarrow.parquet as pqp
        return pqp.read_table(path).to_pydict()
    except SystemExit:
        raise
    except ImportError as e:
        if cerr is not None:
            raise SystemExit("aikctl: parquet %s失败 %s: %s"
                             % (what, path, cerr))
        raise SystemExit(
            'aikctl: dataset 子族读侧无可用后端（aik-pqdump 缺席且 '
            'pyarrow 导入失败：%s）；出厂面装 aik-pqdump（W-7 通道）'
            '或开发机 pip install pyarrow' % e)
    except Exception as e:
        hint = ''
        if 'Multiple matches' in str(e):
            # P-56（11-20 T-2 B7 真机实证）：旧版影子件 source 列
            # 重名（决策块 int + 尾列 string）——标准读者拒读。
            hint = ('；旧版影子件列名重份（P-56 修复前产物不可整读——'
                    '用修复后 aipd 重生数据，或按列挑选读）')
        raise SystemExit("aikctl: parquet %s失败（损坏文件？）%s: %s%s"
                         % (what, path, e, hint))


# P-27e：写侧类型面——aik-pqdump --write 的 --schema 串（C 后端）与
# pyarrow 类型名（回退后端）同词双用。
_PQ_TY = {
    'INT8': 'int8', 'INT16': 'int16', 'INT32': 'int32',
    'INT64': 'int64', 'DOUBLE': 'float64', 'STRING': 'string',
}


def _pq_write(out, jsonl, schema):
    """P-27e 双后端写（aikctl export 写侧 C 化）：aik-pqdump --write
    （C，出厂件，与 aistreamd as_parquet.c 同一写入器）优先；缺席/失败
    回退 pyarrow（开发机保底）。jsonl=行式 JSON 字节串（_rows_jsonl_bytes
    同构）；schema=[(列名, 'INT8'|...|'STRING')]。两后端产物 pyarrow 读回
    逐列逐值一致（oracle 级，tests/test_pqwrite.py 对拍）。"""
    c = _find_pqdump()
    cerr = None
    if c:
        spec = ','.join('%s:%s' % (n, ty) for n, ty in schema)
        try:
            r = subprocess.run(
                [c, '--write', '--out', out, '--schema', spec],
                input=jsonl, stdout=subprocess.PIPE,
                stderr=subprocess.PIPE)
        except OSError as e:
            r = None
            cerr = 'C 后端执行失败: %s' % e
        if r is not None and r.returncode == 0:
            return
        if r is not None:
            cerr = r.stderr.decode('utf-8', 'replace').strip()
    # pyarrow 回退（C 缺席/失败；缺席且 C 有错=报 C 的错）
    try:
        import pyarrow
        import pyarrow.parquet
    except ImportError as e:
        if cerr is not None:
            raise SystemExit("aikctl: parquet 写失败 %s: %s" % (out, cerr))
        raise SystemExit(
            'aikctl: dataset 子族写侧无可用后端（aik-pqdump 缺席且 '
            'pyarrow 导入失败：%s）；出厂面装 aik-pqdump（W-7 通道）'
            '或开发机 pip install pyarrow' % e)
    rows = [json.loads(ln) for ln in jsonl.splitlines() if ln.strip()]
    cols = {n: [r.get(n) for r in rows] for n, _ty in schema}
    paschema = pyarrow.schema(
        [(n, getattr(pyarrow, _PQ_TY[ty])()) for n, ty in schema])
    pyarrow.parquet.write_table(
        pyarrow.Table.from_pydict(cols, schema=paschema), out)


def _collect_rows(root, since_d, until_d, layer='curated'):
    """窗口内 curated 天目录 cat 文件逐行读出（P-27 读侧双后端
    _pq_read），行级 timestamp_ns 过滤（天目录为主筛、行级为诚实
    复核；时基归一见 _ts_wall_ns）。"""
    lo, hi = _day_bounds_ns(since_d, until_d)
    rows = []
    for _day, ddir in _day_dirs(root, layer, since_d, until_d):
        for path in _cat_files(ddir):
            cols = _pq_read(path)
            n = len(cols.get('timestamp_ns', []))
            for i in range(n):
                ts = _ts_wall_ns(cols['timestamp_ns'][i])
                if ts is not None and lo <= ts <= hi:
                    row = {}
                    for c in DATASET_TEL_COLS:
                        row[c] = cols[c][i] if c in cols else None
                    # 真产物 data 列=二进制（C writer PQ byte array），
                    # fixture=字符串——归一成 str（棒④ C13 三段实锤：
                    # bytes 直接进 redact 正则会 TypeError）。
                    if isinstance(row.get('data'), bytes):
                        row['data'] = row['data'].decode(
                            'utf-8', 'replace')
                    rows.append(row)
    rows.sort(key=lambda r: r['timestamp_ns'])
    return rows


def _rows_jsonl_bytes(rows):
    out = []
    for r in rows:
        out.append(json.dumps(
            {c: r[c] for c in DATASET_TEL_COLS}, ensure_ascii=False))
    return ('\n'.join(out) + ('\n' if out else '')).encode('utf-8')


