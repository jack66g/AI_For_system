def aipd_read_kv(path):
    """KEY=VALUE 扁平 conf → dict（'#' 注释/空行忽略；不可读返回 None）。"""
    out = {}
    try:
        with open(path, encoding='utf-8', errors='replace') as fh:
            for ln in fh:
                s = ln.strip()
                if not s or s.startswith('#') or '=' not in s:
                    continue
                k, v = s.split('=', 1)
                out[k.strip()] = v.strip()
    except OSError:
        return None
    return out


