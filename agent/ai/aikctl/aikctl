CHAIN_SEED = 0x414b3831          # 'AK81'——节点 self_hash 的 xxh64 seed
NODE_FMT = '<QQQQIHH'            # 40B 头 + data[32] = 72B（'<'=小端无垫）
M64 = (1 << 64) - 1

# kind 编号：KEY_EVENT=6 / SECCOMP_ANOMALY=7 为冻结契约；实机钉扎
# （k8v rig 干跑，K8 内核实链 kind 分布 {0:GENESIS,1:DECISION_NEW,
