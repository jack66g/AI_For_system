def cmd_module_approve(args):
    nonce = args.nonce
    if not MODULE_NONCE_RE.match(nonce):
        print('module approve: 非法 nonce（32 hex）: %r' % nonce,
              file=sys.stderr)
        return 1
    base = module_confirm_dir()
    ppath = os.path.join(base, 'pending', '%s.json' % nonce)
    lpath = os.path.join(module_dir(), 'ledger.jsonl')

    def refuse(reason):
        fc = _module_fail_count(lpath, nonce)
        if reason == 'phrase_mismatch':
            fc += 1
        try:
            module_ledger_append({'ev': 'refused', 'nonce': nonce,
                                  'reason': reason, 'fail_count': fc,
                                  'uid': os.getuid()})
        except (RuntimeError, OSError):
            pass
        print('module approve: 拒绝（%s；fail_count=%d）。下一步：核对短语'
              '（逐字节精确）或重新 propose。' % (reason, fc), file=sys.stderr)
        return 1

    if not os.path.isfile(ppath):
        return refuse('unknown_or_consumed_nonce')
    try:
        with open(ppath, 'r', errors='replace') as f:
            pend = json.load(f)
    except (OSError, ValueError) as e:
        print('module approve: pending 读失败: %s' % e, file=sys.stderr)
        return 1
    if int(pend.get('expires_at') or 0) <= int(time.time()):
        return refuse('expired')
    # D4 短语逐字节精确比对（== 对 str 即逐字节；policy/ai_lease.c 同款）
    if args.phrase != 'CONFIRM D4 %s' % nonce:
        return refuse('phrase_mismatch')
    now = int(time.time())
    by = _module_uid_name()
    approved = {
        'nonce': nonce, 'tool': pend.get('tool'),
        'args_json': pend.get('args_json'), 'danger': 'D4',
        'lease_id': None, 'expires_at': pend.get('expires_at'),
        'approved_at': now, 'approved_by': by, 'approved': True,
        'ko': pend.get('ko'), 'md5': pend.get('md5'),
        'vermagic': pend.get('vermagic'),
    }
    apath = os.path.join(base, 'approved', '%s.json' % nonce)
    try:
        _mkdir_0700(os.path.join(base, 'approved'))
        _write_0600(apath, _canon(approved) + '\n')
        os.unlink(ppath)
    except OSError as e:
        print('module approve: 写 approved/删 pending 失败: %s' % e,
              file=sys.stderr)
        return 1
    try:
        module_ledger_append({'ev': 'approve', 'nonce': nonce,
                              'md5': pend.get('md5'), 'approved_by': by,
                              'uid': os.getuid()})
    except (RuntimeError, OSError) as e:
        print('module approve: 账本写入失败: %s' % e, file=sys.stderr)
        return 1
    print('MODULE_APPROVED nonce=%s approved_by=%s' % (nonce, by))
    print('下一步: aikctl module install %s（缺省 --dry-run，只打印不执行）'
          % nonce)
    return 0


def cmd_module_install(args):
    nonce = args.nonce
    if not MODULE_NONCE_RE.match(nonce):
        print('module install: 非法 nonce（32 hex）: %r' % nonce,
              file=sys.stderr)
        return 1
    base = module_confirm_dir()
    ppath = os.path.join(base, 'pending', '%s.json' % nonce)
    apath = os.path.join(base, 'approved', '%s.json' % nonce)
    lpath = os.path.join(module_dir(), 'ledger.jsonl')

    def refuse(reason):
        fc = _module_fail_count(lpath, nonce)
        try:
            module_ledger_append({'ev': 'refused', 'nonce': nonce,
                                  'reason': reason, 'fail_count': fc,
                                  'uid': os.getuid()})
        except (RuntimeError, OSError):
            pass
        print('module install: 拒绝（%s；L5 人工硬门：未批准 nonce 一律'
              '不装载）。下一步：先 approve（D4 短语逐字节精确）。'
              % reason, file=sys.stderr)
        return 1

    if os.path.isfile(ppath) and not os.path.isfile(apath):
        return refuse('not_approved_yet')      # 机判负例：未批准一律拒绝
    if not os.path.isfile(apath):
        return refuse('unknown_nonce')
    try:
        with open(apath, 'r', errors='replace') as f:
            approved = json.load(f)
    except (OSError, ValueError) as e:
        print('module install: approved 读失败: %s' % e, file=sys.stderr)
        return 1
    if not approved.get('approved'):
        return refuse('not_approved')
    if int(approved.get('expires_at') or 0) <= int(time.time()):
        return refuse('expired_approval')
    ko = approved.get('ko') or '?'
    md5 = approved.get('md5') or '?'
    vermagic = approved.get('vermagic')
    try:
        module_ledger_append({'ev': 'install', 'nonce': nonce, 'ko': ko,
                              'md5': md5, 'dry_run': True,
                              'uid': os.getuid()})
    except (RuntimeError, OSError) as e:
        print('module install: 账本写入失败: %s' % e, file=sys.stderr)
        return 1
    # v0 恒 dry-run：真 insmod（vermagic 匹配内核）=尾池（设计册 §3/§6）
    print('MODULE_INSTALL_DRYRUN nonce=%s（已批准；只打印不执行）' % nonce)
    print('将执行（不执行）: insmod %s' % shlex.quote(ko))
    print('md5=%s vermagic=%s' % (
        md5, vermagic if vermagic else '(modinfo 缺席或无 vermagic)'))
    print('真 insmod=尾池（本命令 v0 不执行任何内核装载；--dry-run 旗标为'
          '接口稳定保留）')
    return 0


