def _mkdir_0700(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


def _write_0600_new(path, data):
    """O_EXCL 新建 0600（nonce 随机碰撞可忽略；存在=异常路径）。"""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(data)


def _write_0600(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, data.encode('utf-8') if isinstance(data, str) else data)
        os.fchmod(fd, 0o600)
    finally:
        os.close(fd)


def _module_ledger_prev(path):
    """账本末行 hash（行链 prev 咬合）；空/缺失='0'*16；损坏抛 RuntimeError
    （审计账本损坏=停写报告，不静默重开链）。"""
    try:
        with open(path, 'r', errors='replace') as f:
            lines = [ln for ln in f.read().splitlines() if ln.strip()]
    except FileNotFoundError:
        return '0' * 16
    except OSError as e:
        raise RuntimeError('账本读失败: %s' % e)
    if not lines:
        return '0' * 16
    try:
        prev = json.loads(lines[-1]).get('hash')
    except ValueError as e:
        raise RuntimeError('账本末行非 JSON: %s' % e)
    if not isinstance(prev, str) or not prev:
        raise RuntimeError('账本末行缺 hash')
    return prev


def module_ledger_append(ev):
    """追加一行事件（xxh64 行链：prev=前行 hash 咬合；hash=xxh64(本行
    canonical JSON 且 hash 字段清零, seed=CHAIN_SEED)——节点 self_hash
    同款口径+锚链 prev 咬合风格）。0600 追加式。"""
    path = os.path.join(module_dir(), 'ledger.jsonl')
    _mkdir_0700(module_dir())
    obj = dict(ev)
    obj['ts'] = int(time.time())
    obj['prev'] = _module_ledger_prev(path)
    obj['hash'] = ''
    obj['hash'] = '%016x' % xxh64(_canon(obj).encode('utf-8'), CHAIN_SEED)
    append_private(path, (_canon(obj) + '\n').encode('utf-8'))
    return obj


def module_ledger_verify(path):
    """账本行链校验：逐行重算 xxh64（hash 清零口径）+prev 咬合。
    → (code, [行])；0=OK / 1=IO / 2=行链断。"""
    try:
        with open(path, 'r', errors='replace') as f:
            lines = [ln for ln in f.read().splitlines() if ln.strip()]
    except OSError as e:
        return 1, ['账本读失败: %s' % e]
    if not lines:
        return 1, ['账本为空: %s' % path]
    prev = '0' * 16
    counts = {}
    for i, ln in enumerate(lines):
        try:
            obj = json.loads(ln)
            calc = '%016x' % xxh64(
                _canon(dict(obj, hash='')).encode('utf-8'), CHAIN_SEED)
        except (ValueError, TypeError):
            return 2, ['LEDGER_BREAK line=%d（非 JSON 行）' % i]
        if obj.get('prev') != prev or obj.get('hash') != calc:
            return 2, ['LEDGER_BREAK line=%d（prev/hash 行链断）' % i]
        prev = obj['hash']
        counts[obj.get('ev')] = counts.get(obj.get('ev'), 0) + 1
    return 0, ['LEDGER_OK lines=%d propose=%d approve=%d install=%d '
               'refused=%d' % (len(lines), counts.get('propose', 0),
                               counts.get('approve', 0),
                               counts.get('install', 0),
                               counts.get('refused', 0))]


def _module_fail_count(path, nonce):
    """账本中该 nonce 的短语失败累计（refused/phrase_mismatch 计数）。"""
    n = 0
    try:
        with open(path, 'r', errors='replace') as f:
            for ln in f:
                try:
                    obj = json.loads(ln)
                except ValueError:
                    continue
                if obj.get('ev') == 'refused' and obj.get('nonce') == nonce \
                        and obj.get('reason') == 'phrase_mismatch':
                    n += 1
    except OSError:
        pass
    return n


def _module_uid_name():
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_name
    except (ImportError, KeyError):
        return 'uid%d' % os.getuid()


def cmd_module_propose(args):
    ko = os.path.abspath(args.ko)
    if not os.path.isfile(ko):
        print('module propose: .ko 不存在: %s\n'
              '下一步：确认树外模块路径（须先在本机准备好 .ko 文件）。'
              % ko, file=sys.stderr)
        return 1
    md5 = _md5_file(ko)
    vermagic = None
    mi = shutil.which('modinfo')
    if mi:
        try:
            cp = subprocess.run([mi, '-F', 'vermagic', ko],
                                capture_output=True, timeout=15)
            if cp.returncode == 0:
                vermagic = cp.stdout.decode(
                    'utf-8', errors='replace').strip() or None
        except (OSError, subprocess.TimeoutExpired):
            vermagic = None
    nonce = secrets.token_hex(16)
    now = int(time.time())
    # pending JSON：ai_lease 确认协议契约字段（policy/ai_lease.c
    # ai_lease_confirm_pending_write 同款）+module 扩展字段（ko/md5/
    # vermagic/note/risk_lines；C 侧 /lease confirm 面可读基础字段）
    pending = {
        'nonce': nonce, 'tool': 'aikctl.module',
        'args_json': json.dumps({'ko': ko, 'note': args.note or ''},
                                ensure_ascii=False),
        'danger': 'D4', 'lease_id': None,
        'created_at': now, 'expires_at': now + MODULE_TTL,
        'uid': os.getuid(),
        'action': 'aikctl module propose --ko %s' % ko,
        'impact': '装载树外内核模块 %s（md5=%s）' % (ko, md5),
        'rollback': 'rmmod <模块名>（若未占用且允许卸载）',
        'question': 'CONFIRM D4 %s' % nonce,
        'ko': ko, 'md5': md5, 'vermagic': vermagic,
        'note': args.note or '', 'risk_lines': list(MODULE_RISK_LINES),
    }
    base = module_confirm_dir()
    try:
        # os.makedirs 的 mode 只作用于叶子——base 本体须先单独收紧 0700
        _mkdir_0700(base)
        for sub in ('pending', 'approved', 'consumed', 'denied'):
            _mkdir_0700(os.path.join(base, sub))
        ppath = os.path.join(base, 'pending', '%s.json' % nonce)
        _write_0600_new(ppath, _canon(pending) + '\n')
    except OSError as e:
        print('module propose: 建/写 pending 失败（真路径需 root；台架/独立'
              '部署用 AIKERNEL_CONFIRM_DIR 覆盖）: %s' % e, file=sys.stderr)
        return 1
    try:
        module_ledger_append({'ev': 'propose', 'nonce': nonce, 'ko': ko,
                              'md5': md5, 'vermagic': vermagic,
                              'uid': os.getuid()})
    except (RuntimeError, OSError) as e:
        print('module propose: 账本写入失败: %s' % e, file=sys.stderr)
        return 1
    print('MODULE_PROPOSE nonce=%s' % nonce)
    print('ko=%s' % ko)
    print('md5=%s vermagic=%s' % (
        md5, vermagic if vermagic else '(modinfo 缺席或无 vermagic)'))
    print('pending=%s' % ppath)
    for ln in MODULE_RISK_LINES:
        print(ln)
    print('确认短语（逐字节精确）: CONFIRM D4 %s' % nonce)
    print('下一步: aikctl module approve %s --phrase "CONFIRM D4 %s"'
          % (nonce, nonce))
    return 0


def cmd_module_list(_args):
    pdir = os.path.join(module_confirm_dir(), 'pending')
    try:
        names = sorted(e for e in os.listdir(pdir) if e.endswith('.json'))
    except OSError:
        names = []
    for nm in names:
        try:
            with open(os.path.join(pdir, nm), 'r', errors='replace') as f:
                obj = json.load(f)
            print('pending nonce=%s ko=%s md5=%s expires_at=%s note=%s'
                  % (obj.get('nonce'), obj.get('ko'), obj.get('md5'),
                     obj.get('expires_at'), obj.get('note') or ''))
        except (OSError, ValueError) as e:
            print('pending %s（读失败: %s）' % (nm, e))
    print('MODULE_LIST pending=%d' % len(names))
    return 0


def cmd_module_approve(args):
    nonce = args.nonce
    if not MODULE_NONCE_RE.match(nonce):
        print('module approve: 非法 nonce（32 hex）: %r' % nonce,
              file=sys.stderr)
        return 1
    base = module_confirm_dir()
    ppath = os.path.join(base, 'pending', '%s.json' % nonce)
    lpath = os.path.join(module_dir(), 'ledger.jsonl')

    def refuse(reason):
        fc = _module_fail_count(lpath, nonce)
        if reason == 'phrase_mismatch':
            fc += 1
        try:
            module_ledger_append({'ev': 'refused', 'nonce': nonce,
                                  'reason': reason, 'fail_count': fc,
                                  'uid': os.getuid()})
        except (RuntimeError, OSError):
            pass
        print('module approve: 拒绝（%s；fail_count=%d）。下一步：核对短语'
              '（逐字节精确）或重新 propose。' % (reason, fc), file=sys.stderr)
        return 1

    if not os.path.isfile(ppath):
        return refuse('unknown_or_consumed_nonce')
    try:
        with open(ppath, 'r', errors='replace') as f:
            pend = json.load(f)
    except (OSError, ValueError) as e:
        print('module approve: pending 读失败: %s' % e, file=sys.stderr)
        return 1
    if int(pend.get('expires_at') or 0) <= int(time.time()):
        return refuse('expired')
    # D4 短语逐字节精确比对（== 对 str 即逐字节；policy/ai_lease.c 同款）
    if args.phrase != 'CONFIRM D4 %s' % nonce:
        return refuse('phrase_mismatch')
    now = int(time.time())
    by = _module_uid_name()
    approved = {
        'nonce': nonce, 'tool': pend.get('tool'),
        'args_json': pend.get('args_json'), 'danger': 'D4',
        'lease_id': None, 'expires_at': pend.get('expires_at'),
        'approved_at': now, 'approved_by': by, 'approved': True,
        'ko': pend.get('ko'), 'md5': pend.get('md5'),
        'vermagic': pend.get('vermagic'),
    }
    apath = os.path.join(base, 'approved', '%s.json' % nonce)
    try:
        _mkdir_0700(os.path.join(base, 'approved'))
        _write_0600(apath, _canon(approved) + '\n')
        os.unlink(ppath)
    except OSError as e:
        print('module approve: 写 approved/删 pending 失败: %s' % e,
              file=sys.stderr)
        return 1
    try:
        module_ledger_append({'ev': 'approve', 'nonce': nonce,
                              'md5': pend.get('md5'), 'approved_by': by,
                              'uid': os.getuid()})
    except (RuntimeError, OSError) as e:
        print('module approve: 账本写入失败: %s' % e, file=sys.stderr)
        return 1
    print('MODULE_APPROVED nonce=%s approved_by=%s' % (nonce, by))
    print('下一步: aikctl module install %s（缺省 --dry-run，只打印不执行）'
          % nonce)
    return 0


def cmd_module_install(args):
    nonce = args.nonce
    if not MODULE_NONCE_RE.match(nonce):
        print('module install: 非法 nonce（32 hex）: %r' % nonce,
              file=sys.stderr)
        return 1
    base = module_confirm_dir()
    ppath = os.path.join(base, 'pending', '%s.json' % nonce)
    apath = os.path.join(base, 'approved', '%s.json' % nonce)
    lpath = os.path.join(module_dir(), 'ledger.jsonl')

    def refuse(reason):
        fc = _module_fail_count(lpath, nonce)
        try:
            module_ledger_append({'ev': 'refused', 'nonce': nonce,
                                  'reason': reason, 'fail_count': fc,
                                  'uid': os.getuid()})
        except (RuntimeError, OSError):
            pass
        print('module install: 拒绝（%s；L5 人工硬门：未批准 nonce 一律'
              '不装载）。下一步：先 approve（D4 短语逐字节精确）。'
              % reason, file=sys.stderr)
        return 1

    if os.path.isfile(ppath) and not os.path.isfile(apath):
        return refuse('not_approved_yet')      # 机判负例：未批准一律拒绝
    if not os.path.isfile(apath):
        return refuse('unknown_nonce')
    try:
        with open(apath, 'r', errors='replace') as f:
            approved = json.load(f)
    except (OSError, ValueError) as e:
        print('module install: approved 读失败: %s' % e, file=sys.stderr)
        return 1
    if not approved.get('approved'):
        return refuse('not_approved')
    if int(approved.get('expires_at') or 0) <= int(time.time()):
        return refuse('expired_approval')
    ko = approved.get('ko') or '?'
    md5 = approved.get('md5') or '?'
    vermagic = approved.get('vermagic')
    try:
        module_ledger_append({'ev': 'install', 'nonce': nonce, 'ko': ko,
                              'md5': md5, 'dry_run': True,
                              'uid': os.getuid()})
    except (RuntimeError, OSError) as e:
        print('module install: 账本写入失败: %s' % e, file=sys.stderr)
        return 1
    # v0 恒 dry-run：真 insmod（vermagic 匹配内核）=尾池（设计册 §3/§6）
    print('MODULE_INSTALL_DRYRUN nonce=%s（已批准；只打印不执行）' % nonce)
    print('将执行（不执行）: insmod %s' % shlex.quote(ko))
    print('md5=%s vermagic=%s' % (
        md5, vermagic if vermagic else '(modinfo 缺席或无 vermagic)'))
    print('真 insmod=尾池（本命令 v0 不执行任何内核装载；--dry-run 旗标为'
          '接口稳定保留）')
    return 0


def cmd_module_ledger(_args):
    code, out = module_ledger_verify(os.path.join(module_dir(),
