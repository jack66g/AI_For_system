def _find_pqdump():
    """P-27：C 版 parquet 读者 aik-pqdump 定位——env AIK_PQDUMP >
    PATH > 仓内 aistreamd 构建产物。缺席=回退 pyarrow（开发机）。"""
    env = os.environ.get('AIK_PQDUMP')
    if env:
        return env
    w = shutil.which('aik-pqdump')
