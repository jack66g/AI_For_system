    KIND_GENESIS: 'GENESIS',
    KIND_DECISION_NEW: 'DECISION_NEW',
    KIND_DECISION_OUTCOME: 'DECISION_OUTCOME',
    KIND_ROLLBACK: 'ROLLBACK',
