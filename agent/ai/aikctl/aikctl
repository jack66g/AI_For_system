# ---------------------------------------------------------------- XXH64 ----
# XXH64 官方算法 one-shot 纯 python 实现（小端；无第三方依赖）。
_P1 = 11400714785074694791
_P2 = 14029467366897019727
_P3 = 1609587929392839161
_P4 = 9650029242287828579
_P5 = 2870177450012600261


def _rotl(x, r):
    x &= M64
    return ((x << r) | (x >> (64 - r))) & M64


def xxh64(data, seed=0):
    """XXH64(data, seed) → int（官方 one-shot：stripe 循环 + 三段尾部）。"""
    n = len(data)
    i = 0
    if n >= 32:
        v1 = (seed + _P1 + _P2) & M64
        v2 = (seed + _P2) & M64
        v3 = seed & M64
        v4 = (seed - _P1) & M64
        while i + 32 <= n:
            k1 = struct.unpack_from('<Q', data, i)[0]
            k2 = struct.unpack_from('<Q', data, i + 8)[0]
            k3 = struct.unpack_from('<Q', data, i + 16)[0]
            k4 = struct.unpack_from('<Q', data, i + 24)[0]
            v1 = (_rotl((v1 + k1 * _P2) & M64, 31) * _P1) & M64
            v2 = (_rotl((v2 + k2 * _P2) & M64, 31) * _P1) & M64
            v3 = (_rotl((v3 + k3 * _P2) & M64, 31) * _P1) & M64
            v4 = (_rotl((v4 + k4 * _P2) & M64, 31) * _P1) & M64
            i += 32
        h = (_rotl(v1, 1) + _rotl(v2, 7) + _rotl(v3, 12) + _rotl(v4, 18)) & M64
        for v in (v1, v2, v3, v4):
            h ^= (_rotl(v * _P2 & M64, 31) * _P1) & M64
            h = (h * _P1 + _P4) & M64
    else:
        h = (seed + _P5) & M64
    h = (h + n) & M64
    while i + 8 <= n:
        k = (_rotl(struct.unpack_from('<Q', data, i)[0] * _P2 & M64, 31)
             * _P1) & M64
        h ^= k
        h = (_rotl(h, 27) * _P1 + _P4) & M64
        i += 8
    if i + 4 <= n:
        h ^= (struct.unpack_from('<I', data, i)[0] * _P1) & M64
        h = (_rotl(h, 23) * _P2 + _P3) & M64
        i += 4
    while i < n:
        h ^= (data[i] * _P5) & M64
        h = (_rotl(h, 11) * _P1) & M64
        i += 1
    h ^= h >> 33
    h = (h * _P2) & M64
    h ^= h >> 29
    h = (h * _P3) & M64
    h ^= h >> 32
    return h & M64


# ------------------------------------------------------------ 节点编解码 ----
def node_raw(seq, ts_ns, prev_hash, self_hash, pid, kind, flags, data32):
    return (struct.pack(NODE_FMT, seq, ts_ns, prev_hash, self_hash, pid,
                        kind, flags) + data32)


def node_hash(raw72):
    """self_hash = xxh64(整 72B 且 self_hash(偏移 24..32)清零, CHAIN_SEED)。"""
    return xxh64(raw72[:24] + b'\x00' * 8 + raw72[32:], CHAIN_SEED)


def decode_data(kind, data32):
    """kind 专属字段展开（DECISION_NEW/OUTCOME、AGENT_REJECT、ANCHOR、
    GENESIS）；其余 kind 返回 None（data 原样保留）。"""
    try:
        if kind == KIND_DECISION_NEW:
            # {u64 decision_id; u32 trigger_event_id; u8 decision_type;
            #  u8 domain; u8 source; 零垫}
            did, tev, dtype, dom, src = struct.unpack_from('<QIBBB', data32)
            return {'decision_id': did, 'trigger_event_id': tev,
                    'decision_type': dtype, 'domain': dom, 'source': src}
        if kind == KIND_DECISION_OUTCOME:
            # {u64 decision_id; u8 outcome; pad7; s64 metric_delta;
            #  u64 outcome_ts}
            did, outcome = struct.unpack_from('<QB', data32)
            mdelta, = struct.unpack_from('<q', data32, 16)
            ots, = struct.unpack_from('<Q', data32, 24)
            return {'decision_id': did, 'outcome': outcome,
                    'metric_delta': mdelta, 'outcome_ts': ots}
        if kind == KIND_AGENT_REJECT:
            # {u32 agent_id; u32 failures; u32 window_actions; u32 pad}
            aid, failures, window, _pad = struct.unpack('<IIII', data32)
            return {'agent_id': aid, 'failures': failures,
                    'window_actions': window}
        if kind == KIND_ANCHOR:
            # {u64 nodes_total; u64 window_first_seq; u32 epoch; u32 pad}
            total, first_seq, epoch, _pad = struct.unpack('<QQII', data32)
            return {'nodes_total': total, 'window_first_seq': first_seq,
                    'epoch': epoch}
        if kind == KIND_GENESIS:
            # {u64 boot_cookie}
            cookie, = struct.unpack_from('<Q', data32)
            return {'boot_cookie': cookie}
    except struct.error:
        return None
    return None


def node_to_json(seq, ts_ns, kind, pid, flags, prev, h, data32):
    d = {'seq': seq, 'ts_ns': ts_ns, 'kind': kind, 'pid': pid,
         'flags': flags, 'prev': '%016x' % prev, 'hash': '%016x' % h,
         'data': data32.hex()}
    if kind in KIND_NAMES:
        d['kind_name'] = KIND_NAMES[kind]
    dec = decode_data(kind, data32)
    if dec is not None:
        d['data_decoded'] = dec
    return d


def node_from_json(obj):
    """jsonl 节点行 → 72B 原始节点（self_hash 置 0，供 verify 重算）。"""
    return node_raw(int(obj['seq']), int(obj['ts_ns']),
                    int(obj['prev'], 16), 0, int(obj['pid']),
                    int(obj['kind']), int(obj['flags']),
                    bytes.fromhex(obj['data']))


# --------------------------------------------------------- /proc 读取 ----
PROC_HDR_RE = re.compile(
    r'^chain head=([0-9a-f]{16}) nodes=(\d+) evicted=(\d+) '
    r'anchors=(\d+) seeded=([0-9a-f]{16})')
PROC_NODE_RE = re.compile(
    r'^n seq=(\d+) ts=(\d+) k=(\d+) pid=(\d+) f=(\d+) '
    r'prev=([0-9a-f]{16}) h=([0-9a-f]{16}) d=([0-9a-f]{64})$')


def read_proc_audit(path=PROC_AUDIT):
    """→ (header dict, [node dict…])；格式不符抛 RuntimeError。"""
    with open(path, 'r', errors='replace') as f:
        lines = f.read().splitlines()
    hdr = None
    nodes = []
    for ln in lines:
        if not ln.strip():
            continue
        m = PROC_HDR_RE.match(ln)
        if m:
            hdr = {'head': int(m.group(1), 16), 'nodes': int(m.group(2)),
                   'evicted': int(m.group(3)), 'anchors': int(m.group(4)),
                   'seeded': int(m.group(5), 16)}
            continue
        m = PROC_NODE_RE.match(ln)
        if m:
            nodes.append({'seq': int(m.group(1)), 'ts_ns': int(m.group(2)),
                          'kind': int(m.group(3)), 'pid': int(m.group(4)),
                          'flags': int(m.group(5)),
                          'prev': int(m.group(6), 16),
                          'hash': int(m.group(7), 16),
                          'data': bytes.fromhex(m.group(8))})
            continue
        raise RuntimeError('%s: 无法解析行: %r' % (path, ln[:120]))
    if hdr is None:
        raise RuntimeError('%s: 缺首行 chain head=… 头行' % path)
    return hdr, nodes


def genesis_boot_cookie(nodes):
    """从 genesis 节点（kind==GENESIS，兜底 seq==1）data 解 boot_cookie。"""
    for nd in nodes:
        if nd.get('kind') == KIND_GENESIS or nd.get('seq') == 1:
            data = nd['data']
            if isinstance(data, str):
                data = bytes.fromhex(data)
            if len(data) >= 8:
                return struct.unpack_from('<Q', data)[0]
    return None


# ------------------------------------------------------------ jsonl I/O ----
def _canon(obj):
    return json.dumps(obj, sort_keys=True, separators=(',', ':'))


def write_private(path, data):
    """0600 覆盖写（父目录 mkdir -p）。"""
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)


def append_private(path, data):
    """0600 追加写（父目录 mkdir -p）。"""
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, data)
    finally:
        os.close(fd)


def load_export(path):
    """export jsonl → (meta, [node json dict…])。"""
    meta, nodes = None, []
    with open(path, 'r', errors='replace') as f:
        for ln in f:
            ln = ln.strip()
            if not ln:
                continue
            obj = json.loads(ln)
            if meta is None:
                if 'meta' not in obj:
                    raise RuntimeError('%s: 首行不是 meta 行' % path)
                meta = obj
            else:
                nodes.append(obj)
    if meta is None:
        raise RuntimeError('%s: 空文件（无 meta 行）' % path)
    return meta, nodes


# --------------------------------------------------------------- verify ----
def verify_chain(meta, nodes):
    """逐节点重算 + seq 连续性 + prev 链 + head 见证。

    → (code, [输出行])；code 0=OK / 2=TAMPER，首失配即返回。
    field 归因：prev=链断；gap=seq 断档或截尾；data=内容与 h 不符
    （下一节点 prev / meta head 见证 h 原值）；hash=h 字段被翻
    （见证==重算值）。
    """
    n = len(nodes)
    if n == 0:
        return 2, ['TAMPER index=0 seq=0 field=gap',
                   'gap: 文件无节点（meta node_count=%s）'
                   % meta.get('node_count')]
    meta_head = None
    if isinstance(meta.get('head'), str):
        meta_head = int(meta['head'], 16)
    for i, nd in enumerate(nodes):
        seq = int(nd['seq'])
        if i > 0:
            pseq = int(nodes[i - 1]['seq'])
            if seq != pseq + 1:
                return 2, [
                    'TAMPER index=%d seq=%d field=gap' % (i, seq),
                    'gap: seq %d..%d 缺失（%d→%d）'
                    % (pseq + 1, seq - 1, pseq, seq)]
            if int(nd['prev'], 16) != int(nodes[i - 1]['hash'], 16):
                return 2, ['TAMPER index=%d seq=%d field=prev' % (i, seq)]
        calc = node_hash(node_from_json(nd))
        stored = int(nd['hash'], 16)
        if calc != stored:
            witness = (int(nodes[i + 1]['prev'], 16) if i + 1 < n
                       else meta_head)
            if witness is not None and witness == calc:
                field = 'hash'      # h 字段被翻：邻居/头行见证重算值
            else:
                field = 'data'      # 内容被动过（或无一致见证，默认归 data）
            return 2, ['TAMPER index=%d seq=%d field=%s' % (i, seq, field)]
    mcount = meta.get('node_count')
    if isinstance(mcount, int) and mcount != n:
        last_seq = int(nodes[-1]['seq'])
        return 2, [
            'TAMPER index=%d seq=%d field=gap' % (n, last_seq + 1),
            'gap: meta node_count=%d 文件节点=%d（截尾）' % (mcount, n)]
    if meta_head is not None and meta_head != int(nodes[-1]['hash'], 16):
        return 2, ['TAMPER index=%d seq=%d field=hash'
                   % (n - 1, int(nodes[-1]['seq']))]
    return 0, ['OK nodes=%d head=%s' % (n, nodes[-1]['hash'])]


def verify_anchor_file(path):
    """锚文件行链：line[i].prev_line_sha256 == sha256(line[i-1] 原文)。

    首行 prev_line_sha256 == '0'*64。→ (code, [行])；0=OK / 1=IO / 3=断。
    """
    try:
        with open(path, 'r', errors='replace') as f:
            raw_lines = [ln for ln in f.read().splitlines() if ln.strip()]
    except OSError as e:
        return 1, ['anchor 文件读失败: %s' % e]
    if not raw_lines:
        return 1, ['anchor 文件为空: %s' % path]
    prev_digest = '0' * 64
    for i, ln in enumerate(raw_lines):
        try:
            obj = json.loads(ln)
        except ValueError:
            return 3, ['ANCHOR_CHAIN_BREAK line=%d（非 json 行）' % i]
        if not isinstance(obj, dict) or \
                obj.get('prev_line_sha256') != prev_digest:
            return 3, ['ANCHOR_CHAIN_BREAK line=%d（prev_line_sha256 '
                       '行链断）' % i]
        prev_digest = hashlib.sha256(ln.encode('utf-8')).hexdigest()
    try:
        tail = json.loads(raw_lines[-1]).get('head_hash', '?')
    except ValueError:
        tail = '?'
    return 0, ['ANCHOR_OK lines=%d tail_head=%s' % (len(raw_lines), tail)]


def cmd_verify(args):
