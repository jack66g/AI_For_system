    for r in rows:
        r['data'] = redact_line(r['data'] or '', args.redact)
        for c in ('pid', 'tgid'):
            r[c] = redact_pid_col(r[c], args.redact)
        dl = len((r['data'] or '').encode('utf-8'))
        r['data_len'] = dl if dl <= 32767 else 32767
    if args.layer == 'curated':
        if args.format == 'jsonl':
            data = _rows_jsonl_bytes(rows)
            with open(args.out, 'wb') as f:
                f.write(data)
        else:
            _write_parquet(rows, args.out)
        _write_card(args.out, rows, args, extra={'format': args.format})
        print('DATASET_EXPORT layer=curated format=%s redact=%s rows=%d '
              'out=%s' % (args.format, args.redact, len(rows), args.out))
        return 0
    # ---- corpus：同内容 jsonl → aik-gcm enc → .aikcorp + manifest ----
    gcm = _find_gcm_bin()
    if gcm is None:
        print('aikctl: 找不到 aik-gcm（AIK_GCM 未设、PATH 无、工树也无'
              '构建产物）——先在 agent/ai 下 make aik-gcm',
              file=sys.stderr)
        return 1
    key = args.key or os.environ.get('AIK_CORPUS_KEY') or DEFAULT_CORPUS_KEY
    if not os.path.isfile(key):
        print('aikctl: corpus 密钥 %s 不存在——先生成：aik-gcm keygen '
              '--key %s（或用 --key / env AIK_CORPUS_KEY 指路）'
              % (key, key), file=sys.stderr)
        return 1
    outpkg = args.out if args.out.endswith('.aikcorp') \
        else args.out + '.aikcorp'
    payload = _rows_jsonl_bytes(rows)
    try:
        proc = subprocess.run([gcm, 'enc', '--key', key],
                              input=payload, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE)
    except OSError as e:
        print('aikctl: 调 aik-gcm 失败：%s' % e, file=sys.stderr)
        return 1
    if proc.returncode != 0:
        print('aikctl: aik-gcm enc 失败（rc=%d）：%s'
              % (proc.returncode,
                 proc.stderr.decode('utf-8', 'replace').strip()),
              file=sys.stderr)
        return 1
    with open(outpkg, 'wb') as f:
        f.write(proc.stdout)
    manifest = {
        'version': 1,
        'format': 'jsonl+aik-gcm(AES-256-GCM)',
        'key_ref': CORPUS_KEY_REF,
        'rows': len(rows),
        'since': args.since,
        'until': args.until,
        'redaction': args.redact,
        'created': datetime.now(timezone.utc).isoformat(
            timespec='seconds'),
        'bytes': os.path.getsize(outpkg),
        'sha256': hashlib.sha256(proc.stdout).hexdigest(),
    }
    mpath = outpkg + '.manifest.json'
    with open(mpath, 'w', encoding='utf-8') as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2, sort_keys=True)
        f.write('\n')
    _write_card(outpkg if outpkg.endswith('.aikcorp')
                else outpkg + '.aikcorp', rows, args,
                extra={'format': 'aikcorp', 'manifest': mpath})
    print('DATASET_EXPORT layer=corpus redact=%s rows=%d out=%s '
          'manifest=%s sha256=%s'
          % (args.redact, len(rows), outpkg, mpath, manifest['sha256']))
    return 0


def _sme_export_memories(sme_url, timeout=5):
    req = urllib.request.Request(sme_url.rstrip('/') + '/export')
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode('utf-8')).get('memories', [])


def _sme_curated_ids(sme_url, since_d, until_d, timeout=5):
    """tags=curated:v1 且 metadata.ts（epoch ms，as_sme.h 契约）落窗的
    记忆 id 列表。SME 不可达/非 2xx → 抛异常由调用方拒绝删除。"""
    lo, hi = _day_bounds_ns(since_d, until_d)
    lo_ms, hi_ms = lo // 1000000, hi // 1000000
    ids = []
    for m in _sme_export_memories(sme_url, timeout):
        tags = m.get('tags') or []
        if 'curated:v1' not in tags:
            continue
        ts = (m.get('metadata') or {}).get('ts')
        if isinstance(ts, (int, float)) and lo_ms <= ts <= hi_ms:
            mid = m.get('id')
            if mid:
                ids.append(str(mid))
    return ids


def _sme_delete(sme_url, mid, timeout=5):
    url = sme_url.rstrip('/') + '/memories/' \
        + urllib.parse.quote(mid, safe='')
    req = urllib.request.Request(url, method='DELETE')
    with urllib.request.urlopen(req, timeout=timeout) as r:
        r.read()
    return True


# curated index schema（P-27e 写侧双后端；对齐 as_parquet.c idx_cols 面）
IDX_SCHEMA = (
    ('file', 'STRING'), ('date', 'STRING'), ('category', 'INT8'),
    ('records', 'INT64'), ('start_ts', 'INT64'), ('end_ts', 'INT64'),
)


def _rebuild_curated_index(root):
    """删除后从剩余 cat 文件重建 curated/index.parquet（行来源逐文件
    重读——索引陈旧即失效，重建为准；同 as_pq_sink index 重建精神；
    P-27e 落盘走 _pq_write 双后端）。"""
    base = _layer_dir(root, 'curated')
    rows = []
    for day in sorted(os.listdir(base)):
        ddir = os.path.join(base, day)
        if not (re.fullmatch(r'\d{4}-\d{2}-\d{2}', day)
                and os.path.isdir(ddir)):
            continue
        for path in _cat_files(ddir):
            cols = _pq_read(path)
            ts = cols.get('timestamp_ns') or []
            if not ts:
                continue
            rows.append({'file': os.path.basename(path), 'date': day,
                         'category': cols['category'][0],
                         'records': len(ts), 'start_ts': min(ts),
                         'end_ts': max(ts)})
    jsonl = ''.join(json.dumps(r, ensure_ascii=False) + '\n'
                    for r in rows).encode('utf-8')
    _pq_write(os.path.join(base, 'index.parquet'), jsonl, IDX_SCHEMA)


def cmd_dataset_delete(args):
    if args.layer == 'raw':
        print('aikctl: dataset delete 拒绝 raw 层——raw 由 aistreamd '
              'TTL/预算自治管理（7d TTL + 2GB 环形保留，设计 §2），手动'
              '删除会破坏保留环语义；要收缩 raw 请调 aistreamd.conf 的 '
              'PARQUET_MAX_GB / RETENTION_DAYS 配置。', file=sys.stderr)
        return 1
    # P-27e：读/重建均双后端（_pq_read/_pq_write）——pyarrow 不再是硬门
    since_d = _parse_date(args.since, '--since')
    until_d = _parse_date(args.until, '--until')
    if since_d > until_d:
        print('aikctl: --since %s 晚于 --until %s'
              % (args.since, args.until), file=sys.stderr)
        return 1
    days = _day_dirs(args.root, 'curated', since_d, until_d)
    targets = []
    rows_n = 0
    for day, ddir in days:
        for path in _cat_files(ddir):
            _c = _pq_read(path)
            rows_n += len(next(iter(_c.values()))) if _c else 0
            targets.append(path)
    sme_url = args.sme_url
    try:
        sme_ids = _sme_curated_ids(sme_url, since_d, until_d)
    except (urllib.error.URLError, urllib.error.HTTPError, OSError,
            ValueError) as e:
        print('aikctl: SME 不可达（%s）——按裁定拒绝删除（诚实优先：'
              'SME 侧 curated:v1 记忆无法对应清理就删文件=双侧漂移）。'
              '先恢复 SME（检查 SME_URL=%s / 服务状态）再删。'
              % (e, sme_url), file=sys.stderr)
        return 1
    arm_key = hashlib.sha256(
        ('%s|curated|%s|%s' % (os.path.abspath(args.root), args.since,
                               args.until)).encode()).hexdigest()[:16]
    arm_dir = os.environ.get('AIKCTL_ARM_DIR', '/tmp')
    arm_path = os.path.join(
        arm_dir, 'aikctl-ds-delete-%s.json' % arm_key)
    if not args.yes:
        # 第一发：只布防不删（occ.c:2929-2991 /delete 双发确认门精神）
        nonce = secrets.token_hex(8)
        try:
            with open(arm_path, 'w', encoding='utf-8') as f:
                json.dump({'nonce': nonce, 'ts': time.time(),
                           'layer': 'curated',
                           'root': os.path.abspath(args.root),
                           'since': args.since, 'until': args.until,
                           'files': targets, 'rows': rows_n,
                           'sme_ids': sme_ids}, f)
        except OSError as e:
            print('aikctl: 布防文件写入失败（%s）：%s'
                  % (arm_path, e), file=sys.stderr)
            return 1
        print('确认删除范围：layer=curated root=%s' % args.root)
        print('  日期窗：%s..%s（含端点）' % (args.since, args.until))
        print('  天目录 %d 个 / 数据文件 %d 个 / 行数 %d'
              % (len(days), len(targets), rows_n))
        for p in targets:
            print('    %s' % p)
        print('  SME 侧 curated:v1 匹配记忆 %d 条（将批量 DELETE）'
              % len(sme_ids))
        print('确认：10 秒内重发同一命令并加 --yes 将永久删除上述数据'
              '（不可恢复；nonce %s）' % nonce)
        return 1
    # 第二发（--yes）：核对布防
    if not os.path.isfile(arm_path):
        print('aikctl: 未布防——先发一次不带 --yes 的同一命令（双发确认'
              '门，occ /delete 精神）', file=sys.stderr)
        return 1
    try:
        with open(arm_path, 'r', encoding='utf-8') as f:
            arm = json.load(f)
    except (OSError, ValueError) as e:
        print('aikctl: 布防文件读失败（%s）：%s——重新布防'
              % (arm_path, e), file=sys.stderr)
        return 1
    if (arm.get('root') != os.path.abspath(args.root)
            or arm.get('since') != args.since
            or arm.get('until') != args.until
            or arm.get('layer') != 'curated'):
        print('aikctl: 布防参数与本次命令不符（root/since/until 任一变'
              '化即失效）——重发第一发布防', file=sys.stderr)
        return 1
    if time.time() - float(arm.get('ts', 0)) > 10.0:
        try:
            os.unlink(arm_path)
        except OSError:
            pass
        print('aikctl: 布防已过期（超过 10 秒）——重发第一发布防再确认',
              file=sys.stderr)
        return 1
    # SME 批量 DELETE（布防时枚举的 id——窗口内一致）
    sme_deleted = 0
    for mid in arm.get('sme_ids', []):
        try:
            _sme_delete(sme_url, str(mid))
            sme_deleted += 1
        except (urllib.error.URLError, urllib.error.HTTPError, OSError) \
                as e:
            print('aikctl: SME DELETE %s 失败（%s）——已删 %d/%d，本条跳'
                  '过；重跑本命令可补删（文件侧见下）'
                  % (mid, e, sme_deleted, len(arm.get('sme_ids', []))),
                  file=sys.stderr)
    # 文件删除：布局白名单（只删 cat_*.parquet；index 走重建）
    freed = 0
    removed = 0
    for path in arm.get('files', []):
        try:
            freed += os.path.getsize(path)
            os.remove(path)
            removed += 1
        except OSError as e:
            print('aikctl: 删除 %s 失败：%s' % (path, e), file=sys.stderr)
    for _day, ddir in days:
        try:
            os.rmdir(ddir)          # 仅当空时成功（同 purge 语义）
        except OSError:
            pass
    try:
        _rebuild_curated_index(args.root)
    except Exception as e:            # noqa: BLE001 —— 汇总报告不中断
        print('aikctl: curated index 重建失败（%s）——list 可能陈旧，'
              '重跑一次删除或手工触发重建' % e, file=sys.stderr)
    try:
        os.unlink(arm_path)
    except OSError:
        pass
    print('DATASET_DELETE layer=curated %s..%s files=%d rows=%d '
          'bytes_freed=%d sme_deleted=%d/%d'
          % (args.since, args.until, removed, arm.get('rows', rows_n),
             freed, sme_deleted, len(arm.get('sme_ids', []))))
    return 0


# ------------------------------------------------- aipd（AIPD-M2 §5） ----
# 金丝雀/A-B/签名表/自动回退 发布管线用户面（设计 ~/AIPD-M2-DESIGN.md §5；
# 风格对齐 compat/dataset 子族：argparse/人话错误面/诚实退出码/W2 --yes）。
AIPD_RELEASE_SCHEMA = 'aikernel.aipd/release/1'
AIPD_ROOT_DEFAULT = '/var/lib/aikernel/aipd'
AIPD_CONF_DEFAULT = '/etc/aikernel/aipd.conf'
AIPD_STATS_DEFAULT = '/run/aipd.stats'
AIPD_PROC_CONTROL = '/proc/ai/control'
# AIPTBL 布局（设计 §4，镜像 aip_table.c/aip_table.h 生成器合同）：
#   off 0 char[8] magic "AIPTBL\0\0" / off 8 u16 ver / off 10 u16 flags /
#   off 12 u32 nrules(1..64) / off 16 char[65] sha256_hex NUL 结尾 /
#   off 81 u8[47] 零填充 / off 128 起 nrules×128B 规则体（aip_table_
#   serialize 同字节序：feat u32/op u32/lo i64/hi i64/action u32/param
#   i32/reason[96] NUL 填充，全小端）。
AIPD_TABLE_MAGIC = b'AIPTBL\0\0'
AIPD_TABLE_VER = 1
AIPD_TABLE_RULES_MAX = 64
AIPD_TABLE_HDR_SZ = 128
AIPD_TABLE_RULE_SZ = 128
AIPD_REASON_MAX = 96
AIPD_FEAT_MAX = 7                       # enum aip_feat（AIP_F_VALID_BITS 后）
AIPD_ACT_MAX = 3                        # AIP_ACT_READAHEAD_BOOST（M2 冻结）
AIPD_TABLE_NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$')
# §3 动作白名单三旋钮（M2 冻结面；status 只读 current）
AIPD_KNOBS = ('mm.swappiness', 'sched.timeslice', 'mm.readahead')
AIPD_FEAT_NAMES = {0: 'SEQ', 1: 'TS', 2: 'LAT_EWMA_NS', 3: 'IOWAIT_PCT',
                   4: 'PSI_MEM_SOME', 5: 'CACHE_MISSES', 6: 'VALID_BITS'}
AIPD_OP_NAMES = {0: 'IN_RANGE', 1: 'GT'}
AIPD_ACT_NAMES = {0: 'NONE', 1: 'RECLAIM_AGGRESSIVE', 2: 'SCHED_COMPENSATE',
                  3: 'READAHEAD_BOOST'}
# conf 相关键（§6 Lane-A 追加面；本侧只读写不解释语义）
AIPD_CONF_CANARY_KEYS = ('CANARY_ENABLED', 'CANARY_TABLE',
                         'CANARY_ROLLBACK_MS', 'CANARY_CONFIRM_SEC',
                         'CANARY_MIN_INTERVAL_SEC')
# stats 里的 canary 观测键（§6 追加；status 摘要面）
AIPD_STATS_CANARY_KEYS = ('canary_reg_ok', 'canary_dispatched',
                          'canary_confirmed', 'canary_rolled_back',
                          'canary_errors', 'canary_skip_stale',
                          'canary_skip_busy', 'canary_skip_interval',
                          'canary_ab_total', 'canary_ab_mismatch',
                          'canary_table')


