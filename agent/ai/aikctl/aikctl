def build_export_jsonl(hdr, nodes):
    """→ jsonl bytes（meta 首行 + 节点行）；逐节点重算自检不符即抛。"""
    cookie = genesis_boot_cookie(nodes)
    meta = {'meta': True,
            'boot_cookie': ('%016x' % cookie if cookie is not None else None),
            'node_count': len(nodes), 'head': '%016x' % hdr['head']}
    lines = [_canon(meta)]
    for nd in sorted(nodes, key=lambda x: x['seq']):
        raw = node_raw(nd['seq'], nd['ts_ns'], nd['prev'], 0, nd['pid'],
                       nd['kind'], nd['flags'], nd['data'])
        calc = node_hash(raw)
        if calc != nd['hash']:
            raise RuntimeError('节点 seq=%d 自检失败: h=%016x 重算=%016x'
                               % (nd['seq'], nd['hash'], calc))
        lines.append(_canon(node_to_json(
            nd['seq'], nd['ts_ns'], nd['kind'], nd['pid'], nd['flags'],
            nd['prev'], nd['hash'], nd['data'])))
    if nodes and hdr['head'] != nodes[-1]['hash']:
        raise RuntimeError('头行 head=%016x 与末节点 h=%016x 不符'
                           % (hdr['head'], nodes[-1]['hash']))
    return ('\n'.join(lines) + '\n').encode('utf-8')


def cmd_export(args):
    try:
        hdr, nodes = read_proc_audit()
        blob = build_export_jsonl(hdr, nodes)
    except (OSError, RuntimeError) as e:
        print('export: %s' % e, file=sys.stderr)
        return 1
    out = args.o or os.path.join(
        AUDIT_DIR, 'chain-%s.jsonl'
        % datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ'))
    write_private(out, blob)
    print('EXPORT nodes=%d evicted=%d head=%016x -> %s'
          % (len(nodes), hdr['evicted'], hdr['head'], out))
    return 0


