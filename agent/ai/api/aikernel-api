def _aik_home():
    """与 shell 相同的 HOME；systemd 未设置时为 /root。"""
    return os.environ.get("HOME") or "/root"


def valid_session(session):
    return isinstance(session, str) and bool(SESSION_RE.match(session))


def new_session():
    return SESSION_PREFIX + secrets.token_hex(16)


def valid_nonce(nonce):
    return isinstance(nonce, str) and bool(NONCE_RE.match(nonce))


def session_lock(session):
    """同一 API 会话串行执行；不同会话并发。锁表有上限。"""
    with SESSION_LOCKS_GUARD:
        lk = SESSION_LOCKS.get(session)
        if lk is None:
            lk = threading.Lock()
            SESSION_LOCKS[session] = lk
        else:
            SESSION_LOCKS.move_to_end(session)
        if len(SESSION_LOCKS) > SESSION_LOCK_MAX:
            for old, oldlk in list(SESSION_LOCKS.items()):
                if old != session and not oldlk.locked():
                    SESSION_LOCKS.pop(old, None)
                    break
        return lk


def parse_tagged_event(stderr_text, tag):
    """只解析匹配本次 128-bit tag 的 stderr 行。

    返回 (event 或 None, error 或 None)。多行=协议错误（shell 只允许
    恰好一行）；其他 stderr 内容忽略。tag 由 API 生成，模型/工具输出
    无法预知（shell 在启动时已 unsetenv，工具子进程不可见）。
    """
    if not isinstance(tag, str) or not tag:
        return None, "missing_tag"
    prefix = "%s %s " % (EVENT_PREFIX, tag)
    hits = []
    for line in (stderr_text or "").splitlines():
        if not line.startswith(prefix):
            continue
        raw = line[len(prefix):].strip()
        try:
            obj = json.loads(raw)
        except ValueError:
            return None, "invalid_event_json"
        hits.append(obj)
    if not hits:
        return None, None
    if len(hits) > 1:
        return None, "multiple_events"
    return hits[0], None


def clarify_order(clarify):
    """显示顺序：推荐项置顶（与 TTY 菜单一致），其余保持模型顺序。"""
    opts = clarify.get("options") if isinstance(clarify, dict) else None
    if not isinstance(opts, list):
        return []
    order = list(range(len(opts)))
    rec = clarify.get("recommended")
    if isinstance(rec, str):
        for i, o in enumerate(opts):
            if isinstance(o, dict) and o.get("id") == rec:
                order.remove(i)
                order.insert(0, i)
                break
    return order


def validate_clarify_event(ev):
    """校验 shell 事件；返回错误字符串或 None（API 只接受规范事件）。"""
    if not isinstance(ev, dict):
        return "event 不是对象"
    if ev.get("status") != "CLARIFY_REQUIRED":
        return "event status 非法"
    if not valid_nonce(ev.get("nonce")):
        return "event nonce 非法"
    q = ev.get("question")
    if not isinstance(q, str) or not q.strip() or len(q) > 1024:
        return "event question 非法"
    opts = ev.get("options")
    if not isinstance(opts, list) or not (2 <= len(opts) <= CLARIFY_MAX_OPTIONS):
        return "event options 数量非法"
    ids = set()
    for o in opts:
        if not isinstance(o, dict):
            return "event option 非法"
        oid = o.get("id")
        label = o.get("label")
        if not isinstance(oid, str) or not oid or oid in ids:
            return "event option id 非法"
        if not isinstance(label, str) or not label:
            return "event option label 非法"
        ids.add(oid)
        for k in ("description", "why", "impact", "rollback", "danger"):
            v = o.get(k)
            if v is not None and not isinstance(v, str):
                return "event option %s 非法" % k
    rec = ev.get("recommended")
    if rec is not None and rec not in ids:
        return "event recommended 非法"
    default = ev.get("default")
    if default is not None and default not in ids:
        return "event default 非法"
    dangers = [ev.get("danger")]
    dangers.extend(o.get("danger") for o in opts)
    if default is not None and any(d in ("D3", "D4")
                                   for d in dangers if isinstance(d, str)):
        return "D3/D4 事件不得带 default"
    return None


def render_clarify_answer(ev, session):
    """把事件渲染成人类可读 answer；不把原始 JSON 塞给旧客户端。"""
    lines = []
    header = ev.get("header")
    if isinstance(header, str) and header.strip():
        lines.append("【%s】" % header.strip())
    else:
        lines.append("需要澄清：")
    lines.append(ev.get("question", ""))
    opts = ev.get("options") or []
    for n, idx in enumerate(clarify_order(ev), 1):
        o = opts[idx] if 0 <= idx < len(opts) else {}
        mark = "（推荐）" if o.get("id") == ev.get("recommended") else ""
        lines.append("%d. %s%s" % (n, o.get("label", ""), mark))
        desc = o.get("description")
        if isinstance(desc, str) and desc:
            lines.append("   " + desc)
    if ev.get("multi_select"):
        lines.append("可多选。")
    rec = ev.get("recommended")
    if isinstance(rec, str):
        for o in opts:
            if (isinstance(o, dict) and o.get("id") == rec and
                    isinstance(o.get("why"), str) and o["why"]):
                lines.append("推荐理由：%s" % o["why"])
                break
    lines.append('回复：POST /clarify {"nonce":"%s","session":"%s",'
                 '"selection":["<选项 id 或序号>"]}' %
                 (ev.get("nonce", ""), session))
    return "\n".join(lines)


def clarify_paths(nonce):
    base = os.path.join(_aik_home(), ".aikernel", "clarify")
    return (os.path.join(base, "pending", nonce + ".json"),
            os.path.join(base, "consumed", nonce + ".json"))


def read_pending(nonce):
    """只读探针：pending/consumed/expired/invalid/unknown。

    只用于 HTTP 状态码与 session 取锁；shell 的 C 端 pending_load/consume
    仍是权威（原子 rename、TTL、session、选项集校验）。
    """
    if not valid_nonce(nonce):
        return "invalid", None
    pending, consumed = clarify_paths(nonce)
    if not os.path.exists(pending):
        if os.path.exists(consumed):
            return "consumed", None
        return "unknown", None
    try:
        fd = os.open(pending, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) |
                     getattr(os, "O_CLOEXEC", 0))
    except OSError:
        return "unknown", None
    try:
        st = os.fstat(fd)
        if (not stat.S_ISREG(st.st_mode) or st.st_size <= 0 or
                st.st_size > 65536 or (st.st_mode & 0o077) != 0):
            return "invalid", None
        chunks = []
        remaining = st.st_size
        while remaining > 0:
            buf = os.read(fd, remaining)
            if not buf:
                break
            chunks.append(buf)
            remaining -= len(buf)
        raw = b"".join(chunks)
    finally:
        os.close(fd)
    try:
        doc = json.loads(raw.decode("utf-8", "replace"))
    except ValueError:
        return "invalid", None
    if (not isinstance(doc, dict) or doc.get("status") != "CLARIFY_PENDING" or
            doc.get("version") != 1 or doc.get("nonce") != nonce or
            not isinstance(doc.get("session"), str) or
            not isinstance(doc.get("expires_at_ms"), int) or
            not isinstance(doc.get("clarify"), dict)):
        return "invalid", None
    if doc["expires_at_ms"] <= int(time.time() * 1000):
        return "expired", doc
    return "pending", doc


def normalize_selection(doc, selection, other):
    """校验并归一化到选项 id（支持 id 或菜单序号）。

    返回 (tokens, other, error)。tokens 为按选择顺序去重的 id 列表；
    shell 的 ask_clarify_resolve_selection 再做一次权威校验。
    """
    clar = doc.get("clarify") if isinstance(doc, dict) else None
    opts = clar.get("options") if isinstance(clar, dict) else None
    if not isinstance(opts, list) or not opts:
        return None, None, "pending options 非法"
    ids = [o.get("id") for o in opts
           if isinstance(o, dict) and isinstance(o.get("id"), str)]
    if selection is None:
        selection = []
    if not isinstance(selection, list):
        return None, None, "selection 必须是数组"
    if other is not None and not isinstance(other, str):
        return None, None, "other 必须是字符串"
    other = (other or "").strip()
    if len(other) > CLARIFY_MAX_TEXT or "\n" in other or "\r" in other:
        return None, None, "other 非法（单行、≤%d 字符）" % CLARIFY_MAX_TEXT
    order = clarify_order(clar)
    chosen = []
    seen = set()
    for item in selection:
        if isinstance(item, bool) or not isinstance(item, (str, int)):
            return None, None, "selection 元素必须是字符串或整数"
        tok = str(item).strip()
        if not tok:
            continue
        if tok in ids:
            oid = tok
        elif tok.isdigit() and 1 <= int(tok) <= len(opts):
            idx = order[int(tok) - 1]
            oid = opts[idx].get("id")
        else:
            return None, None, "未知选项 %s" % tok
        if oid not in seen:
            seen.add(oid)
            chosen.append(oid)
    if not chosen and not other:
        return None, None, "需要 selection 或 other"
    if len(chosen) > 1 and not clar.get("multi_select"):
        return None, None, "单选澄清只能选择一个选项"
    return chosen, other, None


def clarify_state_error(state):
    """pending 探针状态 -> (HTTP code, error code, message)；pending 无错。"""
    if state == "unknown":
        return 404, "unknown_nonce", "未知或已过期的 clarify nonce"
    if state == "consumed":
        return 409, "already_consumed", "clarify 已被消费（重放被拒绝）"
    if state == "expired":
        return 410, "expired", "clarify 已过期，请重新发起 /ask"
    if state == "invalid":
        return 500, "invalid_pending", "clarify pending 记录非法"
    return None, None, None


def audit_line(tool, args, result):
    """沿用 REPL audit 通道行格式追加 /var/log/ai-audit.log。"""
    ts = time.strftime("%Y-%m-%dT%H:%M:%S+0000", time.gmtime())
    line = "%s uid=%d user=%s mode=api tool=%s args=%s result=%s\n" % (
        ts, os.getuid(), "root", tool,
        json.dumps(args, ensure_ascii=False), result)
    try:
        fd = os.open(AUDIT_LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        pass


