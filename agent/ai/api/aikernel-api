def parse_api_section(text):
    """从 model.toml 提取 [api] 段键值（最小 TOML：字符串/布尔/整数）。
    REPL C 解析器对未知段逐键跳过（config_manager.c flag 门控），
    故 [api] 段对 REPL 零影响。"""
    out = {}
    in_api = False
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            in_api = (line[1:-1].strip() == "api")
            continue
        if not in_api or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        val = val.strip()
        if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
            out[key] = val[1:-1]
        elif val == "true":
            out[key] = True
        elif val == "false":
            out[key] = False
        else:
            try:
                out[key] = int(val, 0)
            except ValueError:
                out[key] = val
    return out


def load_api_config():
    """读 [api] 段；文件缺失/无段 -> {}（全默认）。"""
    try:
        with open(TOML_FILE, "r", encoding="utf-8", errors="replace") as f:
            return parse_api_section(f.read())
    except OSError:
        return {}


def effective_token(cfg=None):
    """token 优先级：model.toml [api] token > /etc/aikernel/api-token。"""
    if cfg is None:
        cfg = load_api_config()
    tok = cfg.get("token")
    if isinstance(tok, str) and tok.strip():
        return tok.strip()
    try:
        with open(TOKEN_FILE, "r", encoding="utf-8") as f:
            t = f.read().strip()
        return t or None
    except OSError:
        return None


def parse_control(text):
    """解析 /proc/ai/control 文本 -> 参数表（含 task_scoped 推断）。"""
    params = []
    for line in text.splitlines():
        m = _CONTROL_RE.match(line.strip())
        if not m:
            continue
        params.append({
            "name": m.group(1),
            "domain": int(m.group(2)),
            "min": int(m.group(3)),
            "max": int(m.group(4)),
            "current": int(m.group(5)),
            "default": int(m.group(6)),
            "task_scoped": m.group(1) in TASK_PARAMS,
        })
    return params


def validate_act(pdef, value, pid):
    """校验 act 请求 -> (errcode, message)。errcode None=通过。
    范围限 27 参数；超范围 400；未知参数 404；task 参数缺 pid 400。"""
    if pdef is None:
        return 404, "unknown param（范围限 /proc/ai/control 27 参数，不开放 exec）"
    if not isinstance(value, int) or isinstance(value, bool):
        return 400, "value 必须是整数"
    if value < pdef["min"] or value > pdef["max"]:
        return 400, "value 超出 [%d, %d]" % (pdef["min"], pdef["max"])
    if pdef["task_scoped"]:
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return 400, "task 作用域参数需带正整数 pid（data[0]=pid）"
    return None, None


def nl_pack_act(domain, confidence, param, data0, data1=0):
    """打包 v2 ai_nl_act（112B）：param 定向 apply。
    TASK 参数 data0=pid/data1=值；全局参数 data0=值。"""
    pb = param.encode("utf-8")[:AI_NL_ACT_PARAM_LEN - 1]
    data = [0] * 8
    data[0] = data0
    data[1] = data1
    return struct.pack(AI_NL_ACT_FMT, 0, 0, domain, confidence, 0, 0,
                       *data, pb)


def nl_unpack_act_ack(payload):
    """解包 ai_nl_act_ack -> {"executed","hit","ai_err"}。"""
    if len(payload) < struct.calcsize(AI_NL_ACT_ACK_FMT):
        return None
    executed, hit, ai_err, _res = struct.unpack(AI_NL_ACT_ACK_FMT,
                                                payload[:struct.calcsize(
                                                    AI_NL_ACT_ACK_FMT)])
    return {"executed": executed, "hit": hit, "ai_err": ai_err}


def nl_act(param, value, pid, timeout=5.0):
    """发 AI_CMD_ACT v2 定向 apply，返回 (ack_dict 或 None, errmsg 或 None)。
    需 CAP_SYS_ADMIN（API 以 root 运行）。"""
    pdef = None
    for p in read_control_params():
        if p["name"] == param:
            pdef = p
            break
    if pdef is None:
        return None, "param vanished from control table"
    if pdef["task_scoped"]:
        payload = nl_pack_act(pdef["domain"], 90, param, pid, value)
    else:
        payload = nl_pack_act(pdef["domain"], 90, param, value, 0)

    try:
        sock = socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_AI)
    except OSError as e:
        return None, "netlink socket: %s" % e
    try:
        sock.bind((0, 0))
        portid = sock.getsockname()[0]
        seq = int(time.time()) & 0x7fffffff
        hdr = struct.pack("=IHHII", 16 + len(payload), AI_CMD_ACT,
                          NLM_F_REQUEST, seq, portid)
        sock.settimeout(timeout)
        sock.sendto(hdr + payload, (0, 0))
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                resp, src = sock.recvfrom(65536)
            except socket.timeout:
                return None, "netlink reply timeout"
            if len(resp) < 16 or src[0] != 0:
                continue
            rlen, rtype, _rflags, rseq, _rpid = struct.unpack("=IHHII",
                                                              resp[:16])
            if rseq != seq:
                continue
            body = resp[16:16 + max(rlen - 16, 0)]
            if rtype == AI_CMD_ACT:
                return nl_unpack_act_ack(body), None
            if rtype == NLMSG_ERROR:
                if len(body) >= 4:
                    err = struct.unpack("<i", body[:4])[0]
                    if err == 0:
                        return None, "netlink ack(0) 未携带 act 应答"
                    import errno as _errno
                    return None, "kernel errno %d (%s)" % (
                        -err, _errno.errorcode.get(-err, "?"))
                return None, "malformed netlink error"
        return None, "netlink reply timeout"
    except OSError as e:
        return None, "netlink io: %s" % e
    finally:
        sock.close()


def read_control_params():
    try:
        with open(CONTROL_PROC, "r", encoding="utf-8", errors="replace") as f:
            return parse_control(f.read())
    except OSError:
        return []


def truncate_sample(content, cap, tail=False):
    """只读快照截断：telemetry 取尾部（最新），其余取头部。
    返回 (content, truncated, total_bytes)。"""
    total = len(content)
    if total <= cap:
        return content, False, total
    kept = content[-cap:] if tail else content[:cap]
    return kept, True, total


def route_get(path, query):
    """GET 路由 -> (endpoint, kwargs)；未知 -> (None, {})。"""
    if path == "/health":
        return "health", {}
    if path == "/tools":
        return "tools", {"channel": query.get("channel", [None])[0],
                         "risk": query.get("risk", [None])[0]}
    if path == "/params":
        return "params", {"name": query.get("name", [None])[0]}
    if path == "/sense":
        return "sense", {"what": query.get("what", [None])[0],
                         "limit": query.get("limit", [None])[0]}
    return None, {}


def tools_summary(doc, channel=None, risk=None):
    """tools.json -> 端点输出（描述截断摘要 + 可选过滤）。"""
    tools = []
    for t in doc.get("tools", []):
        if channel and t.get("channel") != channel:
            continue
        if risk and t.get("risk") != risk:
            continue
        desc = t.get("description", "")
        tools.append({
            "name": t.get("name"),
            "channel": t.get("channel"),
            "risk": t.get("risk"),
            "description": desc[:TOOLS_DESC_MAX],
        })
    return {"version": doc.get("version"), "tool_count":
            doc.get("tool_count", len(doc.get("tools", []))),
            "count": len(tools), "tools": tools}


def err_body(err, message, **extra):
    """结构化错误体：{"error","message",...}。"""
    body = {"error": err, "message": message}
    body.update(extra)
    return body


