def ai_env():
    """aikernel-shell 按 $HOME 找模型配置(~/.aikernel)、按
    AIKERNEL_TOOLS_JSON 或 CWD 找 tools.json —— systemd 环境无 HOME
    且 CWD=/ 时会 rc=1(No models configured / 无法读取 tools.json)，
    故强制注入。

    W77c-2b：API 从不继承预授权/确认 nonce；每次请求的事件 tag 与
    澄清回答也由调用方显式注入，避免跨请求泄漏。"""
    env = dict(os.environ)
    env.setdefault("HOME", "/root")
    env.setdefault("TERM", "xterm")
    env.setdefault("AIKERNEL_TOOLS_JSON", TOOLS_JSON)
    for k in ("AIKERNEL_ASSUME_YES", "AIKERNEL_CONFIRM_NONCE",
              "AIKERNEL_EVENT_TAG", "AIKERNEL_PROMPT",
              "AIKERNEL_CLARIFY_SELECT", "AIKERNEL_CLARIFY_OTHER"):
        env.pop(k, None)
    return env


class Handler(BaseHTTPRequestHandler):
    server_version = "AIKernelAPI/3.0"
    protocol_version = "HTTP/1.1"

    def _json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _err(self, http_code, err, message, **extra):
        # 形参名避开 code/param 等业务键：extra 可携带 "code": "NEED_CONFIRM"
        self._json(http_code, err_body(err, message, **extra))

    def _auth_error(self):
        """无 Authorization -> 401；token 不对 -> 403。均审计。"""
        hdr = self.headers.get("Authorization", "")
        if not hdr.startswith("Bearer ") or not hdr[7:].strip():
            audit_line("api_auth", {"path": self.path,
                                    "op": self.command}, "DENY_NO_TOKEN")
            self._err(401, "unauthorized",
                      "缺少 Bearer token（GET /health 探活除外亦需鉴权）")
            return False
        tok = effective_token()
        if not tok or not hmac.compare_digest(hdr[7:].strip(), tok):
            audit_line("api_auth", {"path": self.path,
                                    "op": self.command}, "DENY_BAD_TOKEN")
            self._err(403, "forbidden", "Bearer token 不正确或已轮换失效")
            return False
        return True

    def _read_json(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > 1 << 20:
                return None, "request body too large"
            raw = self.rfile.read(n).decode("utf-8") if n else "{}"
            return json.loads(raw), None
        except (ValueError, UnicodeDecodeError):
            return None, "invalid json"

    # ---- GET ----
    def do_GET(self):
        url = urlparse(self.path)
        ep, kw = route_get(url.path, parse_qs(url.query))
        if ep is None:
            known = {"/ask": "POST", "/act": "POST", "/clarify": "POST"}
            if url.path in known:
                return self._err(405, "method_not_allowed",
                                 "%s 只支持 %s" % (url.path, known[url.path]))
            return self._err(404, "not found",
                             "未知端点（可用：/health /tools /params /sense "
                             "/ask /clarify /act）")
        if not self._auth_error():
            return

        if ep == "health":
            return self._do_health()
        if ep == "tools":
            return self._do_tools(**kw)
        if ep == "params":
            return self._do_params(**kw)
        if ep == "sense":
            return self._do_sense(**kw)

    def _do_health(self):
        services = {}
        for svc in HEALTH_SERVICES:
            try:
                r = subprocess.run(
                    ["systemctl", "is-active", svc + ".service"],
                    capture_output=True, text=True, timeout=10)
                services[svc] = (r.stdout or "").strip() or "unknown"
            except Exception as e:
                services[svc] = "error: %s" % e
        audit_line("api_health", {}, "OK")
        return self._json(200, {
            "status": "ok", "services": services,
            "api_version": API_VERSION,
            "endpoints": ["/health", "/tools", "/params", "/sense",
                          "/ask", "/clarify", "/act"],
        })

    def _do_tools(self, channel=None, risk=None):
        try:
            with open(TOOLS_JSON, "r", encoding="utf-8") as f:
                doc = json.load(f)
        except (OSError, ValueError) as e:
            return self._err(500, "tools_json_unreadable", str(e))
        out = tools_summary(doc, channel=channel, risk=risk)
        audit_line("api_tools", {"channel": channel, "risk": risk,
                                 "count": out["count"]}, "OK")
        return self._json(200, out)

    def _do_params(self, name=None):
        params = read_control_params()
        if not params:
            return self._err(500, "control_unreadable",
                             "无法读取 /proc/ai/control")
        if name:
            for p in params:
                if p["name"] == name:
                    audit_line("api_params", {"name": name}, "OK")
                    return self._json(200, p)
            return self._err(404, "unknown_param",
                             "未知参数 %s（27 参数见 GET /params）" % name)
        audit_line("api_params", {"count": len(params)}, "OK")
        return self._json(200, {"count": len(params), "params": params})

    def _do_sense(self, what=None, limit=None):
        if not what or what not in SENSE_WHAT:
            return self._err(404, "unknown_what",
                             "what 取值：%s" % ", ".join(sorted(SENSE_WHAT)))
        cap = SENSE_DEFAULT_LIMIT
        if limit is not None:
            try:
                cap = int(limit)
            except ValueError:
                return self._err(400, "invalid_limit", "limit 须为整数")
            if cap < 1 or cap > SENSE_MAX_LIMIT:
                return self._err(400, "invalid_limit",
                                 "limit 取值 1..%d" % SENSE_MAX_LIMIT)
        try:
            with open(SENSE_WHAT[what], "r",
                      encoding="utf-8", errors="replace") as f:
                content = f.read()
        except OSError as e:
            return self._err(500, "sense_unreadable", str(e))
        kept, truncated, total = truncate_sample(content, cap,
                                                 tail=(what == "telemetry"))
        audit_line("api_sense", {"what": what, "limit": cap,
                                 "truncated": truncated}, "OK")
        return self._json(200, {"what": what, "node": SENSE_WHAT[what],
                                "truncated": truncated,
                                "total_bytes": total,
                                "content": kept})

    # ---- POST ----
    def do_POST(self):
        if self.path == "/ask":
            return self._do_ask()
        if self.path == "/clarify":
            return self._do_clarify()
        if self.path == "/act":
            return self._do_act()
        known = {"/health": "GET", "/tools": "GET", "/params": "GET",
                 "/sense": "GET"}
        if self.path in known:
            return self._err(405, "method_not_allowed",
                             "%s 只支持 %s" % (self.path, known[self.path]))
        return self._err(404, "not found",
                         "未知端点（可用：/health /tools /params /sense "
                         "/ask /clarify /act）")

    def _run_ai(self, argv, extra_env, timeout):
        """stdin=DEVNULL：防止 API 进程在 TTY 中被 clarify/lease 阻塞。"""
        env = ai_env()
        env.update(extra_env)
        return subprocess.run(
            argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
            timeout=timeout, env=env)

    def _do_ask(self):
        if not self._auth_error():
            return
        req, err = self._read_json()
        if err:
            return self._err(400, "invalid json", err)
        req = req or {}
        q = req.get("question")
        if not isinstance(q, str) or not q.strip():
            return self._err(400, "question required", "question 不能为空")
        # env 传递上限：避免 execve E2BIG；NUL 无法进入环境变量
        if len(q) > 65536 or "\x00" in q:
            return self._err(400, "invalid_question",
                             "question 过长（>64KiB）或含 NUL")
        session = req.get("session") or new_session()
        if not valid_session(session):
            return self._err(400, "invalid_session",
                             "session 必须以 api- 开头且只含 "
                             "[A-Za-z0-9._-]（≤100）")
        tag = secrets.token_hex(16)
        lk = session_lock(session)
        if not lk.acquire(timeout=ASK_TIMEOUT + 30):
            return self._err(503, "session_busy",
                             "同一 session 有请求在处理，请稍后重试")
        try:
            try:
                # 问题经 AIKERNEL_PROMPT 传入，不进入 argv；stdin=DEVNULL
                r = self._run_ai(
                    [AI_BIN, "-p", "-", "-s", session],
                    {"AIKERNEL_EVENT_TAG": tag, "AIKERNEL_PROMPT": q},
                    ASK_TIMEOUT)
            except subprocess.TimeoutExpired:
                return self._err(504, "ai timeout",
                                 "ai 超时（上限 %ds）" % ASK_TIMEOUT)
            except FileNotFoundError:
                return self._err(502, "ai binary missing",
                                 "%s 不存在" % AI_BIN)
            stdout = r.stdout or ""
            if r.returncode != 0:
                return self._err(502, "ai failed",
                                 "ai rc=%d" % r.returncode,
                                 detail=(r.stderr or "")[-400:])
            ev, eerr = parse_tagged_event(r.stderr or "", tag)
            if eerr:
                return self._err(502, "clarify_protocol_error", eerr)
            if ev is not None:
                verr = validate_clarify_event(ev)
                if verr:
                    return self._err(502, "clarify_protocol_error", verr)
                st, doc = read_pending(ev["nonce"])
                if st != "pending" or (doc or {}).get("session") != session:
                    return self._err(502, "clarify_state_mismatch",
                                     "事件 nonce 与 pending/session 不一致")
                answer = render_clarify_answer(ev, session)
                clar = dict(ev)
                clar["session"] = session
                audit_line("api_ask_clarify",
                           {"len": len(q), "nonce": ev["nonce"][:12],
                            "n_options": len(ev.get("options") or []),
                            "danger": ev.get("danger", "")},
                           "CLARIFY_REQUIRED")
                return self._json(200, {
                    "status": "clarify_required",
                    "session": session,
                    "answer": answer,
                    "clarify": clar,
                })
            # 旧 shell/事件丢失时 fail closed：绝不把裸 JSON 当最终答案
            if "CLARIFY_REQUIRED" in stdout:
                return self._err(502, "clarify_event_missing",
                                 "shell 未发出 tagged 事件（协议错误）")
            audit_line("api_ask", {"len": len(q)}, "OK")
            return self._json(200, {"status": "ok", "session": session,
                                    "answer": stdout.strip()})
        finally:
            lk.release()

    def _do_clarify(self):
        if not self._auth_error():
            return
        req, err = self._read_json()
        if err:
            return self._err(400, "invalid json", err)
        req = req or {}
        nonce = req.get("nonce")
        session = req.get("session")
        if not valid_nonce(nonce):
            return self._err(400, "invalid_nonce",
                             "nonce 必须以 cq- 开头且只含 [A-Za-z0-9._-]")
        if not valid_session(session):
            return self._err(400, "invalid_session",
                             "session 必须是 /ask 返回的 api-... 会话")
        state, doc = read_pending(nonce)
        code, ecode, emsg = clarify_state_error(state)
        if code:
            audit_line("api_clarify", {"nonce": nonce[:12],
                                       "session": session[:24]}, ecode)
            return self._err(code, ecode, emsg)
        if doc.get("session") != session:
            return self._err(409, "session_mismatch",
                             "session 与 pending 记录不一致")
        tokens, other, nerr = normalize_selection(
            doc, req.get("selection", []), req.get("other"))
        if nerr:
            return self._err(400, "invalid_selection", nerr)
        lk = session_lock(session)
        if not lk.acquire(timeout=ASK_TIMEOUT + 30):
            return self._err(503, "session_busy",
                             "同一 session 有请求在处理，请稍后重试")
        try:
            # 取锁后重查：防止与并发 /clarify、过期或消费竞态
            state, doc = read_pending(nonce)
            code, ecode, emsg = clarify_state_error(state)
            if code:
                return self._err(code, ecode, emsg)
            if doc.get("session") != session:
                return self._err(409, "session_mismatch",
                                 "session 与 pending 记录不一致")
            tag = secrets.token_hex(16)
            extra = {"AIKERNEL_EVENT_TAG": tag}
            if tokens:
                extra["AIKERNEL_CLARIFY_SELECT"] = ",".join(tokens)
            if other:
                extra["AIKERNEL_CLARIFY_OTHER"] = other
            try:
                # 回答经环境变量传入，不进入 argv；stdin=DEVNULL
                r = self._run_ai(
                    [AI_BIN, "--clarify-answer", nonce, "-s", session],
                    extra, ASK_TIMEOUT)
            except subprocess.TimeoutExpired:
                return self._err(504, "ai timeout",
                                 "ai 超时（上限 %ds）" % ASK_TIMEOUT)
            except FileNotFoundError:
                return self._err(502, "ai binary missing",
                                 "%s 不存在" % AI_BIN)
            stdout = r.stdout or ""
            if r.returncode != 0:
                state2, _ = read_pending(nonce)
                if state2 == "consumed":
                    return self._err(409, "already_consumed",
                                     "clarify 已被消费（重放被拒绝）")
                return self._err(502, "ai failed",
                                 "ai rc=%d" % r.returncode,
                                 detail=(r.stderr or "")[-400:])
            ev, eerr = parse_tagged_event(r.stderr or "", tag)
            if eerr:
                return self._err(502, "clarify_protocol_error", eerr)
            if ev is not None:
                verr = validate_clarify_event(ev)
                if verr:
                    return self._err(502, "clarify_protocol_error", verr)
                st2, doc2 = read_pending(ev["nonce"])
                if st2 != "pending" or (doc2 or {}).get("session") != session:
                    return self._err(502, "clarify_state_mismatch",
                                     "事件 nonce 与 pending/session 不一致")
                answer = render_clarify_answer(ev, session)
                clar = dict(ev)
                clar["session"] = session
                audit_line("api_clarify",
                           {"nonce": nonce[:12], "n_selection": len(tokens),
                            "danger": (doc.get("clarify") or {}).get(
                                "danger", "")},
                           "CLARIFY_REQUIRED")
                return self._json(200, {
                    "status": "clarify_required",
                    "session": session,
                    "answer": answer,
                    "clarify": clar,
                })
            if "CLARIFY_REQUIRED" in stdout:
                return self._err(502, "clarify_event_missing",
                                 "shell 未发出 tagged 事件（协议错误）")
            audit_line("api_clarify",
                       {"nonce": nonce[:12], "n_selection": len(tokens),
                        "danger": (doc.get("clarify") or {}).get(
                            "danger", "")}, "OK")
            return self._json(200, {"status": "ok", "session": session,
                                    "answer": stdout.strip()})
        finally:
            lk.release()

    def _do_act(self):
        if not self._auth_error():
            return
        req, err = self._read_json()
        if err:
            return self._err(400, "invalid json", err)
        req = req or {}
        param = req.get("param")
        value = req.get("value")
        pid = req.get("pid")
        confirm = req.get("confirm") is True

        if not isinstance(param, str) or not param.strip():
            return self._err(400, "param required",
                             'body 需 {"param": "...", "value": N}')
        param = param.strip()
        if isinstance(value, str):
            try:
                value = int(value, 0)
            except ValueError:
                value = None
        if isinstance(pid, str):
            try:
                pid = int(pid)
            except ValueError:
                pid = None

        params = read_control_params()
        pdef = None
        for p in params:
            if p["name"] == param:
                pdef = p
                break
        code, msg = validate_act(pdef, value, pid)
        if code == 404:
            return self._err(404, "unknown_param", msg,
                             allowed="GET /params")
        if code == 400:
            extra = {}
            if pdef is not None:
                extra = {"min": pdef["min"], "max": pdef["max"]}
            return self._err(400, "invalid_value", msg, **extra)

        if not confirm:
            audit_line("api_act", {"param": param, "value": value,
                                   "pid": pid, "confirm": False},
                       "NEED_CONFIRM")
            return self._err(409, "need_confirm",
                             "受控写需显式确认：重发并带 \"confirm\": true",
                             code="NEED_CONFIRM", param=param, value=value,
                             pid=pid, current=pdef["current"],
                             min=pdef["min"], max=pdef["max"],
                             default=pdef["default"],
                             task_scoped=pdef["task_scoped"])

        ack, nerr = nl_act(param, value, pid)
        if ack is None:
            audit_line("api_act", {"param": param, "value": value,
                                   "pid": pid, "confirm": True},
                       "ERR: %s" % nerr)
            return self._err(502, "kernel_rejected", nerr)
        if ack["ai_err"] != 0:
            audit_line("api_act", {"param": param, "value": value,
                                   "pid": pid, "confirm": True},
                       "ERR: ai_err=%d" % ack["ai_err"])
            return self._err(502, "kernel_rejected",
                             "内核 ai_err=%d（策略未执行）" % ack["ai_err"],
                             executed=ack["executed"], hit=ack["hit"])
        if ack["executed"] == 0:
            audit_line("api_act", {"param": param, "value": value,
                                   "pid": pid, "confirm": True},
                       "NOT_APPLIED")
            return self._err(409, "not_applied",
                             "策略未命中（0 条执行）：参数未注册或被安全策略过滤",
                             executed=0, hit=0)
        after = pdef["current"]
        for p in read_control_params():
            if p["name"] == param:
                after = p["current"]
                break
        audit_line("api_act", {"param": param, "value": value, "pid": pid,
                               "confirm": True, "current_after": after}, "OK")
        return self._json(200, {"ok": True, "param": param, "value": value,
                                "pid": pid, "executed": ack["executed"],
                                "hit": ack["hit"], "current_before":
                                    pdef["current"], "current_after": after})

    def log_message(self, fmt, *args):
        print("[aikernel-api] %s %s" % (self.address_string(), fmt % args),
              flush=True)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    cfg = load_api_config()
    bind = cfg.get("bind") if isinstance(cfg.get("bind"), str) else BIND_HOST
    port = cfg.get("port") if isinstance(cfg.get("port"), int) else BIND_PORT
    tls = cfg.get("tls") is True
    cert = cfg.get("cert") if isinstance(cfg.get("cert"), str) else ""
    key = cfg.get("key") if isinstance(cfg.get("key"), str) else ""

    loopback = bind in ("127.0.0.1", "localhost", "::1")
    if not loopback:
        warn = ("api 绑定非回环地址 %s —— 对外暴露必须配 TLS+token，"
                "并确认防火墙（nft 默认 drop 仅放行 22）" % bind)
        print("[aikernel-api] WARN: %s" % warn, flush=True)
        audit_line("api_bind", {"bind": bind, "tls": tls},
                   "WARN_NON_LOOPBACK")

    if tls:
        if not cert or not key or not (os.path.exists(cert) and
                                       os.path.exists(key)):
            print("[aikernel-api] FATAL: tls=true 但证书/私钥缺失"
                  "（model.toml [api] cert/key），拒绝以半配置启动",
                  flush=True)
            sys.exit(1)
        import ssl
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(cert, key)

    srv = Server((bind, port), Handler)
    if tls:
        srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
    print("[aikernel-api] v%d listening on %s:%d (%s, Bearer token: "
          "model.toml [api] token > %s)"
          % (API_VERSION, bind, port,
             "TLS" if tls else "明文（本机/SSH 隧道场景）", TOKEN_FILE),
          flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
