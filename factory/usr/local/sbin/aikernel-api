#!/usr/bin/python3
# ============================================================
# AIKernel 远程 AI API 守护 (aikernel-api)
# 「AI 即系统」——把本机 AI(ollama + aikernel-shell) 以 HTTP
# 接口暴露给本机进程 / SSH 隧道 / 未来桌面 UI 后端。
# Talos 式远程管理面第一步。
#
#   POST /ask    {"question": "..."} -> {"answer": "..."}
#                内部执行 /usr/local/bin/ai -p "<question>"
#                超时上限 300s
#   GET  /health {"status": "ok", "services": {...}}
#
#   鉴权: Bearer token, 文件 /etc/aikernel/api-token (600,
#         安装时随机生成 32 hex); 无/错 token -> 401
#   绑定: 默认 127.0.0.1:8761(仅本机/SSH 隧道); 对外暴露须
#         管理员显式改 bind(自担风险) —— 与防火墙基线一致
#         (外网默认 drop)
# ============================================================
import json
import os
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BIND_HOST = "127.0.0.1"
BIND_PORT = 8761
TOKEN_FILE = "/etc/aikernel/api-token"
AI_BIN = "/usr/local/bin/ai"
ASK_TIMEOUT = 300
HEALTH_SERVICES = ["ollama", "aikernel-memory", "ssh"]


def ai_env():
    """aikernel-shell 按 $HOME 找模型配置(~/.aikernel)、按
    AIKERNEL_TOOLS_JSON 或 CWD 找 tools.json —— systemd 环境无 HOME
    且 CWD=/ 时会 rc=1(No models configured / 无法读取 tools.json)，
    故强制注入。"""
    env = dict(os.environ)
    env.setdefault("HOME", "/root")
    env.setdefault("TERM", "xterm")
    env.setdefault("AIKERNEL_TOOLS_JSON", "/usr/local/share/aikernel/tools.json")
    return env


def load_token():
    """每次请求现读 token 文件: 管理员轮换 token 即时生效, 无需重启。"""
    try:
        with open(TOKEN_FILE, "r", encoding="utf-8") as f:
            t = f.read().strip()
        return t or None
    except OSError:
        return None


class Handler(BaseHTTPRequestHandler):
    server_version = "AIKernelAPI/1.0"
    protocol_version = "HTTP/1.1"

    def _json(self, code, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _authed(self):
        tok = load_token()
        if not tok:
            return False
        return self.headers.get("Authorization", "") == "Bearer " + tok

    def do_GET(self):
        if self.path == "/health":
            if not self._authed():
                return self._json(401, {"error": "unauthorized"})
            services = {}
            for svc in HEALTH_SERVICES:
                try:
                    r = subprocess.run(
                        ["systemctl", "is-active", svc + ".service"],
                        capture_output=True, text=True, timeout=10)
                    services[svc] = (r.stdout or "").strip() or "unknown"
                except Exception as e:
                    services[svc] = "error: %s" % e
            return self._json(200, {"status": "ok", "services": services})
        return self._json(404, {"error": "not found"})

    def do_POST(self):
        if self.path != "/ask":
            return self._json(404, {"error": "not found"})
        if not self._authed():
            return self._json(401, {"error": "unauthorized"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            req = json.loads(self.rfile.read(n).decode("utf-8") if n else "{}")
        except (ValueError, UnicodeDecodeError):
            return self._json(400, {"error": "invalid json"})
        q = req.get("question")
        if not isinstance(q, str) or not q.strip():
            return self._json(400, {"error": "question required"})
        try:
            r = subprocess.run(
                [AI_BIN, "-p", q],
                capture_output=True, text=True, timeout=ASK_TIMEOUT,
                env=ai_env())
        except subprocess.TimeoutExpired:
            return self._json(504, {"error": "ai timeout (%ds)" % ASK_TIMEOUT})
        except FileNotFoundError:
            return self._json(502, {"error": "ai binary missing"})
        if r.returncode != 0:
            return self._json(502, {
                "error": "ai failed rc=%d" % r.returncode,
                "detail": (r.stderr or "")[-400:],
            })
        return self._json(200, {"answer": (r.stdout or "").strip()})

    def log_message(self, fmt, *args):
        print("[aikernel-api] %s %s" % (self.address_string(), fmt % args),
              flush=True)


if __name__ == "__main__":
    srv = ThreadingHTTPServer((BIND_HOST, BIND_PORT), Handler)
    srv.daemon_threads = True
    print("[aikernel-api] listening on %s:%d (Bearer auth: %s)"
          % (BIND_HOST, BIND_PORT, TOKEN_FILE), flush=True)
    srv.serve_forever()