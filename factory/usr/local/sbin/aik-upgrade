#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# aik-upgrade - AIKernel A/B 升级通道（W28/C 波）
#
# 设计（zero-brick by construction）：
#   - grub 默认项永远是"稳定槽"：稳定项由 grubenv 变量 stable_entry 指向
#     （菜单项 --id），未设置时落回菜单第一项（set default=0 的静态兜底）。
#   - 试运行用 one-shot：grubenv next_entry=aik-try 只对下一次引导生效，
#     GRUB 引导 try 项时消费并清空 next_entry（save_env）；之后任何一次
#     重启都自然落回稳定项，无需人工干预。
#   - 试运行槽文件固定为 /boot/vmlinuz-aikernel-next；try 菜单项 cmdline
#     带 ai.tryboot=1 标记，userspace 读 /proc/cmdline 即可判定"本次引导
#     是 try 引导"，零 GRUB 写依赖。
#   - commit 转正 = 只写 grubenv stable_entry=<id> + 槽状态登记，内核文件
#     永不移动；旧稳定项天然降为回退项（它仍在菜单里，只是不再被
#     stable_entry 指向）。保持回退生命线 ≤3 个版本由 status 提示人工清理。
#   - 为什么自写 grubenv 读写器而不是 apt 安装 grub2-common：本机为
#     自包含 OS，避免引入外部包依赖；grubenv 格式稳定（1024 字节、
#     "# GRUB Environment Block" 签名、name=value 行、'#' 填充），纯
#     bash/dd/sed 可严格实现；且写坏 grubenv 的失败模式是安全的
#     （GRUB load_env 失败 → 打印错误 → default 落静态 0 = 稳定项）。
#   - 槽状态机持久化 /boot/aik-slot-state（kv）；每次 install/boot/
#     commit/rollback 追加审计行到 /var/log/aik-upgrade.log。
#
# 用法：
#   aik-upgrade status
#   aik-upgrade install kernel <bzImage路径> <版本号，如 38>
#   aik-upgrade install shell <二进制路径>
#       （T9e 起安装目标 = occ；主入口 /usr/local/bin/occ，旧 ai 残留自动清理）
#   aik-upgrade boot [--yes]          # one-shot 指向 try 项并重启
#   aik-upgrade commit [--force]      # 健康检查通过后转正（要求 try 引导中）
#   aik-upgrade auto-commit           # 开机提交器内部用（含等待/回退判定）
#   aik-upgrade rollback [原因]       # 手工回退（清 try，稳定项本就未动）
#   aik-upgrade healthcheck           # /proc/ai 九项 + 四服务 active
#   aik-upgrade export <tar路径> [--no-sme]
#   aik-upgrade import <tar路径> [--no-sme]
#   aik-upgrade grubenv get|set|del|dump [args]
#   aik-upgrade install userland <pkg.tar.gz>   # W-7 用户态散件安装通道
#       （包由 build/w7_userland_pkg.sh 产出：manifest.tsv + files/ 树；
#         逐件 sha256 fail-closed，备份/原子替换/失败自动回滚；
#         AIK_UPGRADE_ROOT 环境变量可作全路径沙箱前缀，缺省 /）
#   aik-upgrade userland-rollback               # 恢复最近一次 userland 备份
#
# 红线：本脚本不改 grub.cfg（W28 一次性改造除外，已备份 .bak-w28）；
#       nft/sshd/主控 SSH 通道不动；root:root 0755。
# 旗标语义（C2 波拆分，U3 实测驱动）：--yes 仅跳过交互确认（REPL 确认后
#       传入）；--force 才放行防呆门（可疑小镜像）与 commit 的 tryboot 豁免。
#       二者绝不共用一个变量，否则 REPL 确认路径会旁路防呆门。
set -euo pipefail

GRUBENV=/boot/grub/grubenv
SLOT_STATE=/boot/aik-slot-state
AUDIT_LOG=/var/log/aik-upgrade.log
# W-7：用户态通道根前缀（缺省 /，不改变任何既有行为；台架沙箱传入如
# /tmp/w7-sbx 后，userland 全部路径操作与审计日志都落在前缀下）。
AIK_UPGRADE_ROOT="${AIK_UPGRADE_ROOT:-/}"
if [ "$AIK_UPGRADE_ROOT" != "/" ]; then
    AUDIT_LOG="${AIK_UPGRADE_ROOT%/}/var/log/aik-upgrade.log"
fi
TRY_KERNEL=/boot/vmlinuz-aikernel-next
# T9e 口径（LT-BUG-007）：出厂主入口 = /usr/local/bin/occ；aikernel-shell
# 与 /usr/local/bin/ai 已随出厂移除。保留 SHELL_* 变量名以兼容既有子命令/
# 日志/审计字段，值统一指向 occ。
SHELL_BIN=/usr/local/bin/occ
SHELL_REAL=/usr/local/bin/occ
SHELL_BAK_DIR=/root/w28-backup
TRY_MENU_ID=aik-try
TRYBOOT_MARK=ai.tryboot=1
GRUB_CFG=/boot/grub/grub.cfg

log() {
    printf '[aik-upgrade] %s\n' "$*" >&2
}

audit() {
    # audit <action> <detail...>
    local action="$1"; shift
    mkdir -p "$(dirname "$AUDIT_LOG")" 2>/dev/null || true
    printf '%s action=%s rc=%s %s\n' "$(date '+%F %T')" "$action" "${AUDIT_RC:-0}" "$*" >> "$AUDIT_LOG" 2>/dev/null || true
    logger -t aik-upgrade "$action: $*" 2>/dev/null || true
}

die() {
    log "ERROR: $*"
    audit "error" "msg=\"$*\""
    exit 1
}

# ---------------------------------------------------------------------------
# grubenv 读写（1024 字节固定格式：签名 "# GRUB Environment Block\n" 恰
# 25 字节 + name=value 行 + '#' 填充；条目区从第 26 字节开始）
# ---------------------------------------------------------------------------
grubenv_get() {
    local key="$1" line
    [ -f "$GRUBENV" ] || return 1
    while IFS= read -r line; do
        case "$line" in
            '#'*)	return 1 ;;
            "$key="*)	printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < <(tail -c +26 "$GRUBENV" 2>/dev/null | tr -d '\0')
    return 1
}

grubenv_entries_except() {
    local skip="$1" line
    while IFS= read -r line; do
        case "$line" in
            '#'*)	break ;;
            "$skip="*)	;;
            *=*)	[ -n "$line" ] && printf '%s\n' "$line" ;;
        esac
    done < <(tail -c +26 "$GRUBENV" 2>/dev/null | tr -d '\0')
}

grubenv_write() {
    # grubenv_write <entries-from-stdin>：重建 1024 字节环境块（保 inode 原地覆写）
    local tmp body used
    tmp="$(mktemp /boot/grub/grubenv.w28.XXXXXX)"
    body="$(cat)"
    {
        printf '# GRUB Environment Block\n'
        if [ -n "$body" ]; then
            printf '%s\n' "$body"
        fi
    } > "$tmp"
    used="$(stat -c%s "$tmp")"
    if [ "$used" -gt 1024 ]; then
        rm -f "$tmp"
        die "grubenv entries exceed 1024 bytes (size=$used)"
    fi
    # 尾部 '#' 填充补足 1024（追加而非覆盖）
    head -c $((1024 - used)) /dev/zero | tr '\0' '#' >> "$tmp"
    cat "$tmp" > "$GRUBENV"
    rm -f "$tmp"
    [ "$(stat -c%s "$GRUBENV")" = "1024" ] || die "grubenv size corrupted"
}

grubenv_set() {
    local key="$1" val="$2"
    [ -n "$key" ] || die "grubenv_set: empty key"
    # 值域收紧到安全字符（md5/菜单 id/数字均满足），避免破坏 grubenv 解析
    case "$val" in
        *[!a-zA-Z0-9._:-]*)	die "grubenv_set: invalid value '$val'" ;;
    esac
    case "$key" in
        ''|*[!a-zA-Z0-9._-]*)	die "grubenv_set: invalid key '$key'" ;;
    esac
    {
        grubenv_entries_except "$key"
        printf '%s=%s' "$key" "$val"
    } | grubenv_write
}

grubenv_del() {
    local key="$1"
    grubenv_entries_except "$key" | grubenv_write
}

cmd_grubenv() {
    local op="${1:-}"; shift || true
    case "$op" in
        get)	grubenv_get "$1" ;;
        set)	grubenv_set "$1" "$2"; log "grubenv: set $1=$2" ;;
        del)	grubenv_del "$1"; log "grubenv: del $1" ;;
        dump)	tail -c +26 "$GRUBENV" | tr -d '\0' | sed -n '/^#/q;p' ;;
        *)		die "grubenv: usage: get|set|del|dump" ;;
    esac
}

# ---------------------------------------------------------------------------
# 槽状态（kv）
# ---------------------------------------------------------------------------
slot_get() {
    local key="$1" line
    [ -f "$SLOT_STATE" ] || return 1
    while IFS= read -r line; do
        case "$line" in
            '#'*)	;;
            "$key="*)	printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < "$SLOT_STATE"
    return 1
}

slot_set() {
    # slot_set key=value...（增量更新，不存在的 key 追加）
    local kv k v key line found tmp
    tmp="$(mktemp /boot/aik-slot-state.new.XXXXXX)"
    touch "$SLOT_STATE"
    cp "$SLOT_STATE" "$tmp"
    for kv in "$@"; do
        k="${kv%%=*}"; v="${kv#*=}"
        found=0
        while IFS= read -r line; do
            if [ "${line%%=*}" = "$k" ]; then
                printf '%s=%s\n' "$k" "$v"
                found=1
            else
                printf '%s\n' "$line"
            fi
        done < "$tmp" > "${tmp}.out"
        [ "$found" = 1 ] || printf '%s=%s\n' "$k" "$v" >> "${tmp}.out"
        mv "${tmp}.out" "$tmp"
    done
    cat "$tmp" > "$SLOT_STATE"
    rm -f "$tmp"
}

# ---------------------------------------------------------------------------
# 健康检查（/proc/ai 九项 + 四服务）
# ---------------------------------------------------------------------------
cmd_healthcheck() {
    local fail=0 f s n
    for f in chains control decisions hitrate latency sched status telemetry vfs; do
        if [ -r "/proc/ai/$f" ]; then
            log "[ok]   /proc/ai/$f"
        else
            log "[fail] /proc/ai/$f missing"
            fail=1
        fi
    done
    for s in ollama aikernel-memory ssh aikernel-api; do
        if [ "$(systemctl is-active "$s.service" 2>/dev/null || true)" = "active" ]; then
            log "[ok]   $s active"
        else
            log "[fail] $s not active"
            fail=1
        fi
    done
    return "$fail"
}

# 服务宽限等待（TCG 冷启动慢，auto-commit 用）
wait_health() {
    local tries="${1:-6}" n=1
    while [ "$n" -le "$tries" ]; do
        if cmd_healthcheck >/dev/null 2>&1; then
            return 0
        fi
        log "health not ready yet ($n/$tries), wait 5s"
        sleep 5
        n=$((n + 1))
    done
    cmd_healthcheck
}

# ---------------------------------------------------------------------------
# install kernel
# ---------------------------------------------------------------------------
cmd_install_kernel() {
    local src="${1:-}" label="${2:-}" force="${FORCE:-0}"
    [ -n "$src" ] && [ -n "$label" ] || die "usage: aik-upgrade install kernel <bzImage> <版本号如 38>"
    [ -f "$src" ] || die "no such file: $src"

    local src_md5 size stable_md5
    src_md5="$(md5sum "$src" | awk '{print $1}')"
    size="$(stat -c%s "$src")"

    # 防呆：远小于现役稳定内核的镜像八成是坏包（破坏演练用 --force 放行）
    local stable_file
    stable_file="$(ls /boot/vmlinuz-aikernel-* 2>/dev/null | grep -v next | head -1 || true)"
    if [ -n "$stable_file" ]; then
        stable_md5=""
        local stable_size
        stable_size="$(stat -c%s "$stable_file")"
        if [ "$size" -lt $((stable_size / 2)) ]; then
            if [ "$force" = "1" ]; then
                log "WARN: ${src} (${size}B) is much smaller than ${stable_file} (${stable_size}B) — forced by --force"
            else
                die "refusing suspicious kernel image ${src} (${size}B << stable ${stable_size}B); pass --force to override"
            fi
        fi
    fi

    # 校验 label 可登记：grub.cfg 必须存在对应菜单 id（aik-<label>）
    grep -q "aik-${label}" "$GRUB_CFG" || die "no menu id aik-${label} in grub.cfg; label must match an existing versioned menu entry"

    local tmp="/boot/.vmlinuz-aikernel-next.tmp.$$"
    install -m 644 "$src" "$tmp"
    local dst_md5
    dst_md5="$(md5sum "$tmp" | awk '{print $1}')"
    [ "$dst_md5" = "$src_md5" ] || { rm -f "$tmp"; die "md5 mismatch after copy ($src_md5 -> $dst_md5)"; }
    mv -f "$tmp" "$TRY_KERNEL"

    slot_set slot=trying try_label="$label" try_md5="$dst_md5" \
             try_size="$size" try_ts="$(date +%s)" result=boot_requested
    audit "install-kernel" "label=$label md5=$dst_md5 size=$size src=$src"
    log "installed try kernel: $TRY_KERNEL (label=$label md5=$dst_md5)"
    log "next: aik-upgrade boot --yes  (one-shot -> try slot)"
}

# ---------------------------------------------------------------------------
# install shell（二进制热更收编进统一通道）
# ---------------------------------------------------------------------------
cmd_install_shell() {
    local src="${1:-}"
    [ -n "$src" ] || die "usage: aik-upgrade install shell <binary>"
    [ -f "$src" ] || die "no such file: $src"

    local src_md5 cur_md5
    src_md5="$(md5sum "$src" | awk '{print $1}')"
    # occ 缺失（首装/旧镜像）时 cur_md5 为空：`|| true` 兜住 set -e + pipefail
    cur_md5="$(md5sum "$SHELL_REAL" 2>/dev/null | awk '{print $1}' || true)"
    if [ "$src_md5" = "$cur_md5" ]; then
        # LT-BUG-007：/usr/local/bin/ai 是 aikernel-shell 时代次入口，已退役。
        # 旧镜像若残留实体/软链则清理；缺失是正常态，不得报错。
        if [ -e /usr/local/bin/ai ] || [ -L /usr/local/bin/ai ]; then
            rm -f /usr/local/bin/ai
            log "retired legacy entry /usr/local/bin/ai (occ is the entry)"
            audit "install-shell" "note=legacy-entry-removed path=/usr/local/bin/ai"
        fi
        log "shell binary identical to current ($src_md5), nothing to do"
        return 0
    fi

    mkdir -p "$SHELL_BAK_DIR"
    local bak="$SHELL_BAK_DIR/occ.${cur_md5:0:8}.bak"
    if [ -e "$SHELL_REAL" ]; then
        cp -p "$SHELL_REAL" "$bak"
        log "backed up current occ -> $bak (md5=$cur_md5)"
    else
        bak="(none)"
        log "no current occ at $SHELL_REAL (first install, no backup)"
    fi

    local tmp="$SHELL_REAL.tmp.$$"
    install -m 755 "$src" "$tmp"
    local dst_md5
    dst_md5="$(md5sum "$tmp" | awk '{print $1}')"
    [ "$dst_md5" = "$src_md5" ] || { rm -f "$tmp"; die "md5 mismatch after copy"; }
    mv -f "$tmp" "$SHELL_REAL"

    # LT-BUG-007：occ 是唯一主入口，不再维护双入口；旧 /usr/local/bin/ai
    # 残留（实体或软链）一律清理，缺失不报错。
    if [ -e /usr/local/bin/ai ] || [ -L /usr/local/bin/ai ]; then
        rm -f /usr/local/bin/ai
        log "retired legacy entry /usr/local/bin/ai (occ is the entry)"
        audit "install-shell" "note=legacy-entry-removed path=/usr/local/bin/ai"
    fi

    slot_set last_shell_md5="$dst_md5" last_shell_ts="$(date +%s)"
    audit "install-shell" "md5=$dst_md5 prev=$cur_md5 backup=$bak"
    log "installed occ entry: $SHELL_REAL (md5=$dst_md5)"
    log "note: running TUI keeps old code; new occ sessions pick up the new binary"
}

# ---------------------------------------------------------------------------
# boot（one-shot 指向 try 并重启）
# ---------------------------------------------------------------------------
cmd_boot() {
    [ "$(slot_get slot || true)" = "trying" ] || die "slot is not 'trying' — run install kernel first"
    [ -f "$TRY_KERNEL" ] || die "missing $TRY_KERNEL"
    # 早期死亡断电风险提示（R5 事故驱动，C2 波补；--yes 也打印。
    # 语义见 docs/upgrade-recovery.md §3.1：try 内核若触发断电级故障，
    # 内核态无法自救，"回退"依赖有人/有机制把机器再开起来。）
    log "RISK-NOTE: try 内核若触发早期死亡/断电级故障（R5 形态），重启闭环失效，无人开机将瘫痪"
    log "RISK-NOTE: 断电兜底 — VMware 宿主机: vmrun start <vmx路径> .gui|nogui ; 实体机: 看门狗复位（D 波交付）"
    if [ "${FORCE_YES:-0}" != "1" ] && [ -t 0 ]; then
        local ans
        printf 'Set one-shot boot to try slot (label=%s) and REBOOT? [y/N] ' "$(slot_get try_label || true)"
        read -r ans || ans=""
        case "$ans" in y|Y) ;; *) log "cancelled"; return 0 ;; esac
    fi
    grubenv_set next_entry "$TRY_MENU_ID"
    [ "$(grubenv_get next_entry || true)" = "$TRY_MENU_ID" ] || die "grubenv next_entry verification failed"
    slot_set result=boot_requested boot_ts="$(date +%s)"
    audit "boot" "next_entry=$TRY_MENU_ID try_label=$(slot_get try_label || true)"
    log "one-shot armed: next boot -> $TRY_MENU_ID (stable default untouched)"
    log "rebooting in 3s..."
    sleep 3
    systemctl reboot
}

# ---------------------------------------------------------------------------
# commit（转正）
# ---------------------------------------------------------------------------
cmd_commit() {
    local force="${FORCE:-0}"
    [ "$(slot_get slot || true)" = "trying" ] || die "slot is not 'trying' — nothing to commit"
    if [ "$force" != "1" ]; then
        grep -q "$TRYBOOT_MARK" /proc/cmdline || die "current boot is not the try slot (no $TRYBOOT_MARK in /proc/cmdline); use commit --force to override"
    fi

    local label prev stable_file tmp want got bak try_md5
    label="$(slot_get try_label || true)"
    prev="$(slot_get stable_id || echo "aik-0")"
    grep -q "aik-${label}" "$GRUB_CFG" || die "menu id aik-${label} not in grub.cfg — cannot promote"

    log "health check before commit:"
    if ! cmd_healthcheck; then
        slot_set slot=rollback-failed result=health-failed
        audit "commit-failed" "label=$label reason=health-failed"
        die "health check FAILED — try slot NOT promoted; next reboot falls back to stable"
    fi

    # W64 FIX: promote the *tested* try image into the versioned slot before
    # pointing stable_entry at it. The old flow only rewrote grubenv, so the
    # stable menu entry kept booting the pre-try file (silent downgrade on
    # the next reboot, while status claimed "committed").
    try_md5="$(slot_get try_md5 || true)"
    want="$(md5sum "$TRY_KERNEL" | awk '{print $1}')"
    if [ -n "$try_md5" ] && [ "$want" != "$try_md5" ]; then
        die "try kernel md5 changed since install ($want != $try_md5) — refusing to promote"
    fi
    stable_file="/boot/vmlinuz-aikernel-${label}"
    if [ -f "$stable_file" ]; then
        bak="${stable_file}.bak-$(date +%s)"
        cp -p "$stable_file" "$bak" || die "cannot back up $stable_file"
        log "old stable image backed up: $bak"
    fi
    tmp="/boot/.vmlinuz-aikernel-${label}.tmp.$$"
    install -m 644 "$TRY_KERNEL" "$tmp" || die "cannot stage $stable_file"
    got="$(md5sum "$tmp" | awk '{print $1}')"
    if [ "$want" != "$got" ]; then
        rm -f "$tmp"
        die "md5 mismatch promoting try kernel ($want -> $got)"
    fi
    sync
    mv -f "$tmp" "$stable_file" || die "cannot replace $stable_file"
    log "promoted tested try image -> $stable_file (md5=$got)"

    grubenv_set stable_entry "aik-${label}"
    [ "$(grubenv_get stable_entry || true)" = "aik-${label}" ] || die "stable_entry verification failed"
    slot_set slot=stable stable_id="aik-${label}" stable_label="#${label}" previous_id="$prev" stable_md5="$got" result=committed \
             committed_ts="$(date +%s)"
    audit "commit" "label=$label stable_entry=aik-${label} previous=$prev"
    log "promoted: stable_entry=aik-${label} (previous stable $prev demoted to fallback)"
}

# ---------------------------------------------------------------------------
# auto-commit（aikernel-upgrade-commit.service 入口）
# ---------------------------------------------------------------------------
cmd_auto_commit() {
    # 残留清理：GRUB 侧 save_env 失败时 next_entry 可能残留，userspace 兜底清除
    if [ "$(grubenv_get next_entry || true)" != "" ]; then
        grubenv_del next_entry
        audit "cleanup" "cleared leftover next_entry"
    fi

    local slot
    slot="$(slot_get slot || echo stable)"
    [ "$slot" = "trying" ] || { log "slot=$slot, nothing to do"; return 0; }

    if grep -q "$TRYBOOT_MARK" /proc/cmdline; then
        log "try boot detected ($TRYBOOT_MARK), running health gate (wait up to 120s)"
        if wait_health 12; then
            FORCE_YES=1 cmd_commit
        else
            slot_set slot=rollback-failed result=health-failed
            audit "auto-rollback" "reason=health-failed try_label=$(slot_get try_label || true)"
            log "health gate FAILED after try boot — recorded rollback-failed"
            log "next reboot falls back to stable slot (stable_entry untouched)"
        fi
    else
        slot_set slot=rollback-failed result=try-not-booted
        audit "auto-rollback" "reason=try-not-booted try_label=$(slot_get try_label || true)"
        log "current boot is the stable slot while slot=trying — try kernel failed to boot"
        log "recorded rollback-failed; stable slot confirmed"
    fi
}

# ---------------------------------------------------------------------------
# rollback（手工）
# ---------------------------------------------------------------------------
cmd_rollback() {
    local reason="${1:-manual}"
    grubenv_del next_entry
    local slot
    slot="$(slot_get slot || true)"
    if [ "$slot" = "trying" ]; then
        slot_set slot=rollback result="manual:$reason"
        audit "rollback" "reason=$reason try_label=$(slot_get try_label || true)"
        log "rolled back try slot (stable default was never touched); next reboot -> stable"
    else
        audit "rollback" "reason=$reason note=no-try-slot(slot=$slot)"
        log "no try slot active (slot=$slot), stable default untouched"
    fi
    [ -f "$TRY_KERNEL" ] && log "note: $TRY_KERNEL kept for inspection"
    return 0
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
cmd_status() {
    echo "=== AIKernel A/B slot state ($SLOT_STATE) ==="
    [ -f "$SLOT_STATE" ] && cat "$SLOT_STATE" || echo "(no state file)"
    echo
    echo "=== grubenv ($GRUBENV) ==="
    tail -c +26 "$GRUBENV" 2>/dev/null | tr -d '\0' | sed -n '/^#/q;p' || echo "(empty)"
    echo
    echo "=== /boot kernels ==="
    ls -l /boot/vmlinuz-aikernel* 2>/dev/null || true
    local stable_id stable_md5 stable_file
    stable_id="$(slot_get stable_id 2>/dev/null || true)"
    stable_md5="$(slot_get stable_md5 2>/dev/null || true)"
    stable_file="/boot/vmlinuz-aikernel-${stable_id#aik-}"
    if [ -n "$stable_id" ] && [ -n "$stable_md5" ] && [ -f "$stable_file" ]; then
        if [ "$(md5sum "$stable_file" | awk '{print $1}')" != "$stable_md5" ]; then
            echo "WARNING: stable slot md5 mismatch ($stable_file != $stable_md5)"
        fi
    fi
    echo
    echo "=== /proc/cmdline ==="
    cat /proc/cmdline
    echo
    echo "=== try slot marker ==="
    if grep -q "$TRYBOOT_MARK" /proc/cmdline; then
        echo "running: TRY slot ($TRYBOOT_MARK present)"
    else
        echo "running: STABLE slot"
    fi
    echo
    echo "=== userland (W-7) ==="
    local ust_f ust upieces ures ubak
    ust_f="$(ul_path "$USERLAND_STATE")"
    if [ -f "$ust_f" ]; then
        ust="$(userland_state_get last_ts || true)"
        upieces="$(userland_state_get last_pieces || true)"
        ures="$(userland_state_get last_result || true)"
        ubak="$(find "$(ul_path "$USERLAND_BACKUP_BASE")" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l || true)"
        echo "last install: ts=${ust:-?} pieces=${upieces:-?} result=${ures:-?} backups=$ubak"
    else
        echo "last install: (none)"
    fi
}

# ---------------------------------------------------------------------------
# export / import（单文件配置全量导出 / 新装机还原）
# ---------------------------------------------------------------------------
EXPORT_BASE=/usr/local/share/aikernel
EXPORT_LIST=(root/.aikernel etc/aikernel
             etc/ssh/sshd_config.d/50-aik-hardening.conf
             etc/apt/apt.conf.d/51-aik-upgrade-policy
             etc/nftables.conf boot/aik-slot-state boot/grub/grub.cfg
             usr/local/sbin/aik-upgrade usr/local/sbin/aik-reset
             usr/local/sbin/aik-backup usr/local/sbin/aikernel-health.sh
             usr/local/sbin/aik-log-trim
             usr/local/sbin/aikernel-api usr/local/bin/start-sme.sh
             usr/local/share/aikernel/tools.json
             usr/local/share/aikernel/sme-seed.jsonl
             usr/local/share/aikernel/sme-seed.sh)

collect_units() {
    local u
    for u in /etc/systemd/system/aik*.service /etc/systemd/system/aik*.timer \
             /etc/systemd/system/aikernel*.service /etc/systemd/system/aikernel*.timer; do
        [ -e "$u" ] && printf '%s\n' "${u#/}"
    done 2>/dev/null | sort -u || true
}

cmd_export() {
    local out="${1:-}" nosme="${2:-}"
    [ -n "$out" ] || die "usage: aik-upgrade export <tar路径> [--no-sme]"
    local tmp_list
    tmp_list="$(mktemp)"
    {
        local p
        for p in "${EXPORT_LIST[@]}"; do
            [ -e "/$p" ] && printf '%s\n' "$p"
        done
        collect_units
    } > "$tmp_list"
    if [ "$nosme" != "--no-sme" ] && [ -d /opt/sme/data ]; then
        ( cd /opt/sme && find data -maxdepth 1 -type f | sed 's|^|opt/sme/|' ) >> "$tmp_list"
    fi
    tar -czf "$out" -C / -T "$tmp_list" 2>/tmp/aik-export.err || {
        cat /tmp/aik-export.err >&2; rm -f "$tmp_list" "$out"; die "export tar failed"
    }
    local n
    n="$(tar -tzf "$out" | wc -l)"
    rm -f "$tmp_list"
    audit "export" "out=$out entries=$n"
    log "exported: $out ($(du -h "$out" | cut -f1), entries=$n)"
}

cmd_import() {
    local src="${1:-}" nosme="${2:-}"
    [ -n "$src" ] && [ -f "$src" ] || die "usage: aik-upgrade import <tar路径> [--no-sme]"
    log "import: safety backup of current state first"
    /usr/local/sbin/aik-backup || log "WARN: pre-import backup failed, continuing"

    if [ "$nosme" = "--no-sme" ]; then
        tar -xzf "$src" -C / --exclude='opt/sme/data/*' 2>/tmp/aik-import.err || {
            cat /tmp/aik-import.err >&2; die "import tar failed"
        }
    else
        systemctl stop aikernel-memory.service 2>/dev/null || true
        tar -xzf "$src" -C / 2>/tmp/aik-import.err || {
            cat /tmp/aik-import.err >&2; die "import tar failed"
        }
        systemctl start aikernel-memory.service 2>/dev/null || true
    fi
    systemctl daemon-reload 2>/dev/null || true
    local u
    for u in $(collect_units); do
        systemctl enable "${u##*/}" 2>/dev/null || true
    done
    systemctl start aikernel-api.service 2>/dev/null || true
    audit "import" "src=$src nosme=${nosme:-full}"
    log "import done; units reloaded; verify with: aik-upgrade healthcheck"
}

# ---------------------------------------------------------------------------
# install userland（W-7：用户态散件安装通道）
# ---------------------------------------------------------------------------
# 包格式（build/w7_userland_pkg.sh 产出）：tar.gz 内含
#   manifest.tsv  每行 = sha256 \t mode \t owner:group \t type(f|l) \t path
#   files/<path>  与 manifest 逐行对应；type=l 时 files 内是软链目标文本
# 纪律（P-49 fail-closed 同款）：逐件 sha256 校验全过才动手，任何不匹配/
# 缺件/多件在改动前拒收（零改动）；动手后备份现件（含 ABSENT 墓碑与
# 删除记录）→ 逐件 .new+原子 mv → 装后复验 → 任一步失败自动回滚本次
# 全部件，不留半装状态。全程审计行落 $AUDIT_LOG。
USERLAND_BACKUP_BASE=/var/lib/aikernel/userland-backups
USERLAND_STATE=/var/lib/aikernel/userland-state
USERLAND_STAGE=""
# 包内件禁入领地：/boot 归 install kernel/commit 槽机制管，/proc /sys /dev
# 是伪文件系统；备份目录与状态文件自身也不许被包覆盖（自噬防护）。
USERLAND_FORBIDDEN='/proc /sys /dev /boot /var/lib/aikernel/userland-backups /var/lib/aikernel/userland-state'

ul_path() {
    # ul_path <绝对路径>：加 AIK_UPGRADE_ROOT 前缀后的实际路径
    printf '%s%s' "${AIK_UPGRADE_ROOT%/}" "$1"
}

userland_state_get() {
    local key="$1" line f
    f="$(ul_path "$USERLAND_STATE")"
    [ -f "$f" ] || return 1
    while IFS= read -r line; do
        case "$line" in
            '#'*)	;;
            "$key="*)	printf '%s\n' "${line#*=}"; return 0 ;;
        esac
    done < "$f"
    return 1
}

userland_state_set() {
    # userland_state_set key=value...（整文件 kv 增量重写，slot_set 同款语义：
    # 先把现值拷进累积临时文件，逐 key 在临时文件上重写，最后一次性落盘）
    local f kv k v line found tmp
    f="$(ul_path "$USERLAND_STATE")"
    mkdir -p "$(dirname "$f")"
    touch "$f"
    tmp="$(mktemp "${f}.new.XXXXXX")"
    cp "$f" "$tmp"
    for kv in "$@"; do
        k="${kv%%=*}"; v="${kv#*=}"
        found=0
        while IFS= read -r line; do
            if [ "${line%%=*}" = "$k" ] && [ -n "$k" ]; then
                printf '%s=%s\n' "$k" "$v"
                found=1
            else
                printf '%s\n' "$line"
            fi
        done < "$tmp" > "${tmp}.out"
        [ "$found" = 1 ] || printf '%s=%s\n' "$k" "$v" >> "${tmp}.out"
        cat "${tmp}.out" > "$tmp"; rm -f "${tmp}.out"
    done
    cat "$tmp" > "$f"; rm -f "$tmp"
}

userland_load_manifest() {
    # $1=staging 根：校验 manifest 合规模 + files/ 树逐件在位，装载全局
    # M_SHA/M_MODE/M_OG/M_TYPE/M_PATH 数组；任何问题 die（调用点保证零改动）
    local stage="$1" line sha mode og type path zone n=0 dups extra bad
    M_SHA=(); M_MODE=(); M_OG=(); M_TYPE=(); M_PATH=()
    [ -s "$stage/manifest.tsv" ] || die "package manifest.tsv missing or empty"
    while IFS=$'\t' read -r sha mode og type path || [ -n "${sha:-}" ]; do
        n=$((n + 1))
        # read 已按 \t 切列：path 内再出现 \t 说明列数 >5
        case "$path" in *$'\t'*)	die "manifest line $n: more than 5 columns" ;; esac
        case "${sha:-}" in *[!0-9a-f]*|'')	die "manifest line $n: bad sha256 '$sha'" ;; esac
        [ "${#sha}" = 64 ] || die "manifest line $n: sha256 not 64 hex chars"
        case "$mode" in *[!0-7]*|'')	die "manifest line $n: bad mode '$mode'" ;; esac
        case "${#mode}" in 3|4)	;; *) die "manifest line $n: mode '$mode' not 3-4 octal digits" ;; esac
        case "$og" in ''|*[!A-Za-z0-9._:-]*|':'*|*':')	die "manifest line $n: bad owner:group '$og'" ;; esac
        case "$og" in *:*)	;; *) die "manifest line $n: owner:group missing colon" ;; esac
        case "$type" in f|l)	;; *) die "manifest line $n: bad type '$type' (want f|l)" ;; esac
        case "$path" in /*)	;; *)	die "manifest line $n: path '$path' not absolute" ;; esac
        case "$path" in *..*|*' '*|*$'\t'*)	die "manifest line $n: unsafe path '$path'" ;; esac
        for zone in $USERLAND_FORBIDDEN; do
            case "$path" in
                "$zone"|"$zone"/*)	die "manifest line $n: path '$path' in forbidden zone $zone" ;;
            esac
        done
        [ -f "$stage/files$path" ] || die "manifest line $n: files$path missing from package"
        M_SHA+=("$sha"); M_MODE+=("$mode"); M_OG+=("$og")
        M_TYPE+=("$type"); M_PATH+=("$path")
    done < "$stage/manifest.tsv"
    [ "${#M_PATH[@]}" -gt 0 ] || die "package manifest empty"
    dups="$(printf '%s\n' "${M_PATH[@]}" | sort | uniq -d)"
    [ -z "$dups" ] || die "manifest duplicate paths: $(printf '%s ' $dups)"
    # 多件拒收：files/ 树内非目录实体必须与 manifest 一一对应
    bad="$(cd "$stage/files" && find . -mindepth 1 ! -type d ! -type f -print -quit || true)"
    [ -z "$bad" ] || die "package files/ has non-regular entry: $bad (type=l 也要用文本文件承载)"
    extra="$(cd "$stage/files" && find . -mindepth 1 ! -type d | sed 's|^\.||' | sort \
             | comm -23 - <(printf '%s\n' "${M_PATH[@]}" | sort))"
    [ -z "$extra" ] || die "package has files not in manifest: $(printf '%s ' $extra)"
}

userland_verify_pkg_files() {
    # $1=staging 根：逐件 sha256 校验（type=l 校验目标文本），不匹配即 die
    local stage="$1" i got
    for i in "${!M_PATH[@]}"; do
        got="$(sha256sum "$stage/files${M_PATH[$i]}" | awk '{print $1}')"
        if [ "$got" != "${M_SHA[$i]}" ]; then
            die "sha256 mismatch: ${M_PATH[$i]} (manifest=${M_SHA[$i]} package=$got) — package rejected, nothing touched"
        fi
    done
}

userland_cp_preserve() {
    # userland_cp_preserve <src> <dst>：尽力保属性复制；内容为准（权限/属主
    # 由 record 与显式 chmod/chown 兜底），三级降级避免非 root 下 -a 的
    # 属主保真告警被 set -e 放大成假失败。
    cp -a "$1" "$2" 2>/dev/null && return 0
    cp -p "$1" "$2" 2>/dev/null && return 0
    cp "$1" "$2" 2>/dev/null
}

userland_backup_current() {
    # $1=备份目录：把每件现值（或 ABSENT 墓碑=删除记录）按原 path 落进备份；
    # record.tsv 列 = op(backup|absent) type sha256 mode owner:group path。
    # 失败返回 1（调用点清备份目录并 die，保证动手前零残留）。
    local bak="$1" pkg="$2" i target op type sha mode og rc=0
    mkdir -p "$bak"
    : > "$bak/record.tsv"
    : > "$bak/created-dirs.txt"
    printf 'ts=%s\npieces=%d\npkg=%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "${#M_PATH[@]}" "$pkg" > "$bak/info"
    for i in "${!M_PATH[@]}"; do
        target="$(ul_path "${M_PATH[$i]}")"
        if [ -L "$target" ]; then
            op=backup; type=l
            mkdir -p "$bak$(dirname "${M_PATH[$i]}")"
            ln -s "$(readlink "$target")" "$bak${M_PATH[$i]}" || rc=1
            sha="$(printf '%s' "$(readlink "$target")" | sha256sum | awk '{print $1}')"
            mode="-"; og="-"
        elif [ -d "$target" ]; then
            log "ERROR: target ${M_PATH[$i]} is a directory — refusing"
            return 1
        elif [ -e "$target" ]; then
            op=backup; type=f
            mkdir -p "$bak$(dirname "${M_PATH[$i]}")"
            userland_cp_preserve "$target" "$bak${M_PATH[$i]}" || rc=1
            sha="$(sha256sum "$target" | awk '{print $1}')"
            mode="$(stat -c%a "$target")"
            og="$(stat -c%U:%G "$target")"
        else
            op=absent; type="-"; sha="-"; mode="-"; og="-"
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$op" "$type" "$sha" "$mode" "$og" "${M_PATH[$i]}" >> "$bak/record.tsv"
    done
    [ "$rc" = 0 ]
}

userland_chown() {
    # userland_chown <file> <owner:group> <what> [link]：属主保真。root 下
    # chown 失败/校验不过即失败；沙箱非 root 降级为 WARN（审计在调用点）。
    local f="$1" og="$2" what="$3" islink="${4:-}" want got
    [ "$og" = "-" ] && return 0
    if [ "$(id -u)" = 0 ]; then
        if [ "$islink" = link ]; then chown -h "$og" "$f"; else chown "$og" "$f"; fi
        got="$(stat -c%U:%G "$f")"
        [ "$got" = "$og" ] || { log "ERROR: owner mismatch for $what (want $og got $got)"; return 1; }
    else
        if [ "$islink" = link ]; then chown -h "$og" "$f" 2>/dev/null; else chown "$og" "$f" 2>/dev/null; fi \
            || log "WARN: sandbox non-root, owner left native for $what (want $og)"
    fi
    return 0
}

userland_install_one() {
    # $1=staging 根 $2=数组下标 $3=created-dirs 记录文件：先落 .new 再原子
    # mv；软链经临时链接名 mv -T 替换；返回非 0 = 本件失败（调用点回滚）
    local stage="$1" i="$2" cdf="$3"
    local path="${M_PATH[$i]}" mode="${M_MODE[$i]}" og="${M_OG[$i]}" type="${M_TYPE[$i]}" sha="${M_SHA[$i]}"
    local target d tmp got linkto
    target="$(ul_path "$path")"
    # 记录缺失父目录（回滚时按深度逆序 rmdir），再 mkdir -p
    d="$(dirname "$path")"
    while [ "$d" != "/" ] && [ ! -d "$(ul_path "$d")" ]; do
        printf '%s\n' "$d" >> "$cdf"
        d="${d%/*}"
        [ -z "$d" ] && d="/"
    done
    mkdir -p "$(ul_path "$(dirname "$path")")" || return 1
    if [ "$type" = l ]; then
        linkto="$(cat "$stage/files$path")"
        case "$linkto" in *$'\n'*|'')	return 1 ;; esac
        tmp="$(dirname "$target")/.userland-ln.$$"
        rm -f "$tmp"
        ln -s "$linkto" "$tmp" || return 1
        mv -Tf "$tmp" "$target" || { rm -f "$tmp"; return 1; }
        got="$(printf '%s' "$(readlink "$target")" | sha256sum | awk '{print $1}')"
        [ "$got" = "$sha" ] || return 1
        userland_chown "$target" "$og" "$path" link || return 1
    else
        tmp="${target}.new.$$"
        rm -f "$tmp"
        install -m "$mode" "$stage/files$path" "$tmp" || { rm -f "$tmp"; return 1; }
        got="$(sha256sum "$tmp" | awk '{print $1}')"
        [ "$got" = "$sha" ] || { rm -f "$tmp"; return 1; }
        mv -f "$tmp" "$target" || { rm -f "$tmp"; return 1; }
        userland_chown "$target" "$og" "$path" || return 1
    fi
    return 0
}

userland_verify_installed() {
    # $1=数组下标：装后复验单件（类型/sha/权限）
    local i="$1" target want got
    target="$(ul_path "${M_PATH[$i]}")"
    if [ "${M_TYPE[$i]}" = l ]; then
        [ -L "$target" ] || return 1
        got="$(printf '%s' "$(readlink "$target")" | sha256sum | awk '{print $1}')"
        [ "$got" = "${M_SHA[$i]}" ] || return 1
        return 0
    fi
    { [ -f "$target" ] && [ ! -L "$target" ]; } || return 1
    got="$(sha256sum "$target" | awk '{print $1}')"
    [ "$got" = "${M_SHA[$i]}" ] || return 1
    want="$(printf '%o' "$((8#${M_MODE[$i]}))")"
    [ "$(stat -c%a "$target")" = "$want" ] || return 1
    return 0
}

userland_restore_backup() {
    # $1=备份目录 $2=用途标记（manual/auto）：按 record.tsv 逆序逐件还原
    # （absent 墓碑 = 删除）+ 按深度逆序清理本次新建父目录，全部还原校验
    # 通过才删备份目录；校验不过保留备份供人工处置（绝不销毁回滚凭据）。
    local bak="$1" note="${2:-restore}" op type sha mode og path target lt rc=0 pieces
    [ -f "$bak/record.tsv" ] || die "userland-rollback: no record.tsv in $bak"
    pieces="$(grep -c . "$bak/record.tsv" || true)"
    while IFS=$'\t' read -r op type sha mode og path; do
        [ -n "${op:-}" ] || continue
        target="$(ul_path "$path")"
        case "$op" in
            backup)
                mkdir -p "$(ul_path "$(dirname "$path")")"
                rm -f "$target"
                if [ "$type" = l ]; then
                    lt="$(readlink "$bak$path" 2>/dev/null)" || { log "ERROR: backup link unreadable $path"; rc=1; continue; }
                    ln -s "$lt" "$target" || { log "ERROR: link restore failed $path"; rc=1; continue; }
                    [ "$(printf '%s' "$(readlink "$target")" | sha256sum | awk '{print $1}')" = "$sha" ] \
                        || { log "ERROR: restored link drift $path"; rc=1; }
                else
                    userland_cp_preserve "$bak$path" "$target" || { log "ERROR: restore failed $path"; rc=1; continue; }
                    [ "$(sha256sum "$target" | awk '{print $1}')" = "$sha" ] \
                        || { log "ERROR: restored file sha mismatch $path"; rc=1; }
                    chmod "$mode" "$target" 2>/dev/null || true
                fi
                if [ "$(id -u)" = 0 ] && [ "$og" != "-" ]; then
                    if [ "$type" = l ]; then chown -h "$og" "$target"; else chown "$og" "$target"; fi 2>/dev/null || true
                fi
                ;;
            absent)
                rm -f "$target" || { log "ERROR: cannot remove $path"; rc=1; }
                ;;
        esac
    done < <(tac "$bak/record.tsv")
    if [ "$rc" != 0 ]; then
        audit "userland-rollback" "phase=fail note=$note bak=$bak kept-for-manual-recovery"
        die "userland rollback verification failed — backup kept at $bak for manual recovery"
    fi
    # 只删空目录：本次新建的父目录按深度逆序 rmdir，非空/复删静默放过
    if [ -f "$bak/created-dirs.txt" ]; then
        awk -F/ '{print NF, $0}' "$bak/created-dirs.txt" | sort -rn | cut -d' ' -f2- \
            | while IFS= read -r d; do rmdir "$(ul_path "$d")" 2>/dev/null || true; done
    fi
    rm -rf "$bak"
    log "userland restore done ($note): $pieces pieces, backup $bak released"
    return 0
}

cmd_install_userland() {
    local pkg="${1:-}"
    [ -n "$pkg" ] || die "usage: aik-upgrade install userland <pkg.tar.gz>"
    [ -f "$pkg" ] || die "no such package: $pkg"
    case "$pkg" in /*)	;; *)	pkg="$PWD/$pkg" ;; esac
    local pkg_md5 stage bad n ts bak i
    pkg_md5="$(md5sum "$pkg" | awk '{print $1}')"

    stage="$(mktemp -d /tmp/aik-userland.XXXXXX)"
    USERLAND_STAGE="$stage"
    trap 'rm -rf "${USERLAND_STAGE:-}" 2>/dev/null || true' EXIT
    # 解包安全门：成员只准 manifest.tsv 或 files/ 前缀（挡绝对路径/../ 夹带）
    bad="$(tar -tzf "$pkg" 2>/dev/null | grep -vE '^(manifest\.tsv|files/)' || true)"
    [ -z "$bad" ] || { rm -rf "$stage"; USERLAND_STAGE=""; trap - EXIT
        die "package contains foreign members (only manifest.tsv + files/ allowed): $bad"; }
    tar -xzf "$pkg" -C "$stage" 2>/dev/null || { rm -rf "$stage"; USERLAND_STAGE=""; trap - EXIT
        die "package extract failed (not a valid tar.gz?)"; }
    userland_load_manifest "$stage"       # 模板/缺件/多件/禁区 → die（零改动）
    userland_verify_pkg_files "$stage"    # 逐件 sha256 → die（零改动）
    n="${#M_PATH[@]}"

    ts="$(date -u +%Y%m%dT%H%M%SZ)"
    bak="$(ul_path "$USERLAND_BACKUP_BASE")/$ts"
    [ -d "$bak" ] && bak="${bak}-$$"
    audit "install-userland" "phase=begin pkg=$(basename "$pkg") md5=$pkg_md5 pieces=$n bak=$(basename "$bak")"
    if ! userland_backup_current "$bak" "$pkg"; then
        rm -rf "$bak"
        audit "install-userland" "phase=fail note=backup-phase pkg=$(basename "$pkg")"
        die "backup phase failed — nothing installed, aborted before any change"
    fi

    for i in "${!M_PATH[@]}"; do
        if userland_install_one "$stage" "$i" "$bak/created-dirs.txt"; then
            audit "install-userland" "phase=ok piece=${M_PATH[$i]} sha=${M_SHA[$i]:0:12}"
        else
            audit "install-userland" "phase=fail piece=${M_PATH[$i]}"
            userland_restore_backup "$bak" "auto-after-install-failure"
            audit "install-userland" "phase=rollback reason=install-failure pieces=$n"
            userland_state_set last_ts="$ts" last_pieces="$n" last_result=failed-rolled-back \
                     last_pkg="$(basename "$pkg")"
            die "install userland failed at ${M_PATH[$i]} — all $n pieces rolled back"
        fi
    done
    for i in "${!M_PATH[@]}"; do
        if ! userland_verify_installed "$i"; then
            audit "install-userland" "phase=fail note=post-verify piece=${M_PATH[$i]}"
            userland_restore_backup "$bak" "auto-after-postverify-failure"
            audit "install-userland" "phase=rollback reason=post-verify-failure pieces=$n"
            userland_state_set last_ts="$ts" last_pieces="$n" last_result=failed-rolled-back \
                     last_pkg="$(basename "$pkg")"
            die "post-install verify failed at ${M_PATH[$i]} — all $n pieces rolled back"
        fi
    done
    rm -rf "$stage"; USERLAND_STAGE=""; trap - EXIT
    userland_state_set last_ts="$ts" last_pieces="$n" last_result=ok \
             last_pkg="$(basename "$pkg")" last_pkg_md5="$pkg_md5"
    audit "install-userland" "phase=done pieces=$n bak=$(basename "$bak") result=ok"
    log "userland: $n pieces installed ok (backup $(basename "$bak")); undo with: aik-upgrade userland-rollback"
}

cmd_userland_rollback() {
    local base bak ts
    base="$(ul_path "$USERLAND_BACKUP_BASE")"
    [ -d "$base" ] || die "no userland backups under $base (nothing to roll back)"
    bak="$(find "$base" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r | head -1)"
    [ -n "$bak" ] || die "no userland backups under $base (nothing to roll back)"
    bak="$base/$bak"
    ts="$(basename "$bak")"
    audit "userland-rollback" "phase=begin bak=$ts"
    userland_restore_backup "$bak" "manual"
    userland_state_set last_result=rolled-back rolled_back_ts="$(date -u +%Y%m%dT%H%M%SZ)"
    audit "userland-rollback" "phase=done bak=$ts"
    log "userland rollback done: restored backup $ts"
    return 0
}

# ---------------------------------------------------------------------------
usage() {
    sed -n '2,45p' "$0" | grep -E '^#( |$)' | sed 's/^# \{0,1\}//'
    exit 1
}

# ---------------------------------------------------------------------------
main() {
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        status)		cmd_status ;;
        install)	local what="${1:-}"; shift || true
                case "$what" in
                    kernel)	cmd_install_kernel "$@" ;;
                    shell)	cmd_install_shell "$@" ;;
                    userland)	cmd_install_userland "$@" ;;
                    *)		usage ;;
                esac ;;
        boot)		cmd_boot "$@" ;;
        commit)		cmd_commit "$@" ;;
        auto-commit)	cmd_auto_commit ;;
        rollback)	cmd_rollback "$@" ;;
        userland-rollback)	cmd_userland_rollback "$@" ;;
        healthcheck)	cmd_healthcheck ;;
        export)		cmd_export "$@" ;;
        import)		cmd_import "$@" ;;
        grubenv)	cmd_grubenv "$@" ;;
        *)		usage ;;
    esac
}

# --yes / --force 旗标透传（REPL 与脚本两种入口统一）
# C2 波拆分（U3 实测事故驱动）：--yes 只跳过交互确认；--force 才放行防呆门
# （可疑小镜像）与 commit 的 tryboot 检查豁免。二者共用一个变量会让 REPL
# 确认路径（--yes）旁路防呆门，坏镜像直接落 try 槽——已在 U3 实测复现并修正。
ARGS=()
for a in "$@"; do
    case "$a" in
        --yes)	export FORCE_YES=1 ;;
        --force)	export FORCE=1 ;;
        *)		ARGS+=("$a") ;;
    esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}

main "$@"
