#!/bin/sh
# aik-console v7 — P-41/P-44 控制台稳定棒（输出看门狗自愈）。
#   v7d：fb 分支补 143（fbterm 被 occ 击毙=楔死自愈真路径）与 139
#   （fbterm segfault 崩溃计数，P-41 观测线）两条留痕；fbterm 转手
#   吞退出码（occ exit(72)→fbterm 以 0 退，P-47 谜底）——143/72 双
#   检查防御未来 fbterm 修好传码。
#   v7：occ 退出码 72=occ 检测 fbterm 楔死（输出看门狗超时/输出 IO 错）
#   自退——本循环 sleep 2 重启整链（fbterm 随 pty 从端关闭退出，wait
#   自然返回；P-44 楔死=旧版冻结无自愈，v7 起 2s 内恢复）。
#   v6：occ 退出码 71=用户主动退出（/exit、ctrl+c/ctrl+d/<leader>q）
#   → 断链 exit 0：.profile 的 exec 结束 → autologin 会话结束 →
#   getty 重出 login 面（=退出即注销；SSH/pts 场景 rc=71 落回 shell 无害）。
#   v5：P2 修复（2026-11-16 验尸：串口 occ 永久空屏）——串口 tty 无内核
#   winsize（tty1 fbcon 有 80×25），occ resize 路径 0×0=空屏（occ 侧
#   tui_frame_check_resize 已同步补 0 兜底双保险）；v4 语义：serial 分支
#   补齐 v2 同款循环兜底+取证。
#   tty1/2/3 = fbterm 内跑 occ（中文渲染 + /zoom 可缩放；FBTERM=1 门）；
#   退出码 70 = /zoom 字号重启环；chain-start/occ-exit 落
#   /root/aik-console.log，occ+fbterm stderr 落 /root/aik-console.err。
TTY=$(tty 2>/dev/null) || exit 0
log() { echo "$(date +%s) $*" >> /root/aik-console.log; }
case "$TTY" in
  /dev/tty1|/dev/tty2|/dev/tty3)
    log "chain-start $TTY"
    printf '\033[2J\033[H' # P-38: fbterm 接管前清屏，清历史残影（boot 输出/printk 残条）
    FBTERM_BIN=$(command -v fbterm 2>/dev/null)
    [ -x "$FBTERM_BIN" ] || FBTERM_BIN=
    n=0
    while :; do
      if [ -n "$FBTERM_BIN" ]; then
        FBTERM=1 OCC_NETCFG_TOOLS=1 "$FBTERM_BIN" -- /usr/local/bin/occ 2>> /root/aik-console.err
      else
        OCC_NETCFG_TOOLS=1 /usr/local/bin/occ 2>> /root/aik-console.err
      fi
      rc=$?
      n=$((n+1))
      log "occ-exit rc=$rc n=$n tty=fb fb=${FBTERM_BIN:+y}"
      # P-41/P-44：72=occ 输出看门狗自退（fbterm 楔死）——单独留痕，
      # 循环行为不变（sleep 2 重启整链自愈）
      [ "$rc" -eq 72 ] && log "occ-wd rc=72 tty=fb"
      # P-41/P-44d：143=SIGTERM——fbterm 被 occ 致命收口击毙（真楔死
      # 不随 pty 关闭退出；且 fbterm 吞退出码，143=出带外线索位）
      [ "$rc" -eq 143 ] && log "occ-wd rc=143 tty=fb"
      # P-41 观测线：139=SIGSEGV fbterm 崩溃计数（4~13 分钟 segfault 面）
      [ "$rc" -eq 139 ] && log "fbterm-crash rc=139 tty=fb"
      [ "$rc" -eq 71 ] && { log "occ-logout tty=fb"; exit 0; }
      [ "$rc" -eq 70 ] && continue
      sleep 2
    done
    ;;
  /dev/ttyS*)
    stty rows 24 cols 80 2>> /root/aik-console.err || true
    log "chain-start $TTY"
    printf '\033[2J\033[H' # P-38: occ 接管前清屏，清历史残影
    n=0
    while :; do
      OCC_NETCFG_TOOLS=1 /usr/local/bin/occ 2>> /root/aik-console.err
      rc=$?
      n=$((n+1))
      log "occ-exit rc=$rc n=$n tty=serial"
      # P-41/P-44：serial 无 fbterm，但 tty 卡死时 occ 同路自退——留痕同款
      [ "$rc" -eq 72 ] && log "occ-wd rc=72 tty=serial"
      [ "$rc" -eq 71 ] && { log "occ-logout tty=serial"; exit 0; }
      [ "$rc" -eq 70 ] && continue
      sleep 2
    done
    ;;
esac
exit 0
