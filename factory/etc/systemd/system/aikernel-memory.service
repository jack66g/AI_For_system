[Unit]
Description=AIKernel SME Memory Engine (REST 127.0.0.1:8000)
Documentation=man:aikernel-memory(8)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/aikd --config /opt/sme/data/sme.config.json --import-seed /usr/local/share/aikernel/sme-seed.jsonl --static-dir /usr/local/share/aikd/static
StandardOutput=append:/tmp/sme.log
StandardError=append:/tmp/sme.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
