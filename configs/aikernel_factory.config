# AIKernel 出厂配置 profile（K10.2 单一事实源）
# =树 .config 的 CONFIG_AIKERNEL* 族快照；KUNIT_TEST 口径=CI 构建内置开+出厂 boot 期 kunit.enable=0（现状保持，非缺陷）
# 与真相表/ARCHITECTURE 一致性由 AIKernel/scripts/k10_config_check.sh 校验
CONFIG_AIKERNEL_AGENT=y
CONFIG_AIKERNEL_AI_ZONE=y
CONFIG_AIKERNEL_BPF=y
CONFIG_AIKERNEL_CGROUP=y
CONFIG_AIKERNEL_CLOUD_PROVIDER=y
CONFIG_AIKERNEL_CORE=y
CONFIG_AIKERNEL_INTERRUPT=y
CONFIG_AIKERNEL_IO=y
CONFIG_AIKERNEL_KUNIT_TEST=y
CONFIG_AIKERNEL_LOCAL_PROVIDER=y
CONFIG_AIKERNEL_LOCK=y
CONFIG_AIKERNEL_MM=y
CONFIG_AIKERNEL_NETLINK=y
CONFIG_AIKERNEL_NET=y
CONFIG_AIKERNEL_POWER=y
CONFIG_AIKERNEL_RUNTIME=y
CONFIG_AIKERNEL_SCHED=y
CONFIG_AIKERNEL_SECURITY=y
CONFIG_AIKERNEL_SHELL=y
CONFIG_AIKERNEL_STREAM_MODE=y
CONFIG_AIKERNEL_TELEMETRY=y
CONFIG_AIKERNEL_TIME=y
CONFIG_AIKERNEL_USRIFACE=y
CONFIG_AIKERNEL_VFS=y
CONFIG_AIKERNEL_VIRT=y
CONFIG_AIKERNEL=y
